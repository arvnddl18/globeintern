@model SlotAd_Globe.Models.OperationalDashboardViewModel
@using System.Text.Json
@using SlotAd_Globe.Models
@{
    ViewData["Title"] = "Operational Dashboard";
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    ViewData["ActiveTab"] = "operational";
    ViewBag.ReportAssistantPageKind = ReportAssistantPageKind.Operational;
}

<style>
    :root[data-theme="dark"] {
        --op-card-bg: rgba(22, 22, 42, 0.8);
        --op-card-border: #2a2a4a;
        --op-text: #f0f0f8;
        --op-text-dim: #c8c8e0;
        --op-text-muted: #8a8ab0;
        --op-pill-bg: rgba(255, 255, 255, 0.04);
        --op-badge-bg: rgba(99, 102, 241, 0.12);
        --op-badge-color: #a5b4fc;
    }

    :root[data-theme="light"] {
        --op-card-bg: #ffffff;
        --op-card-border: #d8deea;
        --op-text: #15192d;
        --op-text-dim: #2e3550;
        --op-text-muted: #556084;
        --op-pill-bg: rgba(30, 41, 59, 0.06);
        --op-badge-bg: rgba(79, 70, 229, 0.10);
        --op-badge-color: #4f46e5;
    }

    .op-card {
        background: var(--op-card-bg);
        border: 1px solid var(--op-card-border);
        border-radius: 16px;
        padding: 24px;
    }
    .op-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 10px;
        border: 1px solid var(--op-card-border);
        padding: 8px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--op-text-dim);
        background: var(--op-pill-bg);
        cursor: pointer;
    }
    .op-chart-wrap {
        position: relative;
        width: 100%;
        min-height: 300px;
    }
    .op-empty {
        border: 1px dashed var(--op-card-border);
        border-radius: 14px;
        padding: 26px;
        text-align: center;
        color: var(--op-text-muted);
    }
    .op-subpanel {
        border: 1px solid var(--op-card-border);
        border-radius: 14px;
        padding: 18px;
        background: var(--op-pill-bg);
    }
    .op-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(10, 10, 22, 0.55);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 60;
    }
    .op-modal-backdrop.active { display: flex; }
    .op-modal {
        width: min(940px, 94vw);
        max-height: 88vh;
        overflow: auto;
        border-radius: 14px;
        border: 1px solid var(--op-card-border);
        background: var(--op-card-bg);
        padding: 18px;
    }

    .op-card h2, .op-card h3 {
        color: var(--op-text);
    }

    .op-card p, .op-card span {
        color: var(--op-text-muted);
    }

    .op-stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--op-text-muted);
    }

    .op-stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--op-text);
        font-family: 'JetBrains Mono', monospace;
    }

    .op-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 9999px;
        background: var(--op-badge-bg);
        color: var(--op-badge-color);
    }

    .op-divider {
        border: none;
        border-top: 1px solid var(--op-card-border);
        margin: 20px 0;
    }

    .op-placeholder-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: var(--op-badge-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--op-badge-color);
    }
    /* â”€â”€ Dashboard shell: enterprise fixed sidebar + content â”€â”€ */
    .dash-layout-root {
        --dash-sidebar-width: 16.5rem;
    }
    .dash-layout-root.dash-sidebar-collapsed {
        --dash-sidebar-width: 0rem;
    }
    .dash-layout-root.dash-sidebar-collapsed .dash-sidebar {
        transform: translateX(-100%);
        opacity: 0;
        pointer-events: none;
    }
    .dash-app {
        display: grid;
        grid-template-columns: var(--dash-sidebar-width) minmax(0, 1fr);
        align-items: stretch;
        width: 100%;
        height: 100%;
        min-height: 100%;
        overflow: hidden;
    }
    .dash-layout-root.dash-sidebar-collapsed .dash-app {
        grid-template-columns: 0 minmax(0, 1fr);
    }
    .dash-sidebar {
        position: sticky;
        top: 0;
        left: 0;
        width: var(--dash-sidebar-width);
        height: calc(100vh - var(--dash-nav-height));
        display: flex;
        flex-direction: column;
        border-right: 1px solid rgba(99, 102, 241, 0.22);
        background: linear-gradient(180deg, rgba(22, 22, 42, 0.92) 0%, rgba(12, 12, 26, 0.96) 100%);
        box-shadow: 6px 0 18px rgba(0, 0, 0, 0.18);
        overflow: hidden;
        z-index: 50;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }
    :root[data-theme="light"] .dash-sidebar {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 248, 252, 0.98) 100%);
        border-color: rgba(99, 102, 241, 0.18);
        box-shadow: 4px 0 14px rgba(15, 23, 42, 0.08);
    }
    :root[data-theme="light"] .dash-sidebar-brand h2 { color: var(--dash-text-primary); }
    :root[data-theme="light"] .dash-sidebar-brand p { color: var(--dash-text-muted); }
    :root[data-theme="light"] .dash-nav-item { color: var(--dash-text-secondary); }
    :root[data-theme="light"] .dash-nav-item:hover { color: var(--dash-text-primary); background: rgba(99, 102, 241, 0.08); }
    :root[data-theme="light"] .dash-nav-item.is-active {
        color: #111827;
        background: rgba(99, 102, 241, 0.14);
        border-color: rgba(99, 102, 241, 0.28);
    }
    :root[data-theme="light"] .dash-page-header h1 {
        color: var(--dash-text-primary) !important;
    }
    :root[data-theme="light"] .dash-page-header p,
    :root[data-theme="light"] .dash-page-header span {
        color: var(--dash-text-secondary) !important;
    }
    .dash-sidebar-brand {
        padding: 1rem 1rem 0.9rem;
        border-bottom: 1px solid var(--dash-card-border);
    }
    .dash-sidebar-brand p {
        margin: 0;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #6a6a8e;
    }
    .dash-sidebar-brand h2 {
        margin: 0.25rem 0 0;
        font-size: 0.9rem;
        font-weight: 600;
        color: #c8c8e0;
    }
    .dash-sidebar-nav {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem;
    }
    .dash-nav-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
        padding: 0.65rem 0.75rem;
        margin-bottom: 0.2rem;
        border: 1px solid transparent;
        border-radius: 0.6rem;
        background: transparent;
        color: #8a8ab0;
        font-size: 0.8125rem;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .dash-nav-item:hover {
        background: rgba(99, 102, 241, 0.08);
        color: #c8c8e0;
        border-color: rgba(99, 102, 241, 0.15);
    }
    .dash-nav-item.is-active {
        background: rgba(99, 102, 241, 0.18);
        color: #e0e7ff;
        border-color: rgba(99, 102, 241, 0.35);
        box-shadow: inset 2px 0 0 #818cf8;
    }
    .dash-nav-item i {
        flex-shrink: 0;
        width: 15px;
        height: 15px;
        opacity: 0.85;
    }
    .dash-nav-item.is-active i { opacity: 1; color: #a5b4fc; }
    .dash-sidebar-foot {
        padding: 0.65rem 1rem;
        border-top: 1px solid var(--dash-card-border);
        font-size: 0.65rem;
        color: #5a5a7e;
    }
    .dash-main {
        width: 100%;
        max-width: 100%;
        height: calc(100vh - var(--dash-nav-height));
        overflow-y: auto;
        overflow-x: hidden;
        min-width: 0;
        padding: 1.5rem 2rem 2rem;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
    }
    .dash-page-header {
        padding-right: 0;
        max-width: 100%;
    }
    .dash-panel {
        display: none;
        max-width: 100%;
        min-width: 0;
        animation: dashPanelIn 0.28s ease-out;
    }
    .dash-panel.is-active {
        display: block;
    }
    .dash-panel section,
    .dash-panel > div,
    .dash-main .rounded-xl {
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }
    #report-history-section {
        overflow: hidden;
    }
    #report-history-groups,
    #report-history-groups .grid {
        min-width: 0;
        max-width: 100%;
    }
    #report-magic-link {
        min-width: 0 !important;
        max-width: 100%;
        width: 100%;
    }
    #kpi-count-report,
    #slot-adherence-report,
    #heatmap-analysis-report,
    #recurring-tickets-report {
        max-width: 100%;
        overflow-x: auto;
        overflow-y: visible;
    }
    .filter-scroll {
        max-width: 100%;
    }
    .dash-sidebar-collapse-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        margin-left: auto;
        border-radius: 0.5rem;
        border: 1px solid rgba(99, 102, 241, 0.25);
        background: rgba(99, 102, 241, 0.1);
        color: #a5b4fc;
        cursor: pointer;
        transition: background 0.15s ease, transform 0.15s ease;
    }
    .dash-sidebar-collapse-btn:hover {
        background: rgba(99, 102, 241, 0.2);
    }
    .dash-layout-root.dash-sidebar-collapsed .dash-sidebar-collapse-btn {
        transform: rotate(180deg);
    }
    .dash-sidebar-expand-btn {
        display: none;
        position: fixed;
        left: 0.85rem;
        top: calc(var(--dash-nav-height) + 0.85rem);
        z-index: 75;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 0.65rem;
        border: 1px solid rgba(99, 102, 241, 0.3);
        background: rgba(22, 22, 42, 0.95);
        color: #a5b4fc;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
        transition: background 0.15s ease, transform 0.15s ease;
    }
    .dash-sidebar-expand-btn:hover {
        background: rgba(99, 102, 241, 0.2);
    }
    .dash-layout-root.dash-sidebar-collapsed .dash-sidebar-expand-btn {
        display: inline-flex;
    }
    @@keyframes dashPanelIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .dash-mobile-toggle {
        display: none;
        margin-bottom: 1rem;
    }
    .dash-sidebar-backdrop {
        display: none;
    }
    @@media (max-width: 1023px) {
        .dash-mobile-toggle { display: inline-flex; }
        .dash-app {
            display: block;
            height: 100%;
        }
        .dash-sidebar {
            position: fixed;
            top: var(--dash-nav-height);
            left: 0;
            bottom: 0;
            height: calc(100vh - var(--dash-nav-height));
            width: min(17rem, 88vw);
            border-radius: 0;
            border-right: 1px solid rgba(99, 102, 241, 0.22);
            transform: translateX(-105%);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            z-index: 80;
        }
        .dash-sidebar.is-open { transform: translateX(0); }
        .dash-sidebar-backdrop {
            display: none;
            position: fixed;
            inset: var(--dash-nav-height) 0 0 0;
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(2px);
            z-index: 75;
        }
        .dash-sidebar-backdrop.is-open { display: block; }
        .dash-main {
            margin-left: 0;
            width: 100%;
            max-width: 100%;
            height: calc(100vh - var(--dash-nav-height));
            padding: 1rem 1rem 1.5rem;
        }
    }
</style>

<div class="dash-app" id="dash-app">
    <button type="button" id="dash-sidebar-expand" class="dash-sidebar-expand-btn" aria-label="Expand sidebar" title="Expand sidebar">
        <i data-lucide="chevrons-right" style="width:16px;height:16px;"></i>
    </button>
    <div class="dash-sidebar-backdrop" id="dash-sidebar-backdrop" aria-hidden="true"></div>
    <aside class="dash-sidebar" id="dash-sidebar" aria-label="Dashboard sections">
        <div class="dash-sidebar-brand" style="display:flex;align-items:flex-start;gap:0.5rem;">
            <div style="flex:1;min-width:0;">
                <p>Navigation</p>
                <h2>Operational sections</h2>
            </div>
            <button type="button" id="dash-sidebar-collapse" class="dash-sidebar-collapse-btn flex-shrink-0" title="Collapse sidebar" aria-label="Collapse sidebar">
                <i data-lucide="chevrons-left" style="width:14px;height:14px;"></i>
            </button>
        </div>
        <nav class="dash-sidebar-nav" id="dash-sidebar-nav">
            <button type="button" class="dash-nav-item is-active" data-dash-panel="operational" aria-current="page">
                <i data-lucide="activity"></i><span>Operational Dashboard</span>
            </button>
            <button type="button" class="dash-nav-item" data-dash-panel="traffic">
                <i data-lucide="radio-tower"></i><span>Traffic Analysis Reports</span>
            </button>
        </nav>
        <div class="dash-sidebar-foot">SlotAd Globe &middot; Operational</div>
    </aside>
    <div class="dash-main">
        <header class="dash-page-header mb-8 slide-up">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="text-center md:text-left">
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-2" style="color: #f0f0f8;">
                        Operational Dashboard
                    </h1>
                    <p class="text-base sm:text-lg" style="color: #7a7a9e;">
                        Real-time operational metrics and field activity overview
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <form asp-controller="Report" asp-action="UploadOperationAging" method="post" enctype="multipart/form-data" id="aging-upload-form">
                        @Html.AntiForgeryToken()
                        <input type="file" name="csvFile" id="aging-file-input" accept=".csv,.xlsx" class="hidden" />
                        <button type="button" id="aging-upload-btn" class="op-action-btn" style="background: #6366f1; color: #ffffff; border-color: #6366f1; padding: 10px 16px;">
                            <i data-lucide="upload" style="width:16px;height:16px;"></i> Upload Aging Report
                        </button>
                    </form>
                </div>
            </div>
        </header>
        <button type="button" id="dash-mobile-toggle" class="dash-mobile-toggle inline-flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold cursor-pointer"
                style="color: #c8c8e0; background: rgba(99,102,241,0.12); border: 1px solid #2a2a4a;">
            <i data-lucide="menu" style="width:14px;height:14px;"></i> Sections
        </button>
        <div id="panel-operational" class="dash-panel is-active" data-dash-panel="operational">

@if (TempData["Error"] is string errorMsg)
{
    <div class="mb-6 fade-in rounded-xl px-4 py-3 flex items-center gap-2 text-sm font-medium"
         style="background: #7f1d1d; border: 1px solid #ef4444; color: #fff;">
        <i data-lucide="alert-circle" style="width:16px; height:16px; flex-shrink:0;"></i>
        <span>@errorMsg</span>
    </div>
}

@{
    ViewData["OperationalDashboardParent"] = Model;
}
@if (Model.OperationAging is not null)
{
    @await Html.PartialAsync("_OperationAgingReport", Model.OperationAging)
}
else
{
    <div class="op-card fade-in mb-6">
        <h2 class="text-lg font-semibold mb-2" style="color: var(--op-text);">Operation Aging</h2>
        <p class="text-sm" style="color: var(--op-text-muted);">
            No active Operation Aging report with CSV data. Upload an Operation Aging report using the button in the upper right to view Operation Aging.
        </p>
    </div>
}

        </div>
        <div id="panel-traffic" class="dash-panel" data-dash-panel="traffic">

<div class="op-card fade-in mb-6">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
        <div>
            <h2 class="text-lg font-semibold">Traffic Analysis Reports</h2>
            <p class="text-sm" style="color: var(--op-text-muted);">
                10-minute interval analytics for Alarm History and Performance History shown together.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <form asp-controller="Report" asp-action="UploadOperational" method="post" enctype="multipart/form-data" id="operational-upload-form">
                @Html.AntiForgeryToken()
                <input type="file" name="csvFile" id="operational-file-input" accept=".csv,.xlsx" class="hidden" />
                <button type="button" id="operational-upload-btn" class="op-action-btn">
                    <i data-lucide="upload" style="width:14px;height:14px;"></i> Upload
                </button>
            </form>
        </div>
    </div>
    <div class="grid grid-cols-1 gap-6 fade-in">
    <div class="op-subpanel">
        @{
            var perfStartDateLabel = Model.PerformanceReport.IntervalLabels.Count > 0
                ? Model.PerformanceReport.IntervalLabels[0].Substring(0, Math.Min(10, Model.PerformanceReport.IntervalLabels[0].Length))
                : string.Empty;
            var perfEndDateLabel = Model.PerformanceReport.IntervalLabels.Count > 0
                ? Model.PerformanceReport.IntervalLabels[^1].Substring(0, Math.Min(10, Model.PerformanceReport.IntervalLabels[^1].Length))
                : string.Empty;
            var perfDateCaption = string.Empty;
            if (!string.IsNullOrWhiteSpace(perfStartDateLabel))
            {
                perfDateCaption = perfStartDateLabel == perfEndDateLabel
                    ? $"Date: {perfStartDateLabel}"
                    : $"Dates: {perfStartDateLabel} to {perfEndDateLabel}";
            }
        }
        <div class="flex items-center justify-between gap-3 mb-4">
            <div>
                <h3 class="text-base font-semibold">Performance History Report</h3>
                @if (Model.PerformanceReport.HasReport)
                {
                    <p class="text-xs mt-1" style="color: var(--op-text-muted);">
                        Source: <span style="color: var(--op-text-dim);">@Model.PerformanceReport.SourceFileName</span>
                    </p>
                }
            </div>
            <div class="flex items-center gap-2">
                <span class="op-badge"><i data-lucide="activity" style="width:11px;height:11px;"></i> Per occurrence</span>
                <form asp-controller="Report" asp-action="OperationalDashboard" method="get">
                    <input type="hidden" name="group" value="@Model.PerformanceReport.SelectedPerformanceGroup" />
                    <input type="hidden" name="alarmPeriod" value="@Model.AlarmReport.SelectedPeriod" />
                    <input type="hidden" name="alarmMode" value="@Model.AlarmReport.DateFilterMode" />
                    <input type="hidden" name="alarmDate" value="@Model.AlarmReport.SelectedDate" />
                    <input type="hidden" name="alarmStart" value="@Model.AlarmReport.DateRangeStart" />
                    <input type="hidden" name="alarmEnd" value="@Model.AlarmReport.DateRangeEnd" />
                    <input type="hidden" name="perfMode" value="@Model.PerformanceReport.DateFilterMode" />
                    <input type="hidden" name="perfDate" value="@Model.PerformanceReport.SelectedDate" />
                    <input type="hidden" name="perfStart" value="@Model.PerformanceReport.DateRangeStart" />
                    <input type="hidden" name="perfEnd" value="@Model.PerformanceReport.DateRangeEnd" />
                    <select name="perfPeriod" class="op-action-btn" onchange="this.form.submit()">
                        @if (Model.PerformanceReport.SelectedPeriod == "10min") { <option value="10min" selected>10 min</option> } else { <option value="10min">10 min</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "30min") { <option value="30min" selected>30 min</option> } else { <option value="30min">30 min</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "1hour") { <option value="1hour" selected>1 hour</option> } else { <option value="1hour">1 hour</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "3hour") { <option value="3hour" selected>3 hours</option> } else { <option value="3hour">3 hours</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "6hour") { <option value="6hour" selected>6 hours</option> } else { <option value="6hour">6 hours</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "12hour") { <option value="12hour" selected>12 hours</option> } else { <option value="12hour">12 hours</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "1day") { <option value="1day" selected>1 day</option> } else { <option value="1day">1 day</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "week") { <option value="week" selected>Week</option> } else { <option value="week">Week</option> }
                        @if (Model.PerformanceReport.SelectedPeriod == "month") { <option value="month" selected>Month</option> } else { <option value="month">Month</option> }
                    </select>
                </form>
                <button type="button" class="op-action-btn" id="open-performance-filter">
                    <i data-lucide="filter" style="width:14px;height:14px;"></i> Filter
                </button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(perfDateCaption))
        {
            <p class="text-xs mb-3" style="color: var(--op-text-muted);">@perfDateCaption</p>
        }

        @if (Model.PerformanceReport.HasReport)
        {
            <div class="op-chart-wrap">
                <canvas id="performance-chart"></canvas>
            </div>
            @if (Model.PerformanceReport.SecondaryIntervalLabels.Count > 0)
            {
                <div class="op-chart-wrap mt-5">
                    <canvas id="performance-secondary-chart"></canvas>
                </div>
            }
        }
        else
        {
            <div class="op-empty">
                <p class="text-sm">No Performance History report uploaded yet.</p>
            </div>
        }
    </div>

    <div class="op-subpanel">
        <div class="flex items-center justify-between gap-3 mb-4">
            <div>
                <h3 class="text-base font-semibold">Alarm History Report</h3>
                @if (Model.AlarmReport.HasReport)
                {
                    <p class="text-xs mt-1" style="color: var(--op-text-muted);">
                        Source: <span style="color: var(--op-text-dim);">@Model.AlarmReport.SourceFileName</span>
                    </p>
                }
            </div>
            <div class="flex items-center gap-2">
                <span class="op-badge"><i data-lucide="alarm-clock" style="width:11px;height:11px;"></i> 10-min interval</span>
                <form asp-controller="Report" asp-action="OperationalDashboard" method="get">
                    <input type="hidden" name="group" value="@Model.PerformanceReport.SelectedPerformanceGroup" />
