@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var uploadButton = document.getElementById('operational-upload-btn');
            var fileInput = document.getElementById('operational-file-input');
            var uploadForm = document.getElementById('operational-upload-form');

            if (uploadButton && fileInput && uploadForm) {
                uploadButton.addEventListener('click', function () { fileInput.click(); });
                fileInput.addEventListener('change', function () {
                    if (fileInput.files && fileInput.files.length > 0) {
                        uploadForm.submit();
                    }
                });
            }
            var agingUploadButton = document.getElementById('aging-upload-btn');
            var agingFileInput = document.getElementById('aging-file-input');
            var agingUploadForm = document.getElementById('aging-upload-form');

            if (agingUploadButton && agingFileInput && agingUploadForm) {
                agingUploadButton.addEventListener('click', function () { agingFileInput.click(); });
                agingFileInput.addEventListener('change', function () {
                    if (agingFileInput.files && agingFileInput.files.length > 0) {
                        agingUploadForm.submit();
                    }
                });
            }

            bindModal('open-alarm-filter', 'alarm-filter-modal');
            bindModal('open-performance-filter', 'performance-filter-modal');

            var alarmLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AlarmReport.IntervalLabels));
            var alarmValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AlarmReport.IntervalValues));
            var perfLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerformanceReport.IntervalLabels));
            var perfValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerformanceReport.IntervalValues));
            var perfSecondaryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerformanceReport.SecondaryIntervalLabels));
            var perfSecondaryValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerformanceReport.SecondaryIntervalValues));
            var perfPrimaryMetricLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerformanceReport.PrimaryMetricLabel));
            var perfSecondaryMetricLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerformanceReport.SecondaryMetricLabel));

            if (Array.isArray(perfLabels) && perfLabels.length > 0) {
                var performanceCanvas = document.getElementById('performance-chart');
                if (performanceCanvas) {
                    var perfScale = buildPerformanceScale(perfValues);
                    new Chart(performanceCanvas, {
                        type: 'line',
                        data: {
                            labels: perfLabels,
                            datasets: [{
                                label: perfPrimaryMetricLabel || 'Performance Value',
                                data: perfValues,
                                borderColor: '#6366f1',
                                backgroundColor: 'rgba(99,102,241,0.22)',
                                borderWidth: 2.5,
                                pointRadius: 3,
                                tension: 0.24,
                                fill: true
                            }]
                        },
                        options: chartOptions(perfScale, false)
                    });
                }
            }

            if (Array.isArray(perfSecondaryLabels) && perfSecondaryLabels.length > 0) {
                var performanceSecondaryCanvas = document.getElementById('performance-secondary-chart');
                if (performanceSecondaryCanvas) {
                    var secondaryScale = buildPerformanceScale(perfSecondaryValues);
                    new Chart(performanceSecondaryCanvas, {
                        type: 'line',
                        data: {
                            labels: perfSecondaryLabels,
                            datasets: [{
                                label: perfSecondaryMetricLabel || 'Secondary Metric',
                                data: perfSecondaryValues,
                                borderColor: '#0ea5e9',
                                backgroundColor: 'rgba(14,165,233,0.18)',
                                borderWidth: 2.5,
                                pointRadius: 3,
                                tension: 0.24,
                                fill: true
                            }]
                        },
                        options: chartOptions(secondaryScale, false)
                    });
                }
            }

            if (Array.isArray(alarmLabels) && alarmLabels.length > 0) {
                var alarmCanvas = document.getElementById('alarm-chart');
                if (alarmCanvas) {
                    new Chart(alarmCanvas, {
                        type: 'bar',
                        data: {
                            labels: alarmLabels,
                            datasets: [{
                                label: 'Alarm Count',
                                data: alarmValues,
                                borderColor: '#6366f1',
                                backgroundColor: 'rgba(99,102,241,0.6)',
                                borderWidth: 2,
                                pointRadius: 0
                            }]
                        },
                        options: chartOptions({ min: 0, max: null }, true)
                    });
                }
            }

            function chartOptions(scale, beginAtZero) {
                return {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            ticks: {
                                color: '#8a8ab0',
                                maxRotation: 45,
                                minRotation: 45,
                                callback: function (value) {
                                    var label = this.getLabelForValue(value) || '';
                                    var parts = label.split(' - ');
                                    if (parts.length > 1) {
                                        var datePart = parts[0].substring(0, 10);
                                        return [parts[1], datePart];
                                    }
                                    return label;
                                }
                            },
                            grid: { color: 'rgba(138,138,176,0.12)' }
                        },
                        y: {
                            beginAtZero: beginAtZero,
                            min: scale.min,
                            max: scale.max,
                            ticks: { color: '#8a8ab0' },
                            grid: { color: 'rgba(138,138,176,0.12)' }
                        }
                    },
                    plugins: {
                        legend: { labels: { color: '#c8c8e0' } },
                        tooltip: {
                            callbacks: {
                                title: function (items) {
                                    if (!items || items.length === 0) return '';
                                    return '10-min bucket: ' + items[0].label;
                                }
                            }
                        }
                    }
                };
            }

            function buildScaleLimits(values) {
                if (!Array.isArray(values) || values.length === 0) return { min: null, max: null };
                var nums = values.filter(function (v) { return typeof v === 'number' && !Number.isNaN(v); });
                if (nums.length === 0) return { min: null, max: null };
                var min = Math.min.apply(null, nums);
                var max = Math.max.apply(null, nums);
                var span = Math.max(0.5, Math.abs(max - min));
                var pad = span * 0.15;
                return { min: min - pad, max: max + pad };
            }

            function buildPerformanceScale(values) {
                if (!Array.isArray(values) || values.length === 0) return { min: -1, max: 1 };
                var nums = values.filter(function (v) { return typeof v === 'number' && !Number.isNaN(v); });
                if (nums.length === 0) return { min: -1, max: 1 };
                var min = Math.floor(Math.min.apply(null, nums));
                var max = Math.ceil(Math.max.apply(null, nums));
                min = Math.min(min - 1, 0);
                max = Math.max(max + 1, 0);
                if (max <= min) max = min + 1;
                return { min: min, max: max };
            }

            function bindModal(openButtonId, modalId) {
                var openButton = document.getElementById(openButtonId);
                var modal = document.getElementById(modalId);
                if (!openButton || !modal) return;
                openButton.addEventListener('click', function () { modal.classList.add('active'); });
                modal.addEventListener('click', function (event) {
                    if (event.target === modal) modal.classList.remove('active');
                });
                var closeButton = modal.querySelector('[data-close-modal]');
                if (closeButton) {
                    closeButton.addEventListener('click', function () { modal.classList.remove('active'); });
                }
            }
        })();

            // Sidebar toggle logic (copied from Dashboard layout)
            const sidebar = document.getElementById('dash-sidebar');
            const backdrop = document.getElementById('dash-sidebar-backdrop');
            const collapseBtn = document.getElementById('dash-sidebar-collapse');
            const expandBtn = document.getElementById('dash-sidebar-expand');
            const mobileToggle = document.getElementById('dash-mobile-toggle');
            const rootLayout = document.querySelector('.dash-layout-root');

            function toggleMobile() {
                if(sidebar) sidebar.classList.toggle('is-open');
                if(backdrop) backdrop.classList.toggle('is-open');
                if(sidebar) document.body.style.overflow = sidebar.classList.contains('is-open') ? 'hidden' : '';
            }

            function collapseDesktop() {
                if(rootLayout) rootLayout.classList.add('dash-sidebar-collapsed');
                if(sidebar) sidebar.style.transform = 'translateX(-105%)';
            }

            function expandDesktop() {
                if(rootLayout) rootLayout.classList.remove('dash-sidebar-collapsed');
                if(sidebar) sidebar.style.transform = 'translateX(0)';
            }

            if (mobileToggle) mobileToggle.addEventListener('click', toggleMobile);
            if (backdrop) backdrop.addEventListener('click', toggleMobile);
            if (collapseBtn) collapseBtn.addEventListener('click', collapseDesktop);
            if (expandBtn) expandBtn.addEventListener('click', expandDesktop);

            // Panel switching logic
            var navButtons = document.querySelectorAll('#dash-sidebar-nav .dash-nav-item');
            navButtons.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var targetPanel = btn.getAttribute('data-dash-panel');
                    // Deactivate all nav items and panels
                    navButtons.forEach(function(b) { b.classList.remove('is-active'); b.removeAttribute('aria-current'); });
                    document.querySelectorAll('.dash-panel').forEach(function(p) { p.classList.remove('is-active'); });
                    // Activate clicked nav item and target panel
                    btn.classList.add('is-active');
                    btn.setAttribute('aria-current', 'page');
                    var panel = document.getElementById('panel-' + targetPanel);
                    if (panel) panel.classList.add('is-active');
                    // Close mobile sidebar
                    if (window.innerWidth < 1024) {
                        if(sidebar) sidebar.classList.remove('is-open');
                        if(backdrop) backdrop.classList.remove('is-open');
                        document.body.style.overflow = '';
                    }
                });
            });
    </script>
    @if (Model.OperationAging is not null)
    {
        var agingVm = Model.OperationAging;
        var agingBucketLabelsJson = JsonSerializer.Serialize(agingVm.BucketLabels);
        var agingMatrixRowsJson = JsonSerializer.Serialize(agingVm.BucketMatrixRows);
        var agingDonutLabelsJson = JsonSerializer.Serialize(agingVm.DonutLabels);
        <script>
            (function () {
                var donutLabels = @Html.Raw(agingDonutLabelsJson);
                var bucketLabels = @Html.Raw(agingBucketLabelsJson);
                var matrixRows = @Html.Raw(agingMatrixRowsJson);
                var muted = 'rgba(148, 163, 184, 0.85)';

                function rowByKey(key) {
                    if (!Array.isArray(matrixRows)) return null;
                    for (var i = 0; i < matrixRows.length; i++) {
                        if (String(matrixRows[i].RowKey || '').toLowerCase() === key) return matrixRows[i];
                    }
                    return null;
                }

                if (typeof Chart !== 'undefined' && document.getElementById('aging-donut')) {
                    var repairDonut = rowByKey('repair');
                    new Chart(document.getElementById('aging-donut'), {
                        type: 'doughnut',
                        data: {
                            labels: donutLabels,
                            datasets: [{
                                data: repairDonut ? (repairDonut.BucketCounts || []) : [],
                                backgroundColor: ['#22d3ee', '#38bdf8', '#6366f1', '#a78bfa', '#f472b6', '#fb7185'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { position: 'bottom', labels: { color: muted, boxWidth: 12 } } }
                        }
                    });
                }
                if (typeof Chart !== 'undefined' && document.getElementById('aging-stacked')) {
                    var repair = rowByKey('repair');
                    new Chart(document.getElementById('aging-stacked'), {
                        type: 'bar',
                        data: {
                            labels: bucketLabels,
                            datasets: [
                                {
                                    label: 'Repair',
                                    data: repair ? (repair.BucketCounts || []) : [],
                                    backgroundColor: '#22c55e',
                                    borderRadius: 6,
                                    borderSkipped: false
                                }
                            ]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { beginAtZero: true, ticks: { color: muted, precision: 0 }, grid: { color: 'rgba(148,163,184,0.15)' } },
                                y: { ticks: { color: muted }, grid: { display: false } }
                            },
                            plugins: {
                                legend: { position: 'bottom', labels: { color: muted, boxWidth: 12 } },
                                tooltip: { enabled: true }
                            }
                        }
                    });
                }

                function applySkillFilter() {
                    var cbs = document.querySelectorAll('.aging-skill-cb');
                    var on = {};
                    cbs.forEach(function (cb) { on[cb.getAttribute('data-skill')] = cb.checked; });
                    document.querySelectorAll('.aging-detail-row').forEach(function (tr) {
                        var sk = tr.getAttribute('data-skill');
                        tr.classList.toggle('is-hidden', !on[sk]);
                    });
                }
                document.querySelectorAll('.aging-skill-cb').forEach(function (cb) {
                    cb.addEventListener('change', applySkillFilter);
                });
                applySkillFilter();

                function applyDayMetricFilter(root) {
                    root = root || document;
                    var cbs = root.querySelectorAll('.aging-day-metric-cb');
                    var on = {};
                    cbs.forEach(function (cb) { on[cb.getAttribute('data-metric')] = cb.checked; });
                    root.querySelectorAll('.aging-day-metric-row').forEach(function (tr) {
                        var k = tr.getAttribute('data-metric');
                        tr.classList.toggle('is-hidden', !on[k]);
                    });
                    updateGrandTotalRow(root);
                }
                function updateGrandTotalRow(root) {
                    root = root || document;
                    var table = root.querySelector('.aging-day-table');
                    if (!table) return;

                    var grandRow = table.querySelector('tr[data-grand-total="true"]');
                    if (!grandRow) return;

                    function parseCellValue(text) {
                        var cleaned = (text || '').replace(/,/g, '').trim();
                        var parsed = Number(cleaned);
                        return Number.isFinite(parsed) ? parsed : 0;
                    }

                    var dayTotals = {};
                    var grandTotal = 0;
                    table.querySelectorAll('tr.aging-day-metric-row:not(.is-hidden)').forEach(function (row) {
                        row.querySelectorAll('td[data-col-idx]').forEach(function (cell) {
                            var idx = cell.getAttribute('data-col-idx');
                            dayTotals[idx] = (dayTotals[idx] || 0) + parseCellValue(cell.textContent);
                        });
                        var rowTotalCell = row.querySelector('td.aging-total-col');
                        if (rowTotalCell) {
                            grandTotal += parseCellValue(rowTotalCell.textContent);
                        }
                    });

                    grandRow.querySelectorAll('td[data-col-idx]').forEach(function (cell) {
                        var idx = cell.getAttribute('data-col-idx');
                        cell.textContent = String(dayTotals[idx] || 0);
                    });
                    var grandTotalCell = grandRow.querySelector('td.aging-total-col');
                    if (grandTotalCell) {
                        grandTotalCell.textContent = String(grandTotal);
                    }
                }
                document.querySelectorAll('.aging-day-metric-cb').forEach(function (cb) {
                    cb.addEventListener('change', function () {
                        var section = cb.closest('#aging-day-section') || document;
                        applyDayMetricFilter(section);
                    });
                });
                applyDayMetricFilter();

                function bindDayTableHover(root) {
                    root = root || document;
                    var dayTable = root.querySelector('.aging-day-table');
                    if (!dayTable || dayTable.dataset.hoverBound === 'true') return;
                    dayTable.dataset.hoverBound = 'true';

                    function clearColumnHover() {
                        dayTable.querySelectorAll('.is-col-hover').forEach(function (el) {
                            el.classList.remove('is-col-hover');
                        });
                    }

                    function setColumnHover(colIdx) {
                        clearColumnHover();
                        if (colIdx === null || colIdx === undefined) return;
                        dayTable.querySelectorAll('[data-col-idx="' + colIdx + '"]').forEach(function (el) {
                            el.classList.add('is-col-hover');
                        });
                    }

                    dayTable.addEventListener('mouseover', function (event) {
                        var target = event.target.closest('[data-col-idx]');
                        if (!target) return;
                        setColumnHover(target.getAttribute('data-col-idx'));
                    });

                    dayTable.addEventListener('mouseleave', function () {
                        clearColumnHover();
                    });
                }
                bindDayTableHover();

                function bindDaySectionAjax() {
                    var daySection = document.getElementById('aging-day-section');
                    if (!daySection) return;

                    async function loadDaySection(url, shouldPushState) {
                        if (!url) return;
                        daySection.classList.add('is-loading');
                        try {
                            var response = await fetch(url, {
                                method: 'GET',
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            });
                            if (!response.ok) throw new Error('Failed request: ' + response.status);
                            var html = await response.text();
                            var parser = new DOMParser();
                            var nextDoc = parser.parseFromString(html, 'text/html');
                            var nextSection = nextDoc.getElementById('aging-day-section');
                            if (!nextSection) {
                                window.location.href = url;
                                return;
                            }

                            daySection.outerHTML = nextSection.outerHTML;
                            if (shouldPushState) {
                                window.history.pushState({ agingDayUrl: url }, '', url);
                            }

                            var refreshedSection = document.getElementById('aging-day-section');
                            if (refreshedSection) {
                                refreshedSection.querySelectorAll('.aging-day-metric-cb').forEach(function (cb) {
                                    cb.addEventListener('change', function () { applyDayMetricFilter(refreshedSection); });
                                });
                                applyDayMetricFilter(refreshedSection);
                                bindDayTableHover(refreshedSection);
                            }
                            bindDaySectionAjax();
                        } catch (error) {
                            window.location.href = url;
                        } finally {
                            var section = document.getElementById('aging-day-section');
                            if (section) {
                                section.classList.remove('is-loading');
                            }
                        }
                    }

                    daySection.querySelectorAll('form[data-ajax-day="true"]').forEach(function (form) {
                        if (form.dataset.ajaxBound === 'true') return;
                        form.dataset.ajaxBound = 'true';

                        form.addEventListener('submit', function (event) {
                            event.preventDefault();
                            var params = new URLSearchParams(new FormData(form));
                            var action = form.getAttribute('action') || window.location.pathname;
                            var requestUrl = action + '?' + params.toString();
                            loadDaySection(requestUrl, true);
                        });
                    });
                }
                bindDaySectionAjax();

                function bindDetailAjax() {
                    var detailSection = document.getElementById('aging-detail-section');
                    if (!detailSection) return;

                    async function loadDetailSection(url, shouldPushState) {
                        if (!url) return;
                        detailSection.classList.add('is-loading');
                        try {
                            var response = await fetch(url, {
                                method: 'GET',
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            });
                            if (!response.ok) throw new Error('Failed request: ' + response.status);
                            var html = await response.text();
                            var parser = new DOMParser();
                            var nextDoc = parser.parseFromString(html, 'text/html');
                            var nextSection = nextDoc.getElementById('aging-detail-section');
                            if (!nextSection) {
                                window.location.href = url;
                                return;
                            }
                            detailSection.outerHTML = nextSection.outerHTML;
                            if (shouldPushState) {
                                window.history.pushState({ agingDetailUrl: url }, '', url);
                            }
                            bindDetailAjax();
                        } catch (error) {
                            window.location.href = url;
                        } finally {
                            var refreshedSection = document.getElementById('aging-detail-section');
                            if (refreshedSection) {
                                refreshedSection.classList.remove('is-loading');
                            }
                        }
                    }

                    detailSection.querySelectorAll('a[data-ajax-detail-link="true"]').forEach(function (link) {
                        link.addEventListener('click', function (event) {
                            if (link.style.pointerEvents === 'none' || link.classList.contains('disabled')) return;
                            event.preventDefault();
                            loadDetailSection(link.href, true);
                        });
                    });

                    detailSection.querySelectorAll('form[data-ajax-detail="true"]').forEach(function (form) {
                        form.addEventListener('submit', function (event) {
                            event.preventDefault();
                            var params = new URLSearchParams(new FormData(form));
                            var action = form.getAttribute('action') || window.location.pathname;
                            var requestUrl = action + '?' + params.toString();
                            loadDetailSection(requestUrl, true);
                        });
                    });
                }
                bindDetailAjax();

                window.addEventListener('popstate', function () {
                    bindDetailAjax();
                });

            // Sidebar toggle logic (copied from Dashboard layout)
            const sidebar = document.getElementById('dash-sidebar');
            const backdrop = document.getElementById('dash-sidebar-backdrop');
            const collapseBtn = document.getElementById('dash-sidebar-collapse');
            const expandBtn = document.getElementById('dash-sidebar-expand');
            const mobileToggle = document.getElementById('dash-mobile-toggle');
            const rootLayout = document.querySelector('.dash-layout-root');

            function toggleMobile() {
                if(sidebar) sidebar.classList.toggle('is-open');
                if(backdrop) backdrop.classList.toggle('is-open');
                if(sidebar) document.body.style.overflow = sidebar.classList.contains('is-open') ? 'hidden' : '';
            }

            function collapseDesktop() {
                if(rootLayout) rootLayout.classList.add('dash-sidebar-collapsed');
                if(sidebar) sidebar.style.transform = 'translateX(-105%)';
            }

            function expandDesktop() {
                if(rootLayout) rootLayout.classList.remove('dash-sidebar-collapsed');
                if(sidebar) sidebar.style.transform = 'translateX(0)';
            }

            if (mobileToggle) mobileToggle.addEventListener('click', toggleMobile);
            if (backdrop) backdrop.addEventListener('click', toggleMobile);
            if (collapseBtn) collapseBtn.addEventListener('click', collapseDesktop);
            if (expandBtn) expandBtn.addEventListener('click', expandDesktop);
        })();
        </script>
    }
}
