    .lazy-visual-target {
        position: relative;
        min-height: 280px;
    }
    .lazy-visual-target.lazy-visual-pending > div[style*="height: 280px"],
    .lazy-visual-target.lazy-visual-pending > div[style*="height: 260px"] {
        opacity: 0;
    }
    #nap-davao-map-wrap.lazy-visual-pending #nap-davao-map,
    #rhm-map-wrap.lazy-visual-pending #rhm-map,
    #dhm-map-wrap.lazy-visual-pending #dhm-map {
        min-height: 420px;
        visibility: hidden;
    }
    .lazy-visual-target.lazy-visual-pending::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 2;
        border-radius: inherit;
        background: linear-gradient(90deg, rgba(42,42,74,0.15) 0%, rgba(99,102,241,0.12) 50%, rgba(42,42,74,0.15) 100%);
        background-size: 200% 100%;
        animation: lazy-visual-shimmer 1.4s ease-in-out infinite;
        pointer-events: none;
    }
    :root[data-theme="light"] .lazy-visual-target.lazy-visual-pending::before {
        background: linear-gradient(90deg, rgba(226,232,240,0.4) 0%, rgba(199,210,254,0.55) 50%, rgba(226,232,240,0.4) 100%);
        background-size: 200% 100%;
    }
    .lazy-visual-target.lazy-visual-loaded::before {
        display: none;
    }
    @@keyframes lazy-visual-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    /* ── Fullscreen: fill the entire desktop viewport ── */
