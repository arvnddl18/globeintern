@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
    <script src="~/js/circuit-map.js" asp-append-version="true"></script>
    <script src="~/js/dlpc-map.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.CircuitMap && typeof window.CircuitMap.init === 'function') {
                window.CircuitMap.init();
            }
            if (window.RouteMap && typeof window.RouteMap.init === 'function') {
                window.RouteMap.init();
            }
            if (window.DlpcMap && typeof window.DlpcMap.init === 'function') {
                window.DlpcMap.init();
            }
            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                window.lucide.createIcons();
            }
            
            // Sidebar toggle logic (copied from Dashboard layout)
            const sidebar = document.getElementById('dash-sidebar');
            const backdrop = document.getElementById('dash-sidebar-backdrop');
            const collapseBtn = document.getElementById('dash-sidebar-collapse');
            const expandBtn = document.getElementById('dash-sidebar-expand');
            const mobileToggle = document.getElementById('dash-mobile-toggle');
            const rootLayout = document.querySelector('.dash-layout-root');

            function toggleMobile() {
                sidebar.classList.toggle('is-open');
                backdrop.classList.toggle('is-open');
                document.body.style.overflow = sidebar.classList.contains('is-open') ? 'hidden' : '';
            }

            function collapseDesktop() {
                if(rootLayout) rootLayout.classList.add('dash-sidebar-collapsed');
                sidebar.style.transform = 'translateX(-105%)';
            }

            function expandDesktop() {
                if(rootLayout) rootLayout.classList.remove('dash-sidebar-collapsed');
                sidebar.style.transform = 'translateX(0)';
            }

            if (mobileToggle) mobileToggle.addEventListener('click', toggleMobile);
            if (backdrop) backdrop.addEventListener('click', toggleMobile);
            if (collapseBtn) collapseBtn.addEventListener('click', collapseDesktop);
            if (expandBtn) expandBtn.addEventListener('click', expandDesktop);
            
            // Tab switching logic
            const navItems = document.querySelectorAll('.dash-nav-item');
            const panels = document.querySelectorAll('.dash-panel');
            
            navItems.forEach(item => {
                item.addEventListener('click', () => {
                    // Remove active from all
                    navItems.forEach(nav => {
                        nav.classList.remove('is-active');
                        nav.removeAttribute('aria-current');
                    });
                    panels.forEach(panel => panel.classList.remove('is-active'));
                    
                    // Add active to clicked
                    item.classList.add('is-active');
                    item.setAttribute('aria-current', 'page');
                    const targetId = item.getAttribute('data-dash-panel');
                    const targetPanel = document.getElementById('panel-' + targetId);
                    if (targetPanel) {
                        targetPanel.classList.add('is-active');
                        
                        // Fix leaflet map sizing issue when rendering in a hidden div
                        if (targetId === 'map' && window.CircuitMap && typeof window.CircuitMap.invalidateSize === 'function') {
                            window.CircuitMap.invalidateSize();
                        } else if (targetId === 'route-map' && window.RouteMap && typeof window.RouteMap.invalidateSize === 'function') {
                            window.RouteMap.invalidateSize();
                        } else if (targetId === 'dlpc-map' && window.DlpcMap && typeof window.DlpcMap.invalidateSize === 'function') {
                            window.DlpcMap.invalidateSize();
                        }
                    }
                });
            });
        });
    </script>
    <script src="~/js/route-pole-to-pole.js" asp-append-version="true"></script>
}
