@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-ui-dist@1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script>
        var chartColors = [
            '#6366f1', '#22c55e', '#f97316', '#ec4899', '#3b82f6',
            '#a855f7', '#14b8a6', '#eab308', '#ef4444', '#06b6d4',
            '#8b5cf6', '#10b981', '#f59e0b', '#e11d48', '#0ea5e9'
        ];

        var fontColor = '#c8c8e0';
        var gridColor = 'rgba(42, 42, 74, 0.6)';

        Chart.defaults.color = fontColor;
        Chart.defaults.borderColor = gridColor;
        Chart.defaults.font.family = "'DM Sans', sans-serif";

        var statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution));
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: Object.keys(statusData),
                datasets: [{
                    data: Object.values(statusData),
                    backgroundColor: chartColors.slice(0, Object.keys(statusData).length),
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { padding: 12, usePointStyle: true, pointStyleWidth: 10, font: { size: 11 } } }
                }
            }
        });

        var territoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TerritoryDistribution));
        var sortedTerritory = Object.entries(territoryData).sort(function(a, b) { return b[1] - a[1]; });
        new Chart(document.getElementById('territoryChart'), {
            type: 'bar',
            data: {
                labels: sortedTerritory.map(function(e) { return e[0]; }),
                datasets: [{
                    data: sortedTerritory.map(function(e) { return e[1]; }),
                    backgroundColor: '#6366f1',
                    borderRadius: 4,
                    barThickness: 18
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: gridColor }, ticks: { font: { size: 10 } } },
                    y: { grid: { display: false }, ticks: { font: { size: 10, family: "'JetBrains Mono', monospace" } } }
                }
            }
        });

        var dateData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppointmentsByDate));
        var dateKeys = Object.keys(dateData).sort();
        new Chart(document.getElementById('dateChart'), {
            type: 'line',
            data: {
                labels: dateKeys,
                datasets: [{
                    label: 'Appointments',
                    data: dateKeys.map(function(k) { return dateData[k]; }),
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: dateKeys.length > 30 ? 0 : 4,
                    pointBackgroundColor: '#6366f1',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        grid: { color: gridColor },
                        ticks: { maxRotation: 45, font: { size: 9, family: "'JetBrains Mono', monospace" }, maxTicksLimit: 15 }
                    },
                    y: { grid: { color: gridColor }, beginAtZero: true, ticks: { font: { size: 10 } } }
                }
            }
        });

        (function initSlotAdherenceSummary() {
            if ('@Model.ActiveDashboardView' !== 'status') return;
            var chartCanvas = document.getElementById('slotAdherenceSummaryChart');
            if (!chartCanvas) return;

            var previewRowsForSummary = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PreviewRows));
            var periodButtons = Array.from(document.querySelectorAll('#slot-adherence-summary-report .slot-adh-period-btn'));
            var territoryRowsEl = document.getElementById('slot-adherence-territory-rows');
            var skillsetRowsEl = document.getElementById('slot-adherence-skillset-rows');
            var summaryChart = null;
            var activePeriod = 'day';

            function isLightTheme() {
                return document.documentElement.getAttribute('data-theme') === 'light';
            }

            function getSummaryPalette() {
                if (isLightTheme()) {
                    return {
                        scheduledFill: '#7c3aed',
                        scheduledBorder: '#5b21b6',
                        passFill: '#16a34a',
                        passBorder: '#166534',
                        gridColor: '#d8deea',
                        fontColor: '#334155'
                    };
                }
                return {
                    scheduledFill: '#a78bfa',
                    scheduledBorder: '#8b5cf6',
                    passFill: '#22c55e',
                    passBorder: '#16a34a',
                    gridColor: 'rgba(42, 42, 74, 0.6)',
                    fontColor: '#c8c8e0'
                };
            }

            function toIsoDate(rawValue) {
                var raw = String(rawValue || '').trim();
                if (!raw) return null;

                var isoMatch = raw.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
                if (isoMatch) {
                    var y = parseInt(isoMatch[1], 10);
                    var m = parseInt(isoMatch[2], 10);
                    var d = parseInt(isoMatch[3], 10);
                    if (!isNaN(y) && !isNaN(m) && !isNaN(d)) {
                        return y.toString().padStart(4, '0') + '-' + m.toString().padStart(2, '0') + '-' + d.toString().padStart(2, '0');
                    }
                }

                var mdYMatch = raw.match(/(\d{1,2})[-\/](\d{1,2})[-\/](\d{2,4})/);
                if (mdYMatch) {
                    var mm = parseInt(mdYMatch[1], 10);
                    var dd = parseInt(mdYMatch[2], 10);
                    var yy = parseInt(mdYMatch[3], 10);
                    if (yy < 100) yy += 2000;
                    if (!isNaN(yy) && !isNaN(mm) && !isNaN(dd)) {
                        return yy.toString().padStart(4, '0') + '-' + mm.toString().padStart(2, '0') + '-' + dd.toString().padStart(2, '0');
                    }
                }
                return null;
            }

            function getWeekKey(isoDate) {
                var date = new Date(isoDate + 'T00:00:00Z');
                if (isNaN(date.getTime())) return null;
                var day = date.getUTCDay();
                var mondayShift = day === 0 ? -6 : 1 - day;
                date.setUTCDate(date.getUTCDate() + mondayShift);
                var y = date.getUTCFullYear();
                var m = date.getUTCMonth() + 1;
                var d = date.getUTCDate();
                return y.toString().padStart(4, '0') + '-' + m.toString().padStart(2, '0') + '-' + d.toString().padStart(2, '0');
            }

            function getMonthKey(isoDate) {
                return isoDate.slice(0, 7);
            }

            function groupRows(period) {
                var grouped = new Map();
                for (var i = 0; i < previewRowsForSummary.length; i++) {
                    var row = previewRowsForSummary[i] || {};
                    var isoDate = toIsoDate(row['AppointmentDate']);
                    if (!isoDate) continue;

                    var bucketKey = period === 'week'
                        ? getWeekKey(isoDate)
                        : period === 'month'
                            ? getMonthKey(isoDate)
                            : isoDate;
                    if (!bucketKey) continue;

                    if (!grouped.has(bucketKey)) {
                        grouped.set(bucketKey, { scheduled: 0, pass: 0 });
                    }
                    var current = grouped.get(bucketKey);
                    current.scheduled += 1;
                    if (String(row['Compliance'] || '').toUpperCase() === 'PASS') {
                        current.pass += 1;
                    }
                }

                return Array.from(grouped.entries())
                    .sort(function(a, b) { return a[0].localeCompare(b[0]); });
            }

            function renderPeriodButtons() {
                periodButtons.forEach(function(btn) {
                    var isActive = btn.getAttribute('data-period') === activePeriod;
                    btn.classList.toggle('slot-adh-period-btn-active', isActive);
                });
            }

            function renderSummaryChart(period) {
                var groupedEntries = groupRows(period);
                var labels = groupedEntries.map(function(entry) { return entry[0]; });
                var scheduledValues = groupedEntries.map(function(entry) { return entry[1].scheduled; });
                var passValues = groupedEntries.map(function(entry) { return entry[1].pass; });
                var palette = getSummaryPalette();

                if (summaryChart) {
                    summaryChart.destroy();
                }

                summaryChart = new Chart(chartCanvas, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Scheduled',
                                data: scheduledValues,
                                backgroundColor: palette.scheduledFill,
                                borderColor: palette.scheduledBorder,
                                borderWidth: 1.2,
                                borderRadius: 5,
                                barPercentage: 0.86,
                                categoryPercentage: 0.74,
                                maxBarThickness: 26
                            },
                            {
                                label: 'Pass',
                                data: passValues,
                                backgroundColor: palette.passFill,
                                borderColor: palette.passBorder,
                                borderWidth: 1.2,
                                borderRadius: 5,
                                barPercentage: 0.86,
                                categoryPercentage: 0.74,
                                maxBarThickness: 26
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    color: palette.fontColor,
                                    usePointStyle: true,
                                    pointStyle: 'rectRounded',
                                    padding: 12,
                                    font: { size: 11, family: "'DM Sans', sans-serif" }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: palette.gridColor },
                                ticks: { color: palette.fontColor, maxRotation: 45, minRotation: 0, font: { size: 10 } }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: palette.gridColor },
                                ticks: { color: palette.fontColor, precision: 0, font: { size: 10 } }
                            }
                        }
                    }
                });
            }

            function renderPassFailRows(targetEl, keySelector) {
                if (!targetEl) return;
                var grouped = new Map();

                for (var i = 0; i < previewRowsForSummary.length; i++) {
                    var row = previewRowsForSummary[i] || {};
                    var label = String(keySelector(row) || '').trim();
                    if (!label) label = '(blank)';
                    var compliance = String(row['Compliance'] || '').toUpperCase();
                    if (compliance !== 'PASS' && compliance !== 'FAIL') continue;

                    if (!grouped.has(label)) {
                        grouped.set(label, { pass: 0, fail: 0 });
                    }
                    var current = grouped.get(label);
                    if (compliance === 'PASS') current.pass += 1;
                    if (compliance === 'FAIL') current.fail += 1;
                }

                var rows = Array.from(grouped.entries())
                    .map(function(entry) {
                        var passCount = entry[1].pass;
                        var failCount = entry[1].fail;
                        var denom = passCount + failCount;
                        var rate = denom > 0 ? (passCount / denom * 100).toFixed(1) + '%' : 'N/A';
                        return {
                            name: entry[0],
                            pass: passCount,
                            fail: failCount,
                            rate: rate,
                            total: denom
                        };
                    })
                    .sort(function(a, b) {
                        if (b.total !== a.total) return b.total - a.total;
                        return a.name.localeCompare(b.name);
                    });

                if (rows.length === 0) {
                    targetEl.innerHTML = '<div class="px-4 py-4 text-xs" style="color:#8a8ab0;">No Pass/Fail rows for current filters.</div>';
                    return;
                }

                targetEl.innerHTML = rows.map(function(item) {
                    return '<div class="slot-adh-row grid grid-cols-[1fr_6rem_6rem_6rem] gap-2 px-4 py-2.5 text-sm" style="border-top: 1px solid rgba(42,42,74,0.6);">' +
                        '<span class="font-medium truncate" title="' + item.name.replace(/"/g, '&quot;') + '" style="color:#c8c8e0;">' + item.name + '</span>' +
                        '<span class="text-right font-mono slot-adh-pass">' + item.pass.toLocaleString() + '</span>' +
                        '<span class="text-right font-mono slot-adh-fail">' + item.fail.toLocaleString() + '</span>' +
                        '<span class="text-right font-mono slot-adh-rate">' + item.rate + '</span>' +
                    '</div>';
                }).join('');
            }

            function renderSummary(period) {
                activePeriod = period;
                renderPeriodButtons();
                renderSummaryChart(period);
            }

            periodButtons.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var nextPeriod = btn.getAttribute('data-period') || 'day';
                    renderSummary(nextPeriod);
                });
            });

            renderPassFailRows(territoryRowsEl, function(row) { return row['Territory']; });
            renderPassFailRows(skillsetRowsEl, function(row) { return row['Skillset']; });
            renderSummary('day');

            var themeObserver = new MutationObserver(function(mutations) {
                for (var i = 0; i < mutations.length; i++) {
                    if (mutations[i].attributeName === 'data-theme') {
                        renderSummary(activePeriod);
                        break;
                    }
                }
            });
            themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
        })();

        (function initSlotAdherenceExports() {
            var csvBtn = document.getElementById('slot-adh-export-csv-btn');
