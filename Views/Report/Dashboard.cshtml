        <span>@dashErr</span>
    </div>
}

@if (TempData["ComplianceNotice"] is string compNote)
{
    <div class="mb-6 fade-in rounded-xl px-4 py-3 flex items-center gap-2 text-sm font-medium"
         style="background: rgba(99, 102, 241, 0.12); border: 1px solid #6366f1; color: #c8c8e0;">
        <i data-lucide="info" style="width:16px; height:16px; flex-shrink:0; color:#a5b4fc;"></i>
        <span>@compNote</span>
    </div>
}

@if (TempData["ArchivedFilterNotice"] is string archFilterNote)
{
    <div class="mb-6 fade-in rounded-xl px-4 py-3 flex items-center gap-2 text-sm font-medium"
         style="background: rgba(99, 102, 241, 0.12); border: 1px solid #6366f1; color: #c8c8e0;">
        <i data-lucide="archive" style="width:16px; height:16px; flex-shrink:0; color:#a5b4fc;"></i>
        <span>@archFilterNote</span>
