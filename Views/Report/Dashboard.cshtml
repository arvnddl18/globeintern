                } else {
                    csvBtn.textContent = defaultCsvText;
                    xlsxBtn.textContent = defaultXlsxText;
                }
            }

            async function exportVisualPdf() {
                var reportRoot = document.getElementById('slot-adherence-report');
                if (!reportRoot || typeof html2canvas !== 'function' || !window.jspdf || !window.jspdf.jsPDF) {
                    throw new Error('PDF export dependencies are unavailable.');
                }

                var jsPDFCtor = window.jspdf.jsPDF;
                var pdf = new jsPDFCtor({ orientation: 'landscape', unit: 'pt', format: 'a4' });
                var pageWidth = pdf.internal.pageSize.getWidth();
                var pageHeight = pdf.internal.pageSize.getHeight();
                var margin = 24;
                var headerSpace = 42;
                var footerSpace = 18;
                var contentWidth = pageWidth - margin * 2;
                var contentHeight = pageHeight - margin * 2 - headerSpace - footerSpace;
                var pageNumber = 0;

                function decoratePage(title) {
                    pageNumber += 1;
                    pdf.setFont('helvetica', 'bold');
                    pdf.setFontSize(13);
                    pdf.setTextColor(35, 44, 75);
                    pdf.text(title, margin, margin + 12);
                    pdf.setDrawColor(210, 220, 236);
                    pdf.line(margin, margin + 18, pageWidth - margin, margin + 18);
                    pdf.setFont('helvetica', 'normal');
                    pdf.setFontSize(9);
                    pdf.setTextColor(120, 130, 150);
                    pdf.text('Page ' + pageNumber, pageWidth - margin - 34, pageHeight - margin + 4);
                }

                function addSlideFromCanvas(canvas, title) {
                    if (!canvas || canvas.width <= 0 || canvas.height <= 0) return;
                    var imageData = canvas.toDataURL('image/png');
                    var imageHeight = (canvas.height * contentWidth) / canvas.width;
                    var drawHeight = Math.min(contentHeight, imageHeight);
                    if (pageNumber > 0) pdf.addPage();
                    decoratePage(title);
                    var drawTop = margin + headerSpace;
                    pdf.addImage(imageData, 'PNG', margin, drawTop, contentWidth, drawHeight, undefined, 'FAST');
                }

                function getSlideTargets() {
                    var targets = [];
                    var header = reportRoot.querySelector(':scope > div');
                    if (header) targets.push({ el: header, title: 'Slot Adherence Report' });

                    var sections = Array.from(reportRoot.querySelectorAll(':scope > section'));
                    sections.forEach(function(section) {
                        if (!section) return;
                        if (section.querySelector('#table-body')) return; // Exclude Data Preview
                        if (section.querySelector('#slot-adh-export-csv-btn')) return; // Exclude export buttons
                        var heading = section.querySelector('.text-sm.font-semibold, .kpi-title');
                        var title = heading ? String(heading.textContent || '').trim() : 'Slot Adherence Report';
                        if (!title) title = 'Slot Adherence Report';
                        targets.push({ el: section, title: title });
                    });
                    return targets;
                }

                var slideTargets = getSlideTargets();
                if (slideTargets.length === 0) {
                    throw new Error('No visible report sections found for PDF export.');
                }

                for (var i = 0; i < slideTargets.length; i++) {
                    var slide = slideTargets[i];
                    var canvas = await html2canvas(slide.el, {
                        scale: 2,
                        backgroundColor: '#0d0d1a',
                        useCORS: true,
                        logging: false,
                        windowWidth: document.documentElement.scrollWidth
                    });
                    addSlideFromCanvas(canvas, slide.title);
                }

                var viewLabel = '@Model.ActiveDashboardView';
                var dateStamp = new Date().toISOString().replace(/[:.]/g, '-');
                pdf.save('SlotAdherenceVisual_' + viewLabel + '_' + dateStamp + '.pdf');
            }

            csvBtn.addEventListener('click', function() {
                if (isBusy) return;
                setBusy(true, 'csv');
                csvForm.submit();
                window.setTimeout(function() { setBusy(false); }, 1800);
            });

            xlsxBtn.addEventListener('click', function() {
                if (isBusy) return;
                setBusy(true, 'xlsx');
                exportVisualPdf()
                    .catch(function() {
                        window.alert('Unable to export visual PDF. Please try again.');
                    })
                    .finally(function() {
                        setBusy(false);
                    });
            });
        })();

