                isDark
                    ? 'https://{s}.basemaps.cartocdn.com/dark_only_labels/{z}/{x}/{y}{r}.png'
                    : 'https://{s}.basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}{r}.png',
                { maxZoom: 18, subdomains: 'abcd', pane: 'overlayPane', opacity: 0.7 }
            ).addTo(napMap);
            var heatLayer = L.heatLayer([], {
                radius: 22,
                blur: 28,
                maxZoom: 17,
                max: 1.0,
                gradient: {
                    0.0: '#43a047',
                    0.25: '#43a047',
                    0.5: '#fdd835',
                    0.75: '#fb8c00',
                    1.0: '#e53935'
                }
            }).addTo(napMap);
            var dotsGroup = L.layerGroup().addTo(napMap);
            var filterState = { repair: true, install: true, heatMode: 'all' };

            var NapFilterControl = L.Control.extend({
                options: { position: 'topleft' },
                onAdd: function() {
                    var el = L.DomUtil.create('div', 'nap-map-filter-ctrl');
                    L.DomEvent.disableClickPropagation(el);
                    L.DomEvent.disableScrollPropagation(el);
                    var chevronSvg =
                        '<svg class="nap-flt-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';
                    function row(id, dotStyle, labelText, isChecked) {
                        var chk = isChecked !== false ? ' checked' : '';
                        return '<label class="nap-map-filter-row"><input type="checkbox" class="nap-map-filter-cb" id="' + id + '"' + chk + '><span class="nap-map-filter-dot" style="' + dotStyle + '"></span><span class="nap-map-filter-label">' + labelText + '</span></label>';
                    }
                    var heatSection =
                        '<span class="nap-flt-section">Heatmap</span>' +
                        row('nap-flt-heat-all', 'background: linear-gradient(135deg,#43a047 0%,#43a047 25%,#fdd835 25%,#fdd835 50%,#fb8c00 50%,#fb8c00 75%,#e53935 75%,#e53935 100%);', 'All', true) +
                        row('nap-flt-heat-repair', 'background:#32CD32; box-shadow:0 0 4px rgba(50,205,50,0.75);', 'Repair', false) +
                        row('nap-flt-heat-install', 'background:#1E90FF; box-shadow:0 0 4px rgba(30,144,255,0.7);', 'Install', false);
                    var pinsSection = hasCoordinates
                        ? '<div class="nap-map-filter-divider"></div><span class="nap-flt-section">NAP Pins</span>' +
                          row('nap-flt-repair', 'background:#32CD32; box-shadow:0 0 4px rgba(50,205,50,0.75);', 'Repair') +
                          row('nap-flt-install', 'background:#1E90FF; box-shadow:0 0 4px rgba(30,144,255,0.7);', 'Install')
                        : '';
                    el.innerHTML =
                        '<div class="nap-flt-header" id="nap-flt-toggle"><svg style="width:11px;height:11px;flex-shrink:0;color:#6366f1;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg><span class="nap-flt-title">Filters</span>' + chevronSvg + '</div>' +
                        '<div class="nap-flt-body" id="nap-flt-body">' + heatSection + pinsSection + '</div>';

                    var header = el.querySelector('#nap-flt-toggle');
                    var body = el.querySelector('#nap-flt-body');
                    var chevron = el.querySelector('.nap-flt-chevron');
                    header.addEventListener('click', function() {
                        var isOpen = body.classList.toggle('open');
                        chevron.classList.toggle('open', isOpen);
                    });

                    var heatIds = ['nap-flt-heat-all', 'nap-flt-heat-repair', 'nap-flt-heat-install'];
                    body.addEventListener('change', function(e) {
                        if (heatIds.indexOf(e.target.id) !== -1) {
                            heatIds.forEach(function(hid) {
                                var cb = el.querySelector('#' + hid);
                                if (cb) cb.checked = hid === e.target.id;
                            });
                            filterState.heatMode =
                                e.target.id === 'nap-flt-heat-repair' ? 'repair' :
                                e.target.id === 'nap-flt-heat-install' ? 'install' : 'all';
                            render();
                            return;
                        }
                        var repairCb = el.querySelector('#nap-flt-repair');
                        var installCb = el.querySelector('#nap-flt-install');
                        if (repairCb) filterState.repair = repairCb.checked;
                        if (installCb) filterState.install = installCb.checked;
                        render();
                    });
                    return el;
                }
            });
            new NapFilterControl().addTo(napMap);

            function renderHeatmap(range) {
                var points = [];
                var napCoordByDpid = buildNapCoordByDpidIndex(range);
                for (var j = 0; j < hmJoinDateInts.length; j++) {
                    if (!isDateIntInRange(hmJoinDateInts[j], range)) continue;
                    if (!passJoinFilter(j)) continue;
                    if (!matchesSkillsetGate(hmJoinSkillsets[j])) continue;
                    if (!passesReferenceAndBarangay(hmJoinDpids[j])) continue;
                    var joinNormDpid = normalizeDpid(hmJoinDpids[j]);
                    if (!joinNormDpid) continue;
                    var joinCoords = napRefCoordsByDp.get(joinNormDpid) || napCoordByDpid.get(joinNormDpid);
                    if (napRefSet !== null && !napRefCoordsByDp.get(joinNormDpid)) continue;
                    if (!joinCoords) continue;
                    var joinLat = joinCoords[0];
                    var joinLng = joinCoords[1];
                    if (joinLat < 6.5 || joinLat > 8.0 || joinLng < 124.5 || joinLng > 126.5) continue;
                    var joinSkill = String(hmJoinSkillsets[j] || '').trim().toLowerCase();
                    var joinIsRepair = joinSkill.indexOf('repair') !== -1;
                    var joinIsInstall = joinSkill.indexOf('install') !== -1;
                    if (filterState.heatMode === 'repair' && !joinIsRepair) continue;
                    if (filterState.heatMode === 'install' && !joinIsInstall) continue;
                    if (filterState.heatMode === 'all' && !joinIsRepair && !joinIsInstall) continue;
                    points.push([joinLat, joinLng]);
                }
                heatLayer.setLatLngs(points);
            }

            var DOT_STYLE_REPAIR = { radius: 3, color: '#1f7f1f', fillColor: '#32CD32', fillOpacity: 0.95, weight: 0.6, opacity: 0.98 };
            var DOT_STYLE_INSTALL = { radius: 3, color: '#1a5eb0', fillColor: '#1E90FF', fillOpacity: 0.92, weight: 0.5, opacity: 0.95 };
            function renderDots(range) {
                dotsGroup.clearLayers();
                if (!filterState.repair && !filterState.install) return;
                var napCoordByDpid = buildNapCoordByDpidIndex(range);
                for (var j = 0; j < hmJoinDateInts.length; j++) {
                    if (!isDateIntInRange(hmJoinDateInts[j], range)) continue;
                    if (!passJoinFilter(j)) continue;
                    if (!matchesSkillsetGate(hmJoinSkillsets[j])) continue;
                    if (!passesReferenceAndBarangay(hmJoinDpids[j])) continue;
                    var joinNormDpid = normalizeDpid(hmJoinDpids[j]);
                    if (!joinNormDpid) continue;
                    var joinCoords = napRefCoordsByDp.get(joinNormDpid) || napCoordByDpid.get(joinNormDpid);
                    if (napRefSet !== null && !napRefCoordsByDp.get(joinNormDpid)) continue;
                    if (!joinCoords) continue;
                    var joinLat = joinCoords[0];
                    var joinLng = joinCoords[1];
                    if (joinLat < 6.5 || joinLat > 8.0 || joinLng < 124.5 || joinLng > 126.5) continue;
                    var joinSkill = String(hmJoinSkillsets[j] || '').trim().toLowerCase();
                    var joinIsRepair = joinSkill.indexOf('repair') !== -1;
                    var joinIsInstall = joinSkill.indexOf('install') !== -1;
                    if (!joinIsRepair && !joinIsInstall) continue;
                    if (joinIsRepair && !filterState.repair) continue;
                    if (joinIsInstall && !filterState.install) continue;
                    var renderLat = computeJitter(joinLat, (j + 1) * 2.17);
                    var renderLng = computeJitter(joinLng, (j + 1) * 3.41);
                    var joinDot = L.circleMarker([renderLat, renderLng], joinIsRepair ? DOT_STYLE_REPAIR : DOT_STYLE_INSTALL);
                    var jDay = Math.round(hmJoinDateInts[j]) % 100;
                    var jYear = 2000 + Math.floor(Math.round(hmJoinDateInts[j]) / 10000);
                    var jMon = Math.floor((Math.round(hmJoinDateInts[j]) % 10000) / 100);
                    var jDateStr = jYear + '-' + (jMon < 10 ? '0' + jMon : String(jMon)) + '-' + (jDay < 10 ? '0' + jDay : String(jDay));
                    joinDot.bindTooltip(
                        '<div class="nap-dot-tip-name">' + joinNormDpid + '</div><div class="nap-dot-tip-date">' + jDateStr + '</div>',
                        { direction: 'top', className: 'nap-dot-tip', permanent: false, sticky: false, offset: [0, -4] }
                    );
                    dotsGroup.addLayer(joinDot);
                }
            }

            function renderBarangayAndFixPanels(range) {
                var byBarangay = {};
                var byFix = {};
                var total = 0;
                var repair = 0;
                var install = 0;
                var seenBarangays = {};

                for (var i = 0; i < hmJoinDateInts.length; i++) {
                    if (!isDateIntInRange(hmJoinDateInts[i], range)) continue;
                    if (!passJoinFilter(i)) continue;
                    if (!matchesSkillsetGate(hmJoinSkillsets[i])) continue;
                    if (!passesReferenceAndBarangay(hmJoinDpids[i])) continue;

                    total++;
                    var sk = String(hmJoinSkillsets[i] || '').toLowerCase();
                    if (sk.indexOf('repair') !== -1) repair++;
                    if (sk.indexOf('install') !== -1) install++;

                    var brgy = referenceBarangayForDpid(hmJoinDpids[i]);
                    if (selectedBarangay && brgy !== selectedBarangay) continue;
                    if (brgy) {
                        byBarangay[brgy] = (byBarangay[brgy] || 0) + 1;
                        seenBarangays[brgy] = true;
                    }
                    var fix = String(hmJoinFixDescriptions[i] || '').trim() || '(blank)';
                    byFix[fix] = (byFix[fix] || 0) + 1;
                }

                allBarangayRanks = Object.keys(byBarangay).map(function(k) { return { name: k, value: byBarangay[k] }; })
                    .sort(function(a, b) { return b.value - a.value || String(a.name).localeCompare(String(b.name)); });
                allFixRanks = Object.keys(byFix).map(function(k) { return { name: k, value: byFix[k] }; })
                    .sort(function(a, b) { return b.value - a.value || String(a.name).localeCompare(String(b.name)); });

                renderTopList(brgyBars, allBarangayRanks, 5, 'barangay');
                renderTopList(fixBars, allFixRanks, 5, 'fix');

                if (metricTotal) metricTotal.textContent = total.toLocaleString();
                if (metricRepair) metricRepair.textContent = repair.toLocaleString();
                if (metricInstall) metricInstall.textContent = install.toLocaleString();
                if (metricDays) metricDays.textContent = Object.keys(seenBarangays).length.toLocaleString();
            }

            function render() {
                var range = getSelectedMonthRange();
                if (scopeLabel) {
                    var text = monthSel.options[monthSel.selectedIndex] ? monthSel.options[monthSel.selectedIndex].text : 'All months';
                    scopeLabel.textContent = text || 'All months';
                }
                renderHeatmap(range);
                setTimeout(updateHeatAppearance, 20);
                renderDots(range);
                renderBarangayAndFixPanels(range);
            }

            /* ── Zoom-adaptive heatmap opacity / radius ── */
            var HEAT_ZOOM_LO = 9;
            var HEAT_ZOOM_HI = 16;
            function updateHeatAppearance() {
                var zoom = napMap.getZoom();
                var t = Math.max(0, Math.min(1, (zoom - HEAT_ZOOM_LO) / (HEAT_ZOOM_HI - HEAT_ZOOM_LO)));
                /* Canvas opacity: 0.98 zoomed out → 0.55 zoomed in */
                var opacity = (0.98 - t * 0.43).toFixed(3);
                /* Radius: 44px zoomed out → 22px zoomed in */
                var radius = Math.round(44 - t * 22);
                var blur   = Math.round(50 - t * 26);
                if (heatLayer._canvas) {
                    heatLayer._canvas.style.opacity = opacity;
                }
                if (heatLayer.options.radius !== radius) {
                    heatLayer.setOptions({ radius: radius, blur: blur });
                    heatLayer.redraw();
                }
            }
            napMap.on('zoomend', updateHeatAppearance);

            /* ── Native Fullscreen for the map wrapper ── */
            var SVG_EXPAND   = '<svg viewBox="0 0 24 24"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>';
            var SVG_COLLAPSE = '<svg viewBox="0 0 24 24"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="10" y1="14" x2="3" y2="21"/><line x1="21" y1="3" x2="14" y2="10"/></svg>';
            var mapWrap = document.getElementById('nap-davao-map-wrap');
            var mapEl   = document.getElementById('nap-davao-map');

            function fsIsActive() {
                return !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
            }
            function fsEnter() {
                if (mapWrap.requestFullscreen)       mapWrap.requestFullscreen();
                else if (mapWrap.webkitRequestFullscreen) mapWrap.webkitRequestFullscreen();
                else if (mapWrap.mozRequestFullScreen)    mapWrap.mozRequestFullScreen();
                else if (mapWrap.msRequestFullscreen)     mapWrap.msRequestFullscreen();
            }
            function fsExit() {
                if (document.exitFullscreen)       document.exitFullscreen();
                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                else if (document.mozCancelFullScreen)  document.mozCancelFullScreen();
                else if (document.msExitFullscreen)     document.msExitFullscreen();
            }

            var NapFsControl = L.Control.extend({
                options: { position: 'topright' },
                onAdd: function () {
                    var btn = L.DomUtil.create('button', 'nap-fs-btn');
                    btn.title = 'Toggle fullscreen';
                    btn.innerHTML = SVG_EXPAND;
                    L.DomEvent.disableClickPropagation(btn);
                    L.DomEvent.on(btn, 'click', function (e) {
                        L.DomEvent.stop(e);
                        fsIsActive() ? fsExit() : fsEnter();
                    });
                    this._btn = btn;
                    return btn;
                }
            });
            var napFsCtrl = new NapFsControl();
            napFsCtrl.addTo(napMap);

            function onFsChange() {
                var active = fsIsActive();
                if (napFsCtrl._btn) {
                    napFsCtrl._btn.innerHTML = active ? SVG_COLLAPSE : SVG_EXPAND;
                    napFsCtrl._btn.title     = active ? 'Exit fullscreen' : 'Toggle fullscreen';
                }
                /* Let the browser finish resizing before invalidating */
                setTimeout(function () {
                    mapEl.style.height = active ? '100%' : '';
                    napMap.invalidateSize({ pan: false });
                    updateHeatAppearance();
                }, 120);
            }
            document.addEventListener('fullscreenchange',       onFsChange);
            document.addEventListener('webkitfullscreenchange', onFsChange);
            document.addEventListener('mozfullscreenchange',    onFsChange);
            document.addEventListener('MSFullscreenChange',     onFsChange);

            /* Theme-aware tile switching */
            var _themeObs = new MutationObserver(function() {
                var dark = document.documentElement.getAttribute('data-theme') !== 'light';
                tileLayer.setUrl(dark ? darkTiles : lightTiles);
                labelLayer.setUrl(dark ? 'https://{s}.basemaps.cartocdn.com/dark_only_labels/{z}/{x}/{y}{r}.png'
                                       : 'https://{s}.basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}{r}.png');
            });
            _themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

            monthSel.addEventListener('change', render);
            render();

            /* ── Independent Heatmap Filter Bar init ── */
            (function initHmFilterBar() {
                var toggle   = document.getElementById('hm-indep-filter-toggle');
                var body     = document.getElementById('hm-indep-filter-body');
                var chevron  = document.getElementById('hm-filter-chevron');
                var badge    = document.getElementById('hm-filter-active-badge');
                var dotCount = document.getElementById('hm-filter-dot-count');
                if (!toggle || !body) return;

                /* Toggle collapse */
                toggle.addEventListener('click', function () {
                    var isOpen = body.style.display !== 'none';
                    body.style.display = isOpen ? 'none' : 'block';
                    chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
                    toggle.style.borderBottomColor = isOpen ? 'transparent' : '#2a2a4a';
                });

                function getCheckedValues(group) {
                    var vals = new Set();
                    document.querySelectorAll('.hm-flt-cb[data-group="' + group + '"]:checked').forEach(function (cb) {
                        vals.add(cb.value.trim().toUpperCase());
                    });
                    return vals;
                }
                function getTotalCount(group) {
                    return document.querySelectorAll('.hm-flt-cb[data-group="' + group + '"]').length;
                }

                function applyHmFilter() {
                    var terrVals = getCheckedValues('territory');
                    var skVals   = getCheckedValues('skillset');
                    var stVals   = getCheckedValues('status');

                    /* Empty set = all pass (no restriction) */
                    hmFltTerritories = terrVals.size < getTotalCount('territory') ? terrVals : new Set();
                    hmFltSkillsets   = skVals.size   < getTotalCount('skillset')  ? skVals   : new Set();
                    hmFltStatuses    = stVals.size   < getTotalCount('status')    ? stVals   : new Set();

                    var excluded = (getTotalCount('territory') - terrVals.size) +
                                   (getTotalCount('skillset')  - skVals.size)   +
                                   (getTotalCount('status')    - stVals.size);

                    if (badge) {
                        if (excluded > 0) {
                            badge.textContent = excluded + ' excluded';
                            badge.classList.remove('hidden');
                        } else {
                            badge.classList.add('hidden');
                        }
                    }

                    render();

                    /* Update dot count label */
                    if (dotCount && napDots.length > 0) {
                        var visible = 0;
                        for (var i = 0; i < napDots.length; i++) {
                            if (passDotFilter(i)) visible++;
                        }
                        dotCount.textContent = visible.toLocaleString() + ' of ' + napDots.length.toLocaleString() + ' NAPs shown';
                    }

                    /* Restore Apply button to default state */
                    if (applyBtn) {
                        applyBtn.style.background = '#6366f1';
                        applyBtn.style.opacity = '1';
                    }
                }

                /* Mark pending changes when a checkbox is toggled (no apply yet) */
                document.querySelectorAll('.hm-flt-cb').forEach(function (cb) {
                    cb.addEventListener('change', function () {
                        if (applyBtn) {
                            applyBtn.style.background = '#a855f7';
                        }
                    });
                });

                /* Select All / None — only toggle checkboxes, mark pending */
                document.querySelectorAll('.hm-flt-sel-all').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var group = this.dataset.target;
                        document.querySelectorAll('.hm-flt-cb[data-group="' + group + '"]').forEach(function (cb) { cb.checked = true; });
                        if (applyBtn) applyBtn.style.background = '#a855f7';
                    });
                });
                document.querySelectorAll('.hm-flt-sel-none').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var group = this.dataset.target;
                        document.querySelectorAll('.hm-flt-cb[data-group="' + group + '"]').forEach(function (cb) { cb.checked = false; });
                        if (applyBtn) applyBtn.style.background = '#a855f7';
                    });
                });

                /* Apply Filters button */
                var applyBtn = document.getElementById('hm-filter-apply-btn');
                if (applyBtn) {
                    applyBtn.addEventListener('click', applyHmFilter);
                }

                /* Reset All — restores default selections and immediately applies */
                var resetBtn = document.getElementById('hm-filter-reset-btn');
                if (resetBtn) {
                    resetBtn.addEventListener('click', function () {
                        document.querySelectorAll('.hm-flt-cb').forEach(function (cb) {
                            var group = cb.dataset.group;
                            var val   = (cb.value || '').toLowerCase();
                            if (group === 'skillset') {
                                cb.checked = val.indexOf('install') !== -1 || val.indexOf('repair') !== -1;
                            } else if (group === 'status') {
                                cb.checked = val.indexOf('cancelled') !== -1 || val.indexOf('completed') !== -1;
                            } else {
                                cb.checked = true; // territory: all selected
                            }
                        });
                        applyHmFilter();
                    });
                }

                /* Initial state (all selected, no restriction) */
                applyHmFilter();
            })();

            /* Invalidate map size at multiple checkpoints to handle lazy layout */
            function _inv() { try { napMap.invalidateSize({ pan: false }); } catch(e) {} }
            _inv();
            setTimeout(_inv, 100);
            setTimeout(_inv, 400);
            setTimeout(_inv, 900);
            if (document.readyState !== 'complete') {
                window.addEventListener('load', _inv);
            }
        })();

        var skillsetData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SkillsetDistribution));
        var sortedSkillset = Object.entries(skillsetData).sort(function(a, b) { return b[1] - a[1]; });
        new Chart(document.getElementById('skillsetChart'), {
            type: 'bar',
            data: {
                labels: sortedSkillset.map(function(e) { return e[0]; }),
                datasets: [{
                    data: sortedSkillset.map(function(e) { return e[1]; }),
                    backgroundColor: chartColors,
                    borderRadius: 4,
                    barThickness: 18
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: gridColor }, ticks: { font: { size: 10 } } },
                    y: { grid: { display: false }, ticks: { font: { size: 10, family: "'JetBrains Mono', monospace" } } }
                }
            }
        });

        new Chart(document.getElementById('slotChart'), {
            type: 'doughnut',
            data: {
                labels: ['AM Slot', 'PM Slot'],
                datasets: [{
                    data: [@Model.AmSlotCount, @Model.PmSlotCount],
                    backgroundColor: ['#3b82f6', '#f97316'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { padding: 16, usePointStyle: true, pointStyleWidth: 10, font: { size: 12 } } }
                }
            }
        });

        @if (Model.ActiveDashboardView == "status")
        {
            <text>
            new Chart(document.getElementById('complianceChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Pass', 'Fail', 'N/A'],
                    datasets: [{
                        data: [@Model.CompliancePassCount, @Model.ComplianceFailCount, @Model.ComplianceNaCount],
                        backgroundColor: ['#22c55e', '#ef4444', '#64748b'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { padding: 16, usePointStyle: true, pointStyleWidth: 10, font: { size: 12 } } }
                    }
                }
            });
            </text>
        }

        @if (Model.DelayedCount > 0)
        {
            <text>
            new Chart(document.getElementById('delayLapseChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Delayed (not lapsed)', 'Lapsed'],
                    datasets: [{
                        data: [@(Model.DelayedCount - Model.LapsedCount), @Model.LapsedCount],
                        backgroundColor: ['#ef4444', '#f59e0b'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { padding: 16, usePointStyle: true, pointStyleWidth: 10, font: { size: 12 } } }
                    }
                }
            });
            </text>
        }

        var tableColumns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(previewTableCols));
        var sortableColumns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(previewSortableCols.ToDictionary(c => c, _ => true)));
        var allRows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PreviewRows));
        var useComplianceRowStyle = @(Model.ActiveDashboardView == "status" ? "true" : "false");
        var rowsPerPage = 20;
        var currentPage = 1;
        var totalPages = Math.max(1, Math.ceil(allRows.length / rowsPerPage));
        var sortColumn = null;
        var sortDirection = null;

        function parseSortDate(val) {
            if (!val) return 0;
            var d = new Date(val);
            return isNaN(d.getTime()) ? 0 : d.getTime();
        }

        function sortTable(col) {
            if (sortColumn === col) {
                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumn = col;
                sortDirection = 'asc';
            }

            allRows.sort(function(a, b) {
                var va = parseSortDate(a[col]);
