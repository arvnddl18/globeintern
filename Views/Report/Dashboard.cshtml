@if (Model.IsReadOnly)
{
    <div class="mb-6 fade-in rounded-xl px-4 py-3 flex items-center gap-2 text-sm font-medium"
         style="background: rgba(30, 41, 59, 0.5); border: 1px solid #3a3a5a; color: #a5b4fc;">
        <i data-lucide="lock" style="width:16px; height:16px; flex-shrink:0;"></i>
        <span>Historical report — the source file was removed by storage policy. Filters are locked for archived snapshots.</span>
    </div>
}

@if (Model.ReportHistory.Count > 0)
{
    var historyCount = Model.ReportHistory.Count;
    var minHistoryDate = Model.ReportHistory.Min(h => h.UploadedUtc.Date);
    var maxHistoryDate = Model.ReportHistory.Max(h => h.UploadedUtc.Date);
    <section id="report-history-section"
             class="mb-4 fade-in rounded-xl p-3 sm:p-3.5"
             style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;"
             data-total-uploads="@historyCount"
             data-min-date="@minHistoryDate.ToString("yyyy-MM-dd")"
             data-max-date="@maxHistoryDate.ToString("yyyy-MM-dd")">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 mb-2">
            <h2 class="text-xs font-semibold" style="color: #c8c8e0;">Report history</h2>
            <p id="report-history-summary" class="text-[10px] sm:text-xs leading-tight m-0" style="color: #6a6a8e;">
                <span class="tabular-nums">@historyCount</span> upload@(historyCount == 1 ? "" : "s") · UTC · current highlighted
            </p>
        </div>
        <div class="flex flex-col gap-2 mb-2">
            <div class="flex flex-wrap items-center gap-1.5">
                <span class="text-[10px] font-medium flex-shrink-0" style="color: #8a8ab0;">Range</span>
                <button type="button" class="report-history-preset report-history-preset-active" data-rh-preset="all">All</button>
                <button type="button" class="report-history-preset" data-rh-preset="today">Today</button>
                <button type="button" class="report-history-preset" data-rh-preset="7d">7 days</button>
                <button type="button" class="report-history-preset" data-rh-preset="30d">30 days</button>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <label for="report-history-date" class="text-[10px] font-medium flex-shrink-0" style="color: #8a8ab0;">Day (UTC)</label>
                <input type="date"
                       id="report-history-date"
                       min="@minHistoryDate.ToString("yyyy-MM-dd")"
                       max="@maxHistoryDate.ToString("yyyy-MM-dd")"
                       class="flex-1 min-w-[9rem] max-w-[11rem]" />
                <button type="button" id="report-history-date-apply" class="flex-shrink-0">Apply</button>
                <button type="button" id="report-history-date-clear" class="flex-shrink-0">Clear</button>
            </div>
        </div>
        <div class="report-history-scroll space-y-2 pr-0.5">
            <div id="report-history-groups" class="space-y-2">
            @foreach (var dayGroup in Model.ReportHistory.GroupBy(h => h.UploadedUtc.Date).OrderByDescending(g => g.Key))
            {
                var todayUtc = DateTime.UtcNow.Date;
                var label = dayGroup.Key == todayUtc
                    ? "Today"
                    : dayGroup.Key == todayUtc.AddDays(-1)
                        ? "Yesterday"
                        : dayGroup.Key.ToString("yyyy-MM-dd");
                <div class="report-history-day-group" data-upload-date="@dayGroup.Key.ToString("yyyy-MM-dd")">
                    <p class="text-[10px] font-medium mb-1 pl-0.5" style="color: #8a8ab0;">@label</p>
                    <div class="grid grid-cols-1 min-[400px]:grid-cols-2 lg:grid-cols-3 gap-1.5">
                        @foreach (var h in dayGroup.OrderByDescending(x => x.UploadedUtc))
                        {
                            var isCurrent = string.Equals(h.Token, Model.ReportToken, StringComparison.Ordinal);
                            <a href="@Url.Action("Dashboard", "Report", new { token = h.Token })"
                               class="report-history-item min-w-0 @(isCurrent ? "report-history-item-current" : "")">
                                <span class="font-mono truncate block">@(string.IsNullOrEmpty(h.OriginalFileName) ? h.Token[..12] + "…" : h.OriginalFileName)</span>
                                <span class="report-history-meta">
                                    @(h.CsvSourceKind == SlotAd_Globe.Models.CsvSourceKind.AllStatus ? "All Status" : "All Pending") · @h.UploadedUtc.ToString("HH:mm") UTC@(h.IsArchived ? " · Archived" : "")
                                </span>
                            </a>
                        }
                    </div>
                </div>
            }
            </div>
            <p id="report-history-empty" class="hidden text-[10px] text-center py-3 rounded-lg m-0" style="color: #8a8ab0; background: rgba(255,255,255,0.03); border: 1px dashed #2a2a4a;">
                No uploads in this range. Try <strong style="color: #a5b4fc;">All</strong> or another date.
            </p>
        </div>
    </section>
}

<section class="mb-6 slide-up" style="animation-delay: 0.05s;">
    <div class="rounded-xl p-4"
         style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex flex-wrap gap-2 mb-4">
            @{
                var pendingTabActive = Model.ActiveDashboardView != "status";
                var statusTabActive = Model.ActiveDashboardView == "status";
                var latestPendingToken = Model.ReportHistory
                    .Where(h => h.CsvSourceKind == SlotAd_Globe.Models.CsvSourceKind.Pending)
                    .OrderByDescending(h => h.UploadedUtc)
                    .Select(h => h.Token)
                    .FirstOrDefault();
                var latestStatusToken = Model.ReportHistory
                    .Where(h => h.CsvSourceKind == SlotAd_Globe.Models.CsvSourceKind.AllStatus)
                    .OrderByDescending(h => h.UploadedUtc)
                    .Select(h => h.Token)
                    .FirstOrDefault();
                var pendingTargetToken = string.IsNullOrWhiteSpace(latestPendingToken) ? Model.ReportToken : latestPendingToken;
                var statusTargetToken = string.IsNullOrWhiteSpace(latestStatusToken) ? Model.ReportToken : latestStatusToken;
            }
            <a href="@Url.Action("Dashboard", "Report", new { token = pendingTargetToken, view = "pending" })"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition-colors"
               style="@(pendingTabActive ? "background: rgba(99, 102, 241, 0.35); color: #f0f0f8; border: 1px solid #6366f1;" : "color: #8a8ab0; background: rgba(255,255,255,0.04); border: 1px solid #2a2a4a;")">
                <i data-lucide="clipboard-list" style="width:14px; height:14px;"></i> All Pending
            </a>
            <a href="@Url.Action("Dashboard", "Report", new { token = statusTargetToken, view = "status" })"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition-colors"
               style="@(statusTabActive ? "background: rgba(99, 102, 241, 0.35); color: #f0f0f8; border: 1px solid #6366f1;" : "color: #8a8ab0; background: rgba(255,255,255,0.04); border: 1px solid #2a2a4a;")">
                <i data-lucide="check-circle-2" style="width:14px; height:14px;"></i> All Status
            </a>
            <span class="self-center text-xs font-mono px-2 py-1 rounded-md" style="background: rgba(255,255,255,0.04); color: #6a6a8e;">
                File: @(Model.CsvSourceKind == SlotAd_Globe.Models.CsvSourceKind.AllStatus ? "All Status" : "All Pending")
            </span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0"
                     style="background: rgba(99, 102, 241, 0.12);">
                    <i data-lucide="bar-chart-3" style="width:18px; height:18px; color: #6366f1;"></i>
                </div>
                <div>
                    <p class="text-sm font-semibold" style="color: #e0e0f0;">
                        Dashboard Results
                    </p>
                    <p class="text-xs" style="color: #6a6a8e;">Date range: @Model.DateRangeDisplay</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a asp-action="Upload" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors"
                   style="color: #a5b4fc; background: rgba(99, 102, 241, 0.1);">
                    <i data-lucide="arrow-left" style="width:12px; height:12px;"></i> New Upload
                </a>
            </div>
        </div>
        <div class="w-full mt-4 pt-4" style="border-top: 1px solid #2a2a4a;">
            <p class="text-xs mb-2" style="color: #8a8ab0;">
                Private report link — bookmark or copy to reopen this dashboard (same filters) on another device. Data updates only when you upload a new file.
            </p>
            <div class="flex flex-wrap gap-2 items-stretch sm:items-center">
                <input type="text" readonly id="report-magic-link"
                       class="flex-1 min-w-[12rem] rounded-lg px-3 py-2 text-xs font-mono"
                       style="background: #0d0d1a; border: 1px solid #2a2a4a; color: #c8c8e0;"
                       value="@(Url.Action("Dashboard", "Report", new { token = Model.ReportToken, view = Model.ActiveDashboardView }, Context.Request.Scheme) ?? "")" />
                <button type="button" id="copy-report-magic-link"
                        class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium transition-colors cursor-pointer"
                        style="color: #f0f0f8; background: rgba(99, 102, 241, 0.25); border: 1px solid #6366f1;">
                    <i data-lucide="link" style="width:14px; height:14px;"></i> Copy link
                </button>
            </div>
        </div>
    </div>
</section>

@if (!Model.IsReadOnly)
{
<div id="filter-modal-backdrop" class="fixed inset-0 z-40 hidden" style="background: rgba(0,0,0,0.7);">
    <div class="fixed inset-0 flex items-start justify-center overflow-y-auto py-8 px-4 z-50">
        <div id="filter-modal" class="w-full max-w-5xl rounded-2xl shadow-2xl"
             style="background: #12122a; border: 1px solid #2a2a4a;">
            <div class="flex items-center justify-between px-6 py-4" style="border-bottom: 1px solid #2a2a4a;">
                <div class="flex items-center gap-2">
                    <i data-lucide="sliders-horizontal" style="width:16px; height:16px; color: #6366f1;"></i>
                    <span class="text-base font-semibold" style="color: #f0f0f8;">Change Filters</span>
                </div>
                <button type="button" id="close-filter-modal"
                        class="w-8 h-8 rounded-lg flex items-center justify-center cursor-pointer transition-colors"
                        style="color: #6a6a8e; background: rgba(255,255,255,0.04);"
                        onmouseover="this.style.background='rgba(255,255,255,0.08)'"
                        onmouseout="this.style.background='rgba(255,255,255,0.04)'">
                    <i data-lucide="x" style="width:16px; height:16px;"></i>
                </button>
            </div>

            <form asp-action="Dashboard" asp-controller="Report" method="post" id="modal-filter-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReportToken" value="@Model.ReportToken" />
                <input type="hidden" name="ActiveDashboardView" value="@Model.ActiveDashboardView" />

                <div class="px-6 py-5 space-y-5" style="max-height: 70vh; overflow-y: auto;">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <i data-lucide="calendar-range" style="width:13px; height:13px; color: #6366f1;"></i>
                            <span class="text-sm font-semibold" style="color: #c8c8e0;">Date Filter</span>
                        </div>
                        <div class="flex flex-wrap gap-3 mb-3">
                            <label class="flex items-center gap-2 px-3 py-2 rounded-lg cursor-pointer"
                                   style="background: rgba(99,102,241,0.12); border: 1px solid #3a3a5a;">
                                <input type="radio" name="DateFilterMode" value="all"
                                       @(Model.DateFilterMode == "all" ? "checked" : "")
                                       onchange="toggleModalDateInputs()" style="accent-color:#6366f1;" />
                                <span class="text-sm" style="color: #c8c8e0;">All Dates</span>
                            </label>
                            <label class="flex items-center gap-2 px-3 py-2 rounded-lg cursor-pointer"
                                   style="background: rgba(99,102,241,0.12); border: 1px solid #3a3a5a;">
                                <input type="radio" name="DateFilterMode" value="single"
                                       @(Model.DateFilterMode == "single" ? "checked" : "")
                                       onchange="toggleModalDateInputs()" style="accent-color:#6366f1;" />
                                <span class="text-sm" style="color: #c8c8e0;">Specific Date</span>
                            </label>
                            <label class="flex items-center gap-2 px-3 py-2 rounded-lg cursor-pointer"
                                   style="background: rgba(99,102,241,0.12); border: 1px solid #3a3a5a;">
                                <input type="radio" name="DateFilterMode" value="range"
                                       @(Model.DateFilterMode == "range" ? "checked" : "")
                                       onchange="toggleModalDateInputs()" style="accent-color:#6366f1;" />
                                <span class="text-sm" style="color: #c8c8e0;">Date Range</span>
                            </label>
                        </div>
                        <div id="modal-single-date" class="@(Model.DateFilterMode == "single" ? "" : "hidden")">
                            <select name="SelectedDate"
                                    class="w-full sm:w-64 rounded-lg px-4 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-accent"
                                    style="background: #1a1a32; border: 1px solid #2a2a4a; color: #e0e0f0;">
                                <option value="">-- Choose a date --</option>
                                @foreach (var d in Model.AvailableDates)
                                {
                                    if (d == Model.SelectedDate)
                                    {
                                        <option value="@d" selected>@d</option>
                                    }
                                    else
                                    {
                                        <option value="@d">@d</option>
                                    }
                                }
                            </select>
                        </div>
                        <div id="modal-range-date" class="@(Model.DateFilterMode == "range" ? "" : "hidden")">
                            <div class="flex flex-wrap gap-4">
                                <div>
                                    <label class="text-xs font-medium block mb-1.5" style="color: #8a8ab0;">From</label>
                                    <input type="date" name="DateRangeStart" value="@Model.DateRangeStart"
                                           class="rounded-lg px-4 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-accent"
                                           style="background: #1a1a32; border: 1px solid #2a2a4a; color: #e0e0f0; color-scheme: dark;" />
                                </div>
                                <div class="flex items-end pb-2.5">
                                    <span class="text-sm" style="color: #5a5a7e;">to</span>
                                </div>
                                <div>
                                    <label class="text-xs font-medium block mb-1.5" style="color: #8a8ab0;">To</label>
                                    <input type="date" name="DateRangeEnd" value="@Model.DateRangeEnd"
                                           class="rounded-lg px-4 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-accent"
                                           style="background: #1a1a32; border: 1px solid #2a2a4a; color: #e0e0f0; color-scheme: dark;" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @{
                        var modalPanelGridClass = Model.CsvSourceKind == SlotAd_Globe.Models.CsvSourceKind.AllStatus
                            ? "grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"
                            : "grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4";
                    }
                    <div class="@modalPanelGridClass">
                        @if (Model.CsvSourceKind == SlotAd_Globe.Models.CsvSourceKind.AllStatus)
                        {
                            foreach (var t in Model.SelectedTerritories ?? [])
                            {
                                <input type="hidden" name="SelectedTerritories" value="@t" />
                            }
                        }
                        else
                        {
                            ModalFilterPanel("Territory", "SelectedTerritories", Model.AvailableTerritories, Model.SelectedTerritories);
                        }
                        @{ ModalFilterPanel("Status", "SelectedStatuses", Model.AvailableStatuses, Model.SelectedStatuses); }
                        @{ ModalFilterPanel("SubStatus", "SelectedSubStatuses", Model.AvailableSubStatuses, Model.SelectedSubStatuses); }
                        @{ ModalFilterPanel("Skillset", "SelectedSkillsets", Model.AvailableSkillsets, Model.SelectedSkillsets); }
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 px-6 py-4" style="border-top: 1px solid #2a2a4a;">
                    <button type="button" id="cancel-filter-modal"
                            class="px-5 py-2.5 rounded-xl text-sm font-medium cursor-pointer transition-colors"
                            style="color: #8a8ab0; background: rgba(255,255,255,0.04); border: 1px solid #2a2a4a;">
                        Cancel
                    </button>
                    <button type="submit" id="apply-filters-btn"
                            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold cursor-pointer transition-all duration-200"
                            style="background: #6366f1; color: #fff;">
                        <i data-lucide="check" style="width:14px; height:14px;"></i>
                        <span id="apply-filters-text">Apply Filters</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
}

@functions {
    void ModalFilterPanel(string label, string fieldName, List<string> options, List<string> selected)
    {
        var selectedJson = System.Text.Json.JsonSerializer.Serialize(selected ?? []);
        var optionsJson = System.Text.Json.JsonSerializer.Serialize(options);
        <div class="modal-filter-panel rounded-xl overflow-hidden flex flex-col"
             data-field="@fieldName" data-options="@optionsJson" data-selected="@selectedJson"
             style="background: rgba(22, 22, 42, 0.6); border: 1px solid #2a2a4a; min-height: 260px;">
            <div class="flex items-center justify-between px-3 py-2.5" style="border-bottom: 1px solid #2a2a4a;">
                <div class="flex items-center gap-1.5">
                    <i data-lucide="filter" style="width:12px; height:12px; color: #6366f1;"></i>
                    <span class="text-xs font-semibold" style="color: #c8c8e0;">@label</span>
                </div>
                <div class="flex gap-1">
                    <button type="button"
                            class="modal-select-toggle px-2 py-0.5 rounded text-xs font-medium cursor-pointer"
                            data-target="@fieldName" data-action="all"
                            style="color: #a5b4fc; background: rgba(99,102,241,0.1);">
                        All
                    </button>
                    <button type="button"
                            class="modal-select-toggle px-2 py-0.5 rounded text-xs font-medium cursor-pointer"
                            data-target="@fieldName" data-action="none"
                            style="color: #8a8ab0; background: rgba(255,255,255,0.04);">
                        Clear
                    </button>
                </div>
            </div>
            @if (options.Count > 20)
            {
                <div class="px-2 pt-2">
                    <input type="text" placeholder="Search @label..."
                           class="modal-panel-search w-full rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-accent"
                           data-field="@fieldName"
                           style="background: #1a1a32; border: 1px solid #2a2a4a; color: #e0e0f0;" />
                </div>
            }
            <div class="filter-scroll p-2 space-y-0.5 flex-1" data-list="@fieldName" style="max-height: 220px; overflow-y: auto;"></div>
            <div class="px-3 py-1.5 text-center" style="border-top: 1px solid #2a2a4a;">
                <span class="text-xs font-mono" style="color: #5a5a7e;">@options.Count value(s)</span>
            </div>
        </div>
    }
}

<!-- ═══════════════════════════════════════════════════════════════════════════
     SLOT ADHERENCE REPORT CONTAINER
     ═══════════════════════════════════════════════════════════════════════════ -->
<div id="slot-adherence-report" class="mb-10 rounded-2xl p-6" style="background: rgba(10,10,25,0.45); border: 1px solid #2a2a4a;">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4" style="border-bottom: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2">
            <i data-lucide="bar-chart-2" style="width:16px; height:16px; color: #6366f1;"></i>
            <span class="text-base font-semibold tracking-wide" style="color: #c8c8e0;">Slot Adherence Report</span>
        </div>
        @if (!Model.IsReadOnly)
        {
        <button type="button" id="open-filter-modal"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer"
                style="color: #f0f0f8; background: rgba(99, 102, 241, 0.25); border: 1px solid #6366f1;">
            <i data-lucide="sliders-horizontal" style="width:12px; height:12px;"></i> Change Filters
        </button>
        }
        else
        {
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium"
              style="color: #8a8ab0; background: rgba(255,255,255,0.04); border: 1px solid #2a2a4a;">
            <i data-lucide="lock" style="width:12px; height:12px;"></i> Filters locked
        </span>
        }
    </div>

<section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-8 fade-in" style="animation-delay: 0.1s;">
    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(99, 102, 241, 0.12);">
                <i data-lucide="calendar-check" style="width:15px; height:15px; color: #6366f1;"></i>
            </div>
            <span class="text-xs font-medium" style="color: #6a6a8e;">Total Appointments</span>
        </div>
        <p class="text-3xl font-bold font-mono" style="color: #f0f0f8;">@Model.TotalAppointments.ToString("N0")</p>
    </div>
    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(34, 197, 94, 0.12);">
                <i data-lucide="map-pin" style="width:15px; height:15px; color: #22c55e;"></i>
            </div>
            <span class="text-xs font-medium" style="color: #6a6a8e;">Unique Territories</span>
        </div>
        <p class="text-3xl font-bold font-mono" style="color: #f0f0f8;">@Model.UniqueTerritoriesCount</p>
    </div>
    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(249, 115, 22, 0.12);">
                <i data-lucide="wrench" style="width:15px; height:15px; color: #f97316;"></i>
            </div>
            <span class="text-xs font-medium" style="color: #6a6a8e;">Unique Skillsets</span>
        </div>
        <p class="text-3xl font-bold font-mono" style="color: #f0f0f8;">@Model.UniqueSkillsetsCount</p>
    </div>
    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(236, 72, 153, 0.12);">
                <i data-lucide="clock" style="width:15px; height:15px; color: #ec4899;"></i>
            </div>
            <span class="text-xs font-medium" style="color: #6a6a8e;">Date Range</span>
        </div>
        <p class="text-sm font-semibold font-mono leading-tight" style="color: #f0f0f8;">@Model.DateRangeDisplay</p>
    </div>
</section>

@if (Model.ActiveDashboardView == "status")
{
    <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-8 fade-in" style="animation-delay: 0.12s;">
        <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #22c55e; border-left: 4px solid #22c55e;">
            <p class="text-xs font-medium mb-1" style="color: #6a6a8e;">Pass</p>
            <p class="text-2xl font-bold font-mono" style="color: #22c55e;">@Model.CompliancePassCount.ToString("N0")</p>
        </div>
        <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #ef4444; border-left: 4px solid #ef4444;">
            <p class="text-xs font-medium mb-1" style="color: #6a6a8e;">Fail</p>
            <p class="text-2xl font-bold font-mono" style="color: #ef4444;">@Model.ComplianceFailCount.ToString("N0")</p>
        </div>
        <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #6a6a8e; border-left: 4px solid #6a6a8e;">
            <p class="text-xs font-medium mb-1" style="color: #6a6a8e;">N/A</p>
            <p class="text-2xl font-bold font-mono" style="color: #a1a1c7;">@Model.ComplianceNaCount.ToString("N0")</p>
        </div>
        <div class="rounded-xl p-5 lg:col-span-2" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #6366f1; border-left: 4px solid #6366f1;">
            <p class="text-xs font-medium mb-1" style="color: #6a6a8e;">Pass rate</p>
            <p class="text-2xl font-bold font-mono" style="color: #a5b4fc;">@passRatePct.ToString("F1")%</p>
        </div>
    </section>
    @if (Model.ComplianceFailReasons.Count > 0)
    {
        <section class="mb-8 fade-in rounded-xl p-4" style="animation-delay: 0.13s; background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
            <p class="text-xs font-semibold mb-2" style="color: #8a8ab0;">Fail breakdown</p>
            <div class="flex flex-wrap gap-2">
                @foreach (var kv in Model.ComplianceFailReasons.OrderByDescending(x => x.Value))
                {
                    <span class="text-xs font-mono px-2 py-1 rounded-md" style="background: rgba(239, 68, 68, 0.12); color: #fca5a5;">@kv.Key: @kv.Value.ToString("N0")</span>
                }
            </div>
        </section>
    }
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8 fade-in" style="animation-delay: 0.14s;">
        <div class="rounded-xl p-5 lg:col-span-2" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
            <div class="flex items-center gap-2 mb-4">
                <i data-lucide="shield-check" style="width:14px; height:14px; color: #22c55e;"></i>
                <span class="text-sm font-semibold" style="color: #c8c8e0;">Compliance (Pass / Fail / N/A)</span>
            </div>
            <div style="position: relative; height: 280px;">
                <canvas id="complianceChart"></canvas>
            </div>
        </div>
    </section>
}

@if (Model.DelayedCount > 0)
{
    <section class="grid grid-cols-2 lg:grid-cols-3 gap-3 mb-8 fade-in" style="animation-delay: 0.13s;">
        <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #ef4444; border-left: 4px solid #ef4444;">
            <p class="text-xs font-medium mb-1" style="color: #6a6a8e;">Delayed</p>
            <p class="text-2xl font-bold font-mono" style="color: #ef4444;">@Model.DelayedCount.ToString("N0")</p>
        </div>
        <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #f59e0b; border-left: 4px solid #f59e0b;">
            <p class="text-xs font-medium mb-1" style="color: #6a6a8e;">Lapsed</p>
            <p class="text-2xl font-bold font-mono" style="color: #f59e0b;">@Model.LapsedCount.ToString("N0")</p>
        </div>
        <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #6366f1; border-left: 4px solid #6366f1;">
            <p class="text-xs font-medium mb-1" style="color: #6a6a8e;">Lapse Rate</p>
            <p class="text-2xl font-bold font-mono" style="color: #a5b4fc;">
                @(Model.DelayedCount > 0 ? ((double)Model.LapsedCount / Model.DelayedCount * 100).ToString("F1") : "0")%
            </p>
        </div>
    </section>
}

<section class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8 fade-in" style="animation-delay: 0.15s;">
    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-4">
            <i data-lucide="pie-chart" style="width:14px; height:14px; color: #6366f1;"></i>
            <span class="text-sm font-semibold" style="color: #c8c8e0;">Status Distribution</span>
        </div>
        <div style="position: relative; height: 280px;">
            <canvas id="statusChart"></canvas>
        </div>
    </div>

    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-4">
            <i data-lucide="map" style="width:14px; height:14px; color: #22c55e;"></i>
            <span class="text-sm font-semibold" style="color: #c8c8e0;">Territory Breakdown</span>
        </div>
        <div style="position: relative; height: 280px;">
            <canvas id="territoryChart"></canvas>
        </div>
    </div>

    <div class="rounded-xl p-5 lg:col-span-2" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-4">
            <i data-lucide="trending-up" style="width:14px; height:14px; color: #a5b4fc;"></i>
            <span class="text-sm font-semibold" style="color: #c8c8e0;">Appointments by Date</span>
        </div>
        <div style="position: relative; height: 280px;">
            <canvas id="dateChart"></canvas>
        </div>
    </div>

    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-4">
            <i data-lucide="wrench" style="width:14px; height:14px; color: #f97316;"></i>
            <span class="text-sm font-semibold" style="color: #c8c8e0;">Skillset Distribution</span>
        </div>
        <div style="position: relative; height: 280px;">
            <canvas id="skillsetChart"></canvas>
        </div>
    </div>

    <div class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center gap-2 mb-4">
            <i data-lucide="clock" style="width:14px; height:14px; color: #ec4899;"></i>
            <span class="text-sm font-semibold" style="color: #c8c8e0;">AM vs PM Slots</span>
        </div>
        <div style="position: relative; height: 280px;">
            <canvas id="slotChart"></canvas>
        </div>
    </div>

    @if (Model.DelayedCount > 0)
    {
        <div class="rounded-xl p-5 lg:col-span-2" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
            <div class="flex items-center gap-2 mb-4">
                <i data-lucide="alert-triangle" style="width:14px; height:14px; color: #ef4444;"></i>
                <span class="text-sm font-semibold" style="color: #c8c8e0;">Delay vs Lapse Breakdown</span>
            </div>
            <div class="flex items-center justify-center" style="height: 260px;">
                <div style="width: 260px; height: 260px;">
                    <canvas id="delayLapseChart"></canvas>
                </div>
            </div>
        </div>
    }
</section>

@if (Model.ActiveDashboardView == "status")
{
    <section class="mb-8 fade-in" style="animation-delay: 0.17s;">
        <div id="slot-adherence-summary-report" class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.9); border: 1px solid #2a2a4a;">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div>
                    <p class="text-sm font-semibold" style="color: #e0e7ff;">Scheduled volume vs slot adherence (Pass)</p>
                    <p class="text-xs mt-1" style="color: #9aa4c7;">
                        Scheduled = appointment rows per period; Pass = slot adherence Pass count per period.
                    </p>
                </div>
                <div class="inline-flex items-center gap-1 rounded-lg p-1" style="background: rgba(15, 15, 30, 0.55); border: 1px solid #2a2a4a;">
                    <button type="button" class="slot-adh-period-btn slot-adh-period-btn-active px-3 py-1.5 rounded-md text-xs font-semibold cursor-pointer" data-period="day">Day</button>
                    <button type="button" class="slot-adh-period-btn px-3 py-1.5 rounded-md text-xs font-semibold cursor-pointer" data-period="week">Week</button>
                    <button type="button" class="slot-adh-period-btn px-3 py-1.5 rounded-md text-xs font-semibold cursor-pointer" data-period="month">Month</button>
                </div>
            </div>

            <div class="slot-adh-card rounded-xl p-4 mb-4" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
                <div style="position: relative; height: 280px;">
                    <canvas id="slotAdherenceSummaryChart"></canvas>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="slot-adh-card rounded-xl overflow-hidden" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
                    <div class="px-4 py-3" style="border-bottom: 1px solid #2a2a4a;">
                        <p class="text-sm font-semibold" style="color: #c8c8e0;">Slot adherence by territory</p>
                        <p class="text-xs mt-1" style="color: #8a8ab0;">Rate = Pass ÷ (Pass + Fail) per territory. N/A excluded.</p>
                    </div>
                    <div class="slot-adh-table-head grid grid-cols-[1fr_6rem_6rem_6rem] gap-2 px-4 py-2 text-xs font-semibold uppercase tracking-wide" style="color: #c7d2fe; background: rgba(99, 102, 241, 0.14); border-bottom: 1px solid #2a2a4a;">
                        <span>Territory</span>
                        <span class="text-right">Pass</span>
                        <span class="text-right">Fail</span>
                        <span class="text-right">Rate</span>
                    </div>
                    <div id="slot-adherence-territory-rows"></div>
                </div>

                <div class="slot-adh-card rounded-xl overflow-hidden" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
                    <div class="px-4 py-3" style="border-bottom: 1px solid #2a2a4a;">
                        <p class="text-sm font-semibold" style="color: #c8c8e0;">Slot adherence by skillset</p>
                        <p class="text-xs mt-1" style="color: #8a8ab0;">Rate = Pass ÷ (Pass + Fail) per skillset. N/A excluded.</p>
                    </div>
                    <div class="slot-adh-table-head grid grid-cols-[1fr_6rem_6rem_6rem] gap-2 px-4 py-2 text-xs font-semibold uppercase tracking-wide" style="color: #c7d2fe; background: rgba(99, 102, 241, 0.14); border-bottom: 1px solid #2a2a4a;">
                        <span>Skillset</span>
                        <span class="text-right">Pass</span>
                        <span class="text-right">Fail</span>
                        <span class="text-right">Rate</span>
                    </div>
                    <div id="slot-adherence-skillset-rows"></div>
                </div>
            </div>
        </div>
    </section>
}

<section class="mb-8 fade-in" style="animation-delay: 0.18s;">
    @{
        var netDelayedCount = Math.Max(0, Model.DelayedCount - Model.LapsedCount);
        var selectedTerritories = Model.SelectedTerritories ?? [];
        var territoryItems = selectedTerritories.Count > 0
            ? selectedTerritories
            : Model.TerritoryDistribution.Keys.OrderBy(k => k, StringComparer.OrdinalIgnoreCase).Take(8).ToList();
        var showingSelectedTerritoriesOnly = selectedTerritories.Count > 0;
    }
    <div id="kpi-count-report" class="rounded-xl p-5" style="background: rgba(22, 22, 42, 0.95); border: 2px solid #6366f1; box-shadow: 0 0 0 1px rgba(99, 102, 241, 0.25) inset;">
        <div class="flex items-center gap-2 mb-3">
            <i data-lucide="clipboard-list" style="width:16px; height:16px; color: #a5b4fc;"></i>
            <span class="text-sm font-semibold tracking-wide uppercase kpi-title" style="color: #e0e7ff;">KPI Field Counts Report</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-md" style="background: rgba(99, 102, 241, 0.2); color: #c7d2fe;">
                @(Model.ActiveDashboardView == "status" ? "All Status View" : "All Pending View")
            </span>
        </div>
        <p class="text-xs mb-4 kpi-subtitle" style="color: #9aa4c7;">
            Sticky-note style list based on current selected filters.
        </p>
        @if (Model.ActiveDashboardView == "status")
        {
            var totalBase = Math.Max(1, Model.TotalAppointments);
            var selectedStatuses = Model.SelectedStatuses ?? [];
            var selectedSkillsets = Model.SelectedSkillsets ?? [];
            var statusItems = selectedStatuses.Count > 0
                ? selectedStatuses
                : new List<string> { "Completed" };
            var skillsetItems = selectedSkillsets.Count > 0
                ? selectedSkillsets
                : new List<string> { "Repair" };
            <div class="rounded-lg overflow-hidden kpi-table" style="border: 1px solid #2a2a4a;">
                <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-2 text-xs font-semibold uppercase tracking-wide kpi-table-head"
                     style="background: rgba(99, 102, 241, 0.14); color: #c7d2fe;">
                    <span>Item</span>
                    <span class="text-right">Count</span>
                    <span class="text-right">%</span>
                </div>

                @{
                    var passPct = Model.TotalAppointments > 0 ? (double)Model.CompliancePassCount / totalBase * 100 : 0d;
                    var failPct = Model.TotalAppointments > 0 ? (double)Model.ComplianceFailCount / totalBase * 100 : 0d;
                }
                <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-green" style="background: rgba(34, 197, 94, 0.12); border-top: 1px solid rgba(42,42,74,0.6); color: #dcfce7;">
                    <span class="font-semibold">Passed</span>
                    <span class="text-right font-mono">@Model.CompliancePassCount.ToString("N0")</span>
                    <span class="text-right font-mono">@passPct.ToString("F1")%</span>
                </div>
                <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-red" style="background: rgba(239, 68, 68, 0.12); border-top: 1px solid rgba(42,42,74,0.6); color: #fee2e2;">
                    <span class="font-semibold">Failed</span>
                    <span class="text-right font-mono">@Model.ComplianceFailCount.ToString("N0")</span>
                    <span class="text-right font-mono">@failPct.ToString("F1")%</span>
                </div>

                @foreach (var statusName in statusItems)
                {
                    var statusCount = Model.StatusDistribution.TryGetValue(statusName, out var sc) ? sc : 0;
                    var statusPct = Model.TotalAppointments > 0 ? (double)statusCount / totalBase * 100 : 0d;
                    <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-indigo" style="background: rgba(99, 102, 241, 0.16); border-top: 1px solid rgba(42,42,74,0.6); color: #e0e7ff;">
                        <span class="font-semibold">Status - @statusName</span>
                        <span class="text-right font-mono">@statusCount.ToString("N0")</span>
                        <span class="text-right font-mono">@statusPct.ToString("F1")%</span>
                    </div>
                }

                @foreach (var skillsetName in skillsetItems)
                {
                    var skillsetCount = Model.SkillsetDistribution.TryGetValue(skillsetName, out var skc) ? skc : 0;
                    var skillsetPct = Model.TotalAppointments > 0 ? (double)skillsetCount / totalBase * 100 : 0d;
                    <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-orange" style="background: rgba(249, 115, 22, 0.12); border-top: 1px solid rgba(42,42,74,0.6); color: #ffedd5;">
                        <span class="font-semibold">Skillset - @skillsetName</span>
                        <span class="text-right font-mono">@skillsetCount.ToString("N0")</span>
                        <span class="text-right font-mono">@skillsetPct.ToString("F1")%</span>
                    </div>
                }

                @foreach (var territoryName in territoryItems)
                {
                    var territoryCount = Model.TerritoryDistribution.TryGetValue(territoryName, out var tc) ? tc : 0;
                    var territoryPct = Model.TotalAppointments > 0 ? (double)territoryCount / totalBase * 100 : 0d;
                    <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-green" style="background: rgba(34, 197, 94, 0.10); border-top: 1px solid rgba(42,42,74,0.6); color: #d1fae5;">
                        <span class="font-semibold">Territory - @territoryName</span>
                        <span class="text-right font-mono">@territoryCount.ToString("N0")</span>
                        <span class="text-right font-mono">@territoryPct.ToString("F1")%</span>
                    </div>
                }
            </div>
        }
        else
        {
            var totalBase = Math.Max(1, Model.TotalAppointments);
            var pendingSelectedSubStatuses = Model.SelectedSubStatuses ?? [];
            var pendingSelectedSkillsets = Model.SelectedSkillsets ?? [];
            var pendingSubStatusItems = pendingSelectedSubStatuses.Count > 0
                ? pendingSelectedSubStatuses
                : new List<string> { "ForVisit", "ForReschedule" };
            var pendingSkillsetItems = pendingSelectedSkillsets.Count > 0
                ? pendingSelectedSkillsets
                : new List<string> { "Repair" };
            var totalDelayedPct = Model.TotalAppointments > 0 ? (double)netDelayedCount / totalBase * 100 : 0d;
            var lapsePct = Model.TotalAppointments > 0 ? (double)Model.LapsedCount / totalBase * 100 : 0d;
            <div class="rounded-lg overflow-hidden kpi-table" style="border: 1px solid #2a2a4a;">
                <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-2 text-xs font-semibold uppercase tracking-wide kpi-table-head"
                     style="background: rgba(99, 102, 241, 0.14); color: #c7d2fe;">
                    <span>Item</span>
                    <span class="text-right">Count</span>
                    <span class="text-right">%</span>
                </div>
                <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-red" style="background: rgba(239, 68, 68, 0.12); border-top: 1px solid rgba(42,42,74,0.6); color: #fee2e2;">
                    <span class="font-semibold">Total Delayed</span>
                    <span class="text-right font-mono">@netDelayedCount.ToString("N0")</span>
                    <span class="text-right font-mono">@totalDelayedPct.ToString("F1")%</span>
                </div>
                <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-amber" style="background: rgba(245, 158, 11, 0.12); border-top: 1px solid rgba(42,42,74,0.6); color: #fef3c7;">
                    <span class="font-semibold">Lapses</span>
                    <span class="text-right font-mono">@Model.LapsedCount.ToString("N0")</span>
                    <span class="text-right font-mono">@lapsePct.ToString("F1")%</span>
                </div>
                @foreach (var subStatusName in pendingSubStatusItems)
                {
                    var subStatusCount = Model.SubStatusDistribution.TryGetValue(subStatusName, out var ssc) ? ssc : 0;
                    var subStatusPct = Model.TotalAppointments > 0 ? (double)subStatusCount / totalBase * 100 : 0d;
                    <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-indigo" style="background: rgba(99, 102, 241, 0.16); border-top: 1px solid rgba(42,42,74,0.6); color: #e0e7ff;">
                        <span class="font-semibold">SubStatus - @subStatusName</span>
                        <span class="text-right font-mono">@subStatusCount.ToString("N0")</span>
                        <span class="text-right font-mono">@subStatusPct.ToString("F1")%</span>
                    </div>
                }
                @foreach (var skillsetName in pendingSkillsetItems)
                {
                    var skillsetCount = Model.SkillsetDistribution.TryGetValue(skillsetName, out var skc) ? skc : 0;
                    var skillsetPct = Model.TotalAppointments > 0 ? (double)skillsetCount / totalBase * 100 : 0d;
                    <div class="grid grid-cols-[1fr_8rem_5rem] gap-2 px-4 py-3 text-sm kpi-row kpi-row-orange" style="background: rgba(249, 115, 22, 0.12); border-top: 1px solid rgba(42,42,74,0.6); color: #ffedd5;">
                        <span class="font-semibold">Skillset - @skillsetName</span>
                        <span class="text-right font-mono">@skillsetCount.ToString("N0")</span>
                        <span class="text-right font-mono">@skillsetPct.ToString("F1")%</span>
                    </div>
                }
            </div>
        }
    </div>
</section>


<section class="mb-8 fade-in" style="animation-delay: 0.25s;">
    <div class="rounded-xl overflow-hidden" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex items-center justify-between px-5 py-4" style="border-bottom: 1px solid #2a2a4a;">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-3 flex-1 min-w-0">
                <div class="flex items-center gap-2">
                    <i data-lucide="table" style="width:14px; height:14px; color: #6366f1;"></i>
                    <span class="text-sm font-semibold" style="color: #c8c8e0;">Data Preview</span>
                </div>
                @if (Model.ActiveDashboardView == "status")
                {
                    <p class="text-xs leading-snug max-w-xl" style="color: #6a6a8e;">
                        Rows use <span class="font-mono" style="color:#a5b4fc;">All Status</span> rules: Delayed and wrong-day Completed fail; AM slot fails for completion at/after 12:59 PM; PM slot can pass in AM/PM; N/A when completion time is missing.
                    </p>
                }
            </div>
            <span id="table-info" class="text-xs font-mono flex-shrink-0" style="color: #6a6a8e;"></span>
        </div>
        <div class="filter-scroll" style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; min-width: 900px;">
                <thead>
                    <tr id="table-header-row">
                        @foreach (var col in previewTableCols)
                        {
                            var isSortable = previewSortableCols.Contains(col);
                            <th data-col="@col"
                                style="padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 600; color: #8a8ab0; border-bottom: 1px solid #2a2a4a; background: rgba(15, 15, 30, 0.5); white-space: nowrap; position: sticky; top: 0; z-index: 1; @(isSortable ? "cursor: pointer; user-select: none;" : "")">
                                <span class="inline-flex items-center gap-1">
                                    @col
                                    @if (isSortable)
                                    {
                                        <span class="sort-icon" data-sort-col="@col" style="opacity: 0.3; font-size: 10px; transition: opacity 0.15s;">&#x25B2;&#x25BC;</span>
                                    }
                                </span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody id="table-body"></tbody>
            </table>
        </div>
        <div id="pagination-bar" class="flex items-center justify-between px-5 py-3" style="border-top: 1px solid #2a2a4a;">
            <div class="flex items-center gap-1.5" id="page-buttons"></div>
            <div class="flex items-center gap-2">
                <button id="prev-btn" type="button"
                        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer"
                        style="color: #a5b4fc; background: rgba(99, 102, 241, 0.1); border: 1px solid #2a2a4a;">
                    <i data-lucide="chevron-left" style="width:12px; height:12px;"></i> Prev
                </button>
                <span id="page-indicator" class="text-xs font-mono" style="color: #8a8ab0;"></span>
                <button id="next-btn" type="button"
                        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer"
                        style="color: #a5b4fc; background: rgba(99, 102, 241, 0.1); border: 1px solid #2a2a4a;">
                    Next <i data-lucide="chevron-right" style="width:12px; height:12px;"></i>
                </button>
            </div>
        </div>
    </div>
</section>

<section class="mt-8 pt-4 fade-in" style="animation-delay: 0.26s; border-top: 1px solid #2a2a4a;">
    <div class="flex flex-wrap items-center justify-end gap-2">
        <button id="slot-adh-export-csv-btn"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium transition-colors cursor-pointer"
                style="color: #a5b4fc; background: rgba(99, 102, 241, 0.12); border: 1px solid #2a2a4a;">
            <i data-lucide="file-down" style="width:12px; height:12px;"></i> Export CSV (Full Data)
        </button>
        <button id="slot-adh-export-xlsx-btn"               
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium transition-colors cursor-pointer"
                style="color: #e0e7ff; background: rgba(34, 197, 94, 0.16); border: 1px solid rgba(34, 197, 94, 0.35);">
            <i data-lucide="file-text" style="width:12px; height:12px;"></i> Export PDF (Visual)
        </button>
    </div>

    <form id="slot-adh-export-csv-form" asp-controller="Report" asp-action="ExportSlotAdherenceCsv" method="post" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReportToken" value="@Model.ReportToken" />
        <input type="hidden" name="View" value="@Model.ActiveDashboardView" />
    </form>

</section>

</div>
<!-- ═══════════════════════════════════════════════════════════════════════════
     END: Slot Adherence Report Container
     ═══════════════════════════════════════════════════════════════════════════ -->

<!-- ═══════════════════════════════════════════════════════════════════════════
     HEATMAP ANALYSIS CONTAINER
     ═══════════════════════════════════════════════════════════════════════════ -->
<div id="heatmap-analysis-report" class="mb-10 rounded-2xl p-6" style="background: rgba(10,10,25,0.45); border: 1px solid #2a2a4a;">
    <div class="flex items-center gap-2 mb-4 pb-4" style="border-bottom: 1px solid #2a2a4a;">
        <i data-lucide="flame" style="width:16px; height:16px; color: #a855f7;"></i>
        <span class="text-base font-semibold tracking-wide" style="color: #c8c8e0;">Heatmap Analysis</span>
    </div>

    <!-- ── Independent Heatmap Filter Bar ── -->
    <div id="hm-indep-filter" class="mb-5 rounded-xl overflow-hidden" style="background: rgba(22,22,42,0.6); border: 1px solid #2a2a4a;">
        <div id="hm-indep-filter-toggle" class="flex items-center justify-between px-4 py-3 cursor-pointer select-none" style="border-bottom: 1px solid transparent;">
            <div class="flex items-center gap-2">
                <i data-lucide="filter" style="width:13px; height:13px; color: #a855f7;"></i>
                <span class="text-xs font-semibold" style="color: #c8c8e0;">Heatmap Filters</span>
            </div>
            <div class="flex items-center gap-2">
                <span id="hm-filter-active-badge" class="hidden text-xs font-mono px-2 py-0.5 rounded-full" style="background: rgba(239,68,68,0.15); color: #f87171;"></span>
                <svg id="hm-filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;color:#6a6a8e;transition:transform 0.2s;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
        </div>
        <div id="hm-indep-filter-body" style="display:none;">
            <div class="p-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
                <!-- Territory -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[10px] font-semibold uppercase tracking-wide" style="color: #6a6a8e;">Territory</span>
                        <div class="flex gap-1">
                            <button type="button" class="hm-flt-sel-all text-[10px] px-1.5 py-0.5 rounded cursor-pointer" data-target="territory" style="color: #a5b4fc; background: rgba(99,102,241,0.1);">All</button>
                            <button type="button" class="hm-flt-sel-none text-[10px] px-1.5 py-0.5 rounded cursor-pointer" data-target="territory" style="color: #8a8ab0; background: rgba(255,255,255,0.04);">None</button>
                        </div>
                    </div>
                    <div class="flex flex-col gap-0.5 max-h-36 overflow-y-auto filter-scroll" id="hm-territory-list">
                        @foreach (var t in Model.AvailableTerritories)
                        {
                            <label class="flex items-center gap-2 px-2 py-1 rounded-lg cursor-pointer" style="color: #c8c8e0;">
                                <input type="checkbox" class="hm-flt-cb" data-group="territory" value="@t" checked style="accent-color: #6366f1; width:12px; height:12px; flex-shrink:0;">
                                <span class="text-xs truncate" title="@t">@t</span>
                            </label>
                        }
                    </div>
                </div>
                <!-- Skillset -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[10px] font-semibold uppercase tracking-wide" style="color: #6a6a8e;">Skillset</span>
                        <div class="flex gap-1">
                            <button type="button" class="hm-flt-sel-all text-[10px] px-1.5 py-0.5 rounded cursor-pointer" data-target="skillset" style="color: #a5b4fc; background: rgba(99,102,241,0.1);">All</button>
                            <button type="button" class="hm-flt-sel-none text-[10px] px-1.5 py-0.5 rounded cursor-pointer" data-target="skillset" style="color: #8a8ab0; background: rgba(255,255,255,0.04);">None</button>
                        </div>
                    </div>
                    <div class="flex flex-col gap-0.5 max-h-36 overflow-y-auto filter-scroll" id="hm-skillset-list">
                        @foreach (var s in Model.AvailableSkillsets)
                        {
                            var hmSkillChecked = s.IndexOf("Install", StringComparison.OrdinalIgnoreCase) >= 0
                                              || s.IndexOf("Repair",  StringComparison.OrdinalIgnoreCase) >= 0;
                            <label class="flex items-center gap-2 px-2 py-1 rounded-lg cursor-pointer" style="color: #c8c8e0;">
                                <input type="checkbox" class="hm-flt-cb" data-group="skillset" value="@s" @(hmSkillChecked ? "checked" : "") style="accent-color: #6366f1; width:12px; height:12px; flex-shrink:0;">
                                <span class="text-xs truncate" title="@s">@s</span>
                            </label>
                        }
                    </div>
                </div>
                <!-- Status -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[10px] font-semibold uppercase tracking-wide" style="color: #6a6a8e;">Status</span>
                        <div class="flex gap-1">
                            <button type="button" class="hm-flt-sel-all text-[10px] px-1.5 py-0.5 rounded cursor-pointer" data-target="status" style="color: #a5b4fc; background: rgba(99,102,241,0.1);">All</button>
                            <button type="button" class="hm-flt-sel-none text-[10px] px-1.5 py-0.5 rounded cursor-pointer" data-target="status" style="color: #8a8ab0; background: rgba(255,255,255,0.04);">None</button>
                        </div>
                    </div>
                    <div class="flex flex-col gap-0.5 max-h-36 overflow-y-auto filter-scroll" id="hm-status-list">
                        @foreach (var st in Model.AvailableStatuses)
                        {
                            var hmStatusChecked = st.IndexOf("Cancelled", StringComparison.OrdinalIgnoreCase) >= 0
                                               || st.IndexOf("Completed", StringComparison.OrdinalIgnoreCase) >= 0;
                            <label class="flex items-center gap-2 px-2 py-1 rounded-lg cursor-pointer" style="color: #c8c8e0;">
                                <input type="checkbox" class="hm-flt-cb" data-group="status" value="@st" @(hmStatusChecked ? "checked" : "") style="accent-color: #6366f1; width:12px; height:12px; flex-shrink:0;">
                                <span class="text-xs truncate" title="@st">@st</span>
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="flex items-center justify-between gap-3 px-4 py-3" style="border-top: 1px solid #2a2a4a;">
                <span id="hm-filter-dot-count" class="text-xs font-mono" style="color: #6a6a8e;">—</span>
                <div class="flex items-center gap-2">
                    <button type="button" id="hm-filter-reset-btn"
                            class="text-xs font-medium px-3 py-1.5 rounded-lg cursor-pointer transition-colors"
                            style="color: #8a8ab0; background: rgba(255,255,255,0.04); border: 1px solid #2a2a4a;">
                        Reset All
                    </button>
                    <button type="button" id="hm-filter-apply-btn"
                            class="inline-flex items-center gap-1.5 text-xs font-semibold px-4 py-1.5 rounded-lg cursor-pointer transition-colors"
                            style="color: #fff; background: #6366f1; border: 1px solid #6366f1;">
                        <i data-lucide="check" style="width:12px; height:12px;"></i> Apply Filters
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- ── End Independent Heatmap Filter Bar ── -->

<section class="mb-8 fade-in" style="animation-delay: 0.24s;">
    <div class="rounded-xl overflow-hidden" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
        <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4" style="border-bottom: 1px solid #2a2a4a;">
            <div class="flex flex-wrap items-center gap-2 min-w-0">
                <i data-lucide="flame" style="width:14px; height:14px; color: #a855f7;"></i>
                <span class="text-sm font-semibold" style="color: #c8c8e0;">Heatmap Analysis</span>
                <span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background: rgba(168,85,247,0.15); color: #c084fc;">Interactive</span>
                <span class="text-xs hidden sm:inline font-mono" style="color: #5a5a7e;">
                    @(Model.ActiveDashboardView == "status" ? "All Status" : "All Pending")
                </span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <label for="nap-heatmap-month" class="text-xs font-medium whitespace-nowrap" style="color: #6a6a8e;">
                    <i data-lucide="calendar" class="inline-block align-middle mr-1" style="width:12px; height:12px; color: #6366f1;"></i>
                    Filter by month
                </label>
                <select id="nap-heatmap-month" class="nap-hm-select" aria-label="Filter heatmap by month range">
                    <option value="">All months</option>
                    @foreach (var range in heatmapMonthRanges)
                    {
                        var startLabel = DateTime.TryParse(range.Start + "-01", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var sd)
                            ? sd.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                            : range.Start;
                        var endLabel = DateTime.TryParse(range.End + "-01", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var ed)
                            ? ed.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                            : range.End;
                        <option value="@($"{range.Start}|{range.End}")">@($"{startLabel} - {endLabel}")</option>
                    }
                </select>
                <span style="color: #3a3a5a; user-select: none;">|</span>
                <label id="nap-ref-upload-label" title="Upload NAP reference file (.xlsx or .csv) to filter map pins"
                    class="flex items-center gap-1.5 cursor-pointer text-xs font-medium px-3 py-1.5 rounded-lg transition-all whitespace-nowrap"
                    style="background: rgba(99,102,241,0.12); color: #818cf8; border: 1px solid rgba(99,102,241,0.25);">
                    <i data-lucide="upload" style="width:12px; height:12px; flex-shrink:0;"></i>
                    <span id="nap-ref-label-text">Upload NAP Reference</span>
                    <input id="nap-ref-file" type="file" accept=".xlsx,.csv" class="hidden" />
                </label>
            </div>
        </div>
        <div class="p-5">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
                <div class="rounded-lg p-4" style="background: rgba(15, 15, 30, 0.55); border: 1px solid #2a2a4a;">
                    <p class="text-[10px] font-semibold uppercase tracking-wide mb-1" style="color: #6a6a8e;">Total NAPs</p>
                    <p id="nap-hm-metric-total" class="text-2xl font-bold font-mono" style="color: #f0f0f8;">@Model.HeatmapTotalAppointments.ToString("N0")</p>
                    <p class="text-xs mt-1" style="color: #5a5a7e;">Filtered appointments</p>
                </div>
                <div class="rounded-lg p-4" style="background: rgba(15, 15, 30, 0.55); border: 1px solid #2a2a4a;">
                    <div class="flex items-center gap-1.5 mb-1">
                        <i data-lucide="wrench" style="width:10px; height:10px; color: #f97316; flex-shrink:0;"></i>
                        <p class="text-[10px] font-semibold uppercase tracking-wide" style="color: #6a6a8e;">Repair</p>
                    </div>
                    <p id="nap-hm-metric-repair" class="text-2xl font-bold font-mono" style="color: #a5b4fc;">@hmRepairCount.ToString("N0")</p>
                    <p class="text-xs mt-1" style="color: #5a5a7e;">Repair skillset NAPs</p>
                </div>
                <div class="rounded-lg p-4" style="background: rgba(15, 15, 30, 0.55); border: 1px solid #2a2a4a;">
                    <div class="flex items-center gap-1.5 mb-1">
                        <i data-lucide="package-plus" style="width:10px; height:10px; color: #ED7D3A; flex-shrink:0;"></i>
                        <p class="text-[10px] font-semibold uppercase tracking-wide" style="color: #6a6a8e;">Install</p>
                    </div>
                    <p id="nap-hm-metric-install" class="text-2xl font-bold font-mono" style="color: #ED7D3A;">@hmInstallCount.ToString("N0")</p>
                    <p class="text-xs mt-1" style="color: #5a5a7e;">Install skillset NAPs</p>
                </div>
                <div class="rounded-lg p-4" style="background: rgba(15, 15, 30, 0.55); border: 1px solid #2a2a4a;">
                    <p class="text-[10px] font-semibold uppercase tracking-wide mb-1" style="color: #6a6a8e;">Total Barangays</p>
                    <p id="nap-hm-metric-days" class="text-2xl font-bold font-mono" style="color: #facc15;">—</p>
                    <p class="text-xs mt-1" style="color: #5a5a7e;">Affected barangays</p>
                </div>
            </div>

            <div class="flex flex-col xl:flex-row gap-5">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <div class="flex items-center gap-2">
                            <i data-lucide="map-pin" style="width:12px; height:12px; color: #6366f1;"></i>
                            <span class="text-xs font-semibold uppercase tracking-wide" style="color: #8a8ab0;">NAP distribution — Davao City</span>
                        </div>
                        <span id="nap-hm-scope-label" class="text-xs font-mono" style="color: #5a5a7e;">—</span>
                    </div>
                    <div id="nap-davao-map-wrap">
                        <div id="nap-davao-map"></div>
                    </div>
                    <div class="flex flex-wrap items-center gap-4 mt-3">
                        <span class="flex items-center gap-1.5 text-[11px]" style="color: #8a8ab0;">
                            <span class="nap-map-legend-dot" style="background:#32CD32;"></span>Repair
                        </span>
                        <span class="flex items-center gap-1.5 text-[11px]" style="color: #8a8ab0;">
                            <span class="nap-map-legend-dot" style="background:#1E90FF;"></span>Install
                        </span>
                        <span class="ml-auto text-[10px] font-mono" style="color: #4a4a6e;">Circle size ∝ NAP count</span>
                    </div>
                </div>
                <div class="w-full xl:w-72 flex-shrink-0 rounded-lg p-4" style="background: rgba(15, 15, 30, 0.45); border: 1px solid #2a2a4a;">
                    <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: #8a8ab0;">Top barangays with NAPs</p>
                    <select id="nap-hm-brgy-filter" class="nap-hm-select w-full mb-3" disabled aria-label="Filter by barangay">
                        <option value="">All barangays</option>
                    </select>
                    <div id="nap-hm-brgy-bars" class="flex flex-col gap-2.5 mb-5"></div>

                    <p class="text-xs font-semibold uppercase tracking-wide mb-3" style="color: #8a8ab0;">Top fix descriptions</p>
                    <div id="nap-hm-fix-bars" class="flex flex-col gap-2.5"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="nap-hm-others-modal" class="nap-hm-modal hidden" aria-hidden="true">
    <div class="nap-hm-modal-backdrop" data-role="close"></div>
    <div class="nap-hm-modal-card" role="dialog" aria-modal="true" aria-labelledby="nap-hm-others-title">
        <div class="nap-hm-modal-header">
            <h3 id="nap-hm-others-title" class="nap-hm-modal-title">All items</h3>
            <button type="button" id="nap-hm-others-close" class="nap-hm-modal-close">Close</button>
        </div>
        <div id="nap-hm-others-list" class="nap-hm-modal-list"></div>
    </div>
</div>

</div>
<!-- ═══════════════════════════════════════════════════════════════════════════
     END: Heatmap Analysis Container
     ═══════════════════════════════════════════════════════════════════════════ -->

<!-- ═══════════════════════════════════════════════════════════════════════════
     START: Recurring Tickets Report
     ═══════════════════════════════════════════════════════════════════════════ -->
<div id="recurring-tickets-report" class="mb-10 rounded-2xl p-8" style="background: rgba(15,15,35,0.4); border: 1px solid #2a2a4a; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.3);">
    <!-- ── Header Section ── -->
    <div class="flex flex-col xl:flex-row xl:items-start justify-between gap-8 mb-8 pb-8" style="border-bottom: 1px solid #2a2a4a;">
        <!-- Left Side: Identity -->
        <div class="flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center" style="background: rgba(249,115,22,0.1); border: 1px solid rgba(249,115,22,0.25);">
                <i data-lucide="repeat-2" style="width:28px; height:28px; color: #f97316;"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold tracking-tight" style="color: #f0f0f8;">Recurring Tickets</h2>
                <div id="rt-count-badge" class="text-[11px] font-black uppercase tracking-[0.15em] mt-1" style="color: #fb923c;">LOADING INSTANCES...</div>
            </div>
        </div>
        
        <!-- Right Side: Controls Row -->
        <div class="flex-1 max-w-4xl">
            <div class="flex items-end gap-4">
                <!-- Filter Trigger Group -->
                <div class="flex flex-col gap-2">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider pl-1" style="color: #cbd5e1;">
                        <i data-lucide="sliders-horizontal" class="w-3 h-3"></i>
                        <span>Refine Search</span>
                    </div>
                    <button id="rt-open-filters" class="flex items-center gap-3 px-5 py-2.5 rounded-xl border border-[#2a2a4a] bg-indigo-600/10 hover:bg-indigo-600/20 text-indigo-300 transition-all font-bold text-sm">
                        <i data-lucide="filter" class="w-4 h-4"></i>
                        <span>Filter Results</span>
                        <span id="rt-filter-count" class="hidden ml-1 px-1.5 py-0.5 rounded-md bg-indigo-500 text-white text-[10px]">0</span>
                    </button>
                </div>

                <!-- Search Group -->
                <div class="flex-1 flex flex-col gap-2">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider pl-1" style="color: #cbd5e1;">
                        <i data-lucide="search" class="w-3 h-3"></i>
                        <span>Quick Find</span>
                    </div>
                    <div class="relative">
                        <input type="text" id="rt-search" placeholder="Search service, name, address..."
                               class="rt-input w-full pl-10 h-[42px]" />
                        <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#818cf8]"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="flex items-start gap-3 mb-6 p-4 rounded-xl" style="background: rgba(99, 102, 241, 0.03); border: 1px solid rgba(99, 102, 241, 0.1);">
        <i data-lucide="info" class="w-4 h-4 mt-0.5 text-[#6366f1]"></i>
        <p class="text-sm leading-relaxed" style="color: #cbd5e1;">
            Analyzing Service IDs that were initially <strong>Installed</strong> or <strong>Repaired</strong>, then subsequently received another <strong>Repair</strong> ticket. Use the <strong>Filter Results</strong> button to refine by date range or the <strong>day gap</strong> between tickets.
        </p>
    </div>

    <!-- Insights Section -->
    <div class="mb-10">
        <div class="flex items-center gap-2 mb-6">
            <div class="w-1.5 h-6 bg-indigo-500 rounded-full"></div>
            <h3 class="text-lg font-bold text-white uppercase tracking-wider">Recurring Insights</h3>
            <span class="text-[10px] text-gray-500 font-bold uppercase tracking-widest ml-2 px-2 py-0.5 rounded bg-white/5 border border-white/10">Top Rankings</span>
        </div>

        <!-- Total Count Strip -->
        <div class="flex items-center justify-center gap-8 mb-10 py-8 rounded-3xl bg-indigo-600/5 border border-indigo-600/10 shadow-inner">
            <div class="flex flex-col items-center">
                <p class="text-[10px] font-black uppercase tracking-[0.4em] text-indigo-400/60 mb-2">Total Recurring Instances</p>
                <h4 id="rt-total-summary" class="text-5xl font-black text-white tracking-tighter">0</h4>
            </div>
        </div>

        <div id="rt-summary-container" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
