@model SlotAd_Globe.Models.KpiDashboardViewModel
@using System.Linq
@{
    ViewData["Title"] = "KPI Dashboard";
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    ViewData["ActiveTab"] = "kpi";
    var statusExtraCols = Model.ActiveDashboardView == "status"
        ? new[] { "CompletionDate", "Compliance", "ComplianceReason" }
        : Array.Empty<string>();
    var previewTableCols = new[]
    {
        "AppointmentID", "AppointmentDate", "Skillset", "Status", "SubStatus", "Territory", "OrderCreateDate", "LastUpdateDate"
    }.Concat(statusExtraCols).ToArray();
    var previewSortableCols = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "AppointmentDate", "OrderCreateDate", "LastUpdateDate", "CompletionDate"
    };
    var passFailDenom = Model.CompliancePassCount + Model.ComplianceFailCount;
    var passRatePct = passFailDenom > 0 ? (double)Model.CompliancePassCount / passFailDenom * 100 : 0d;
    var _hmNow = DateTime.Now;
    var _hmCurrentYearMonths = Enumerable.Range(1, _hmNow.Month)
        .Select(m => $"{_hmNow.Year}-{m:D2}");
    var _hmDataMonths = Model.HeatmapAppointmentsByDate.Keys
        .Select(k => DateTime.TryParse(k, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : (DateTime?)null)
        .Where(d => d.HasValue)
        .Select(d => d!.Value.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture));
    var heatmapMonthKeys = _hmCurrentYearMonths
        .Union(_hmDataMonths)
        .Distinct()
        .OrderBy(x => x, StringComparer.Ordinal)
        .ToList();
    var heatmapMonthRanges = new List<(string Start, string End)>();
    if (heatmapMonthKeys.Count == 1)
    {
        heatmapMonthRanges.Add((heatmapMonthKeys[0], heatmapMonthKeys[0]));
    }
    else
    {
        for (var i = 0; i + 1 < heatmapMonthKeys.Count; i++)
        {
            heatmapMonthRanges.Add((heatmapMonthKeys[i], heatmapMonthKeys[i + 1]));
        }
    }
    var hmRepairCount  = Model.HeatmapRepairCount;
    var hmInstallCount = Model.HeatmapInstallCount;
}
