                <button type="button" id="kpi-upload-btn" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold transition-colors cursor-pointer"
                        style="background: rgba(99, 102, 241, 0.12); color: #a5b4fc; border: 1px solid #2a2a4a;">
