        (function initReportHistoryFilter() {
            var section = document.getElementById('report-history-section');
            if (!section) return;

            var groups = section.querySelectorAll('.report-history-day-group');
            var summaryEl = document.getElementById('report-history-summary');
            var emptyEl = document.getElementById('report-history-empty');
            var groupsWrap = document.getElementById('report-history-groups');
            var dateInput = document.getElementById('report-history-date');
            var applyBtn = document.getElementById('report-history-date-apply');
            var clearBtn = document.getElementById('report-history-date-clear');
            var presetBtns = section.querySelectorAll('[data-rh-preset]');
            var totalUploads = parseInt(section.getAttribute('data-total-uploads') || '0', 10);

            function parseUtcDate(yyyyMmDd) {
                var p = yyyyMmDd.split('-');
                if (p.length !== 3) return null;
                return new Date(Date.UTC(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10)));
            }

            function todayUtcMidnight() {
                var n = new Date();
                return new Date(Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), n.getUTCDate()));
            }

            function dayMatchesPreset(dUtc, preset) {
                var t = todayUtcMidnight();
                if (preset === 'all') return true;
                if (preset === 'today') return dUtc.getTime() === t.getTime();
                if (preset === '7d') {
                    var start = new Date(t);
                    start.setUTCDate(start.getUTCDate() - 6);
                    return dUtc >= start && dUtc <= t;
                }
                if (preset === '30d') {
                    var start30 = new Date(t);
                    start30.setUTCDate(start30.getUTCDate() - 29);
                    return dUtc >= start30 && dUtc <= t;
                }
                return true;
            }

            function setPresetActive(btn) {
                presetBtns.forEach(function (b) { b.classList.remove('report-history-preset-active'); });
                if (btn) btn.classList.add('report-history-preset-active');
            }

            function updateSummary(visibleCount) {
                if (!summaryEl) return;
                var base = ' · UTC · current highlighted';
                var mode = section.getAttribute('data-rh-mode') || 'all';
                var hasDate = dateInput && dateInput.value;
                var filtered = !!hasDate || mode !== 'all';
                if (!filtered) {
                    summaryEl.textContent = totalUploads + ' upload' + (totalUploads === 1 ? '' : 's') + base;
                } else {
                    summaryEl.textContent = 'Showing ' + visibleCount + ' of ' + totalUploads + base;
                }
            }

            function applyFilter() {
                var mode = section.getAttribute('data-rh-mode') || 'all';
                var singleDate = dateInput && dateInput.value ? dateInput.value : '';

                var visibleCount = 0;
                groups.forEach(function (g) {
                    var ds = g.getAttribute('data-upload-date');
                    if (!ds) return;
                    var d = parseUtcDate(ds);
                    if (!d) return;

                    var show;
                    if (singleDate) {
                        show = ds === singleDate;
                    } else {
                        show = dayMatchesPreset(d, mode);
                    }

                    var n = g.querySelectorAll('a.report-history-item').length;
                    if (show) visibleCount += n;
                    g.style.display = show ? '' : 'none';
                });

                if (emptyEl) {
                    var hideEmpty = visibleCount > 0;
                    emptyEl.classList.toggle('hidden', hideEmpty);
                }
                if (groupsWrap) {
                    groupsWrap.style.display = visibleCount === 0 ? 'none' : '';
                }

                updateSummary(visibleCount);
            }

            presetBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (dateInput) dateInput.value = '';
                    var preset = btn.getAttribute('data-rh-preset') || 'all';
                    section.setAttribute('data-rh-mode', preset);
                    setPresetActive(btn);
                    applyFilter();
                });
            });

            if (dateInput && applyBtn) {
                applyBtn.addEventListener('click', function () {
                    if (!dateInput.value) return;
                    section.setAttribute('data-rh-mode', 'all');
                    setPresetActive(null);
                    applyFilter();
                });
            }

            if (dateInput && clearBtn) {
                clearBtn.addEventListener('click', function () {
                    dateInput.value = '';
                    section.setAttribute('data-rh-mode', 'all');
                    var allBtn = section.querySelector('[data-rh-preset="all"]');
                    setPresetActive(allBtn);
                    applyFilter();
                });
            }

            section.setAttribute('data-rh-mode', 'all');
            setPresetActive(section.querySelector('[data-rh-preset="all"]'));
            applyFilter();
        })();

