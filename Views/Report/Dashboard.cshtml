            }

            async function fetchData() {
                elements.loader.classList.remove('hidden');
                try {
                    var url = '/Report/Dashboard/' + token + '/RecurringTickets?' +
                        'filterMode=' + filterMode +
                        '&selectedDate=' + selectedDate +
                        '&dateRangeStart=' + dateRangeStart +
                        '&dateRangeEnd=' + dateRangeEnd +
                        '&minGap=' + (minGap || '') +
                        '&maxGap=' + (maxGap || '') +
                        '&page=' + currentPage +
                        '&pageSize=' + pageSize;

                    var response = await fetch(url);
                    if (!response.ok) throw new Error('Fetch failed');
                    var data = await response.json();
                    
                    renderTable(data.items);
                    renderSummary(data.summary);
                    totalCount = data.total;
                    updateUI();
                } catch (err) {
                    console.error(err);
                    elements.tbody.innerHTML = '<tr><td colspan="12" class="text-center py-10 text-red-400">Error loading data.</td></tr>';
                } finally {
                    elements.loader.classList.add('hidden');
                }
            }

            function renderSummary(summary) {
                if (!summary) return;
                
                elements.totalSummary.textContent = summary.totalRecurringTickets.toLocaleString();
                
                function createRankingHtml(list, colorClass, barBg) {
                    if (!list || list.length === 0) return '<p class="text-[10px] text-gray-500 italic py-4 text-center">No data available</p>';
                    
                    const maxCount = list[0].count;
                    return list.map((item, idx) => {
                        const percentage = (item.count / maxCount) * 100;
                        return `
                            <div class="rt-rank-item group">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="text-[10px] font-bold text-gray-600 group-hover:text-indigo-400 transition-colors w-4">#${idx + 1}</span>
                                        <span class="text-[11px] font-medium text-gray-300 truncate" title="${item.name}">${item.name}</span>
                                    </div>
                                    <span class="text-[11px] font-black ${colorClass}">${item.count.toLocaleString()}</span>
                                </div>
                                <div class="w-full h-[1px] bg-white/5 rounded-full overflow-hidden mt-1 relative">
                                    <div class="rt-rank-bar ${barBg}" style="width: ${percentage}%"></div>
                                </div>
                            </div>
                        `;
                    }).join('');
                }

                elements.napRanking.innerHTML = createRankingHtml(summary.topNaps, 'text-emerald-400', 'bg-emerald-500');
                elements.cabinetRanking.innerHTML = createRankingHtml(summary.topCabinets, 'text-amber-400', 'bg-amber-500');
                elements.techRanking.innerHTML = createRankingHtml(summary.topTechTeams, 'text-rose-400', 'bg-rose-500');
            }

            function renderTable(items) {
                if (!items || items.length === 0) {
                    elements.tbody.innerHTML = '<tr><td colspan="12" class="text-center py-10" style="color: #5a5a7e;">No recurring tickets found for this period.</td></tr>';
                    return;
                }

                var html = '';
                items.forEach(function(row) {
                    var badgeClass = row.daysBetween >= 90 ? 'rt-danger' : (row.daysBetween >= 30 ? 'rt-warn' : 'rt-info');
                    var initTag = row.initialSkillset.toLowerCase().includes('install') ? 'rt-skillset-install' : 'rt-skillset-repair';
                    
                    html += '<tr>' +
                        '<td><span class="font-mono font-bold text-xs" style="color: #a5b4fc;">' + row.serviceIdNumber + '</span></td>' +
                        '<td>' + row.customerName + '</td>' +
                        '<td class="max-w-[150px] truncate" title="' + row.customerAddress + '">' + row.customerAddress + '</td>' +
                        '<td>' + row.territory + '</td>' +
                        '<td>' + row.facilityName + '</td>' +
                        '<td><span class="font-mono text-xs">' + row.initialTicketDate + '</span></td>' +
                        '<td><span class="text-[10px] font-bold text-gray-400">' + row.initialWorkOrderNumber + '</span></td>' +
                        '<td><span class="rt-skillset-tag ' + initTag + '">' + row.initialSkillset + '</span></td>' +
                        '<td><span class="font-mono text-xs">' + row.recurringTicketDate + '</span></td>' +
                        '<td><span class="text-[10px] font-bold text-indigo-300">' + row.recurringWorkOrderNumber + '</span></td>' +
                        '<td><span class="rt-skillset-tag rt-skillset-repair">' + row.recurringSkillset + '</span></td>' +
                        '<td><span class="rt-badge-days ' + badgeClass + '">' + row.daysBetween + ' d</span></td>' +
                    '</tr>';
                });
                elements.tbody.innerHTML = html;
            }

            function updateUI() {
                var totalPages = Math.ceil(totalCount / pageSize) || 1;
                elements.countBadge.innerText = totalCount + ' INSTANCE(S)';
                elements.pageInfo.textContent = 'Page ' + currentPage + ' of ' + totalPages;
                elements.prevBtn.disabled = currentPage <= 1;
                elements.nextBtn.disabled = currentPage >= totalPages;
                
                // Active filter count
                var count = 0;
                if (filterMode !== 'all') count++;
                if (minGap) count++;
                if (maxGap) count++;
                
                if (count > 0) {
                    elements.filterCount.textContent = count;
                    elements.filterCount.classList.remove('hidden');
                } else {
                    elements.filterCount.classList.add('hidden');
                }

                if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            function reload() {
                currentPage = 1;
                fetchData();
            }

            // Modal Controls
            elements.openModalBtn.addEventListener('click', function() {
                elements.modal.classList.remove('hidden');
                setTimeout(() => {
                    elements.modalContent.classList.remove('scale-95', 'opacity-0');
                }, 10);
                document.body.style.overflow = 'hidden';
            });
            
            var closeModal = function() {
                elements.modalContent.classList.add('scale-95', 'opacity-0');
                setTimeout(() => {
                    elements.modal.classList.add('hidden');
                }, 300);
                document.body.style.overflow = '';
            };
            elements.closeModalBtn.addEventListener('click', closeModal);
            elements.overlay.addEventListener('click', closeModal);

            // Filter Pills inside Modal
            elements.modal.querySelectorAll('.rt-filter-pill').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    elements.modal.querySelectorAll('.rt-filter-pill').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    filterMode = btn.dataset.mode;
                    renderDateInputs();
                });
            });

            elements.applyBtn.addEventListener('click', function() {
                // Read dates from dynamic inputs if they exist
                if (filterMode === 'single') {
                    selectedDate = document.getElementById('rt-date-single').value;
                } else if (filterMode === 'range') {
                    dateRangeStart = document.getElementById('rt-date-start').value;
                    dateRangeEnd = document.getElementById('rt-date-end').value;
                }

                minGap = elements.minGapInput.value ? parseInt(elements.minGapInput.value) : null;
                maxGap = elements.maxGapInput.value ? parseInt(elements.maxGapInput.value) : null;
                
                closeModal();
                reload();
            });

            elements.resetBtn.addEventListener('click', function() {
                filterMode = 'all';
                selectedDate = '';
                dateRangeStart = '';
                dateRangeEnd = '';
                minGap = null;
                maxGap = null;
                
                elements.minGapInput.value = '';
                elements.maxGapInput.value = '';
                elements.modal.querySelectorAll('.rt-filter-pill').forEach(b => b.classList.remove('active'));
                elements.modal.querySelector('[data-mode="all"]').classList.add('active');
                
                renderDateInputs();
                closeModal();
                reload();
            });

            elements.prevBtn.addEventListener('click', function() {
                if (currentPage > 1) { currentPage--; fetchData(); }
            });

            elements.nextBtn.addEventListener('click', function() {
                var totalPages = Math.ceil(totalCount / pageSize);
                if (currentPage < totalPages) { currentPage++; fetchData(); }
            });

            elements.searchInput.addEventListener('input', function() {
                var query = this.value.toLowerCase().trim();
                var rows = elements.tbody.querySelectorAll('tr');
                rows.forEach(function(row) {
                    if (row.cells.length < 12) return;
                    row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
                });
            });

            function exportData(format) {
                var url = '/Report/Dashboard/' + token + '/ExportRecurringTickets?' +
                    'format=' + format +
                    '&filterMode=' + filterMode +
                    '&selectedDate=' + selectedDate +
                    '&dateRangeStart=' + dateRangeStart +
                    '&dateRangeEnd=' + dateRangeEnd +
                    '&minGap=' + (minGap || '') +
                    '&maxGap=' + (maxGap || '');
                window.location.href = url;
            }

            elements.exportCsv.addEventListener('click', function() { exportData('csv'); });
            elements.exportXlsx.addEventListener('click', function() { exportData('xlsx'); });

            // Initial load
            fetchData();
        })();
    </script>
}
