            var end = Math.min(start + rowsPerPage, allRows.length);
            var tbody = document.getElementById('table-body');
            tbody.innerHTML = '';

            if (allRows.length === 0) {
                var tr = document.createElement('tr');
                var td = document.createElement('td');
                td.colSpan = tableColumns.length;
                td.style.cssText = 'padding:30px;text-align:center;color:' + palette.emptyText + ';font-size:13px;';
                td.textContent = 'No records match the selected filters.';
                tr.appendChild(td);
                tbody.appendChild(tr);
            } else {
                for (var i = start; i < end; i++) {
                    var row = allRows[i];
                    var tr = document.createElement('tr');
                    var baseBg = palette.defaultBg;
                    if (useComplianceRowStyle) {
                        if (row['Compliance'] === 'Fail') baseBg = palette.complianceFailBg;
                        else if (row['Compliance'] === 'Pass') baseBg = palette.compliancePassBg;
                    } else {
                        if (row['_isLapsed'] === '1') baseBg = palette.lapsedBg;
                        else if (row['_isDelayed'] === '1') baseBg = palette.delayedBg;
                    }
                    tr.style.cssText = 'border-bottom:1px solid ' + palette.rowBorder + ';background:' + baseBg + ';';
                    tr.setAttribute('data-bg', baseBg);
                    tr.onmouseover = function() { this.style.background = palette.hoverBg; };
                    tr.onmouseout = function() { this.style.background = this.getAttribute('data-bg'); };
                    for (var c = 0; c < tableColumns.length; c++) {
                        var td = document.createElement('td');
                        td.style.cssText = "padding:8px 14px;font-size:12px;color:" + palette.bodyText + ";font-family:'JetBrains Mono',monospace;white-space:nowrap;";
                        td.textContent = row[tableColumns[c]] || '';
                        tr.appendChild(td);
