            var csvForm = document.getElementById('slot-adh-export-csv-form');
            if (!csvBtn || !xlsxBtn || !csvForm) return;

            var isBusy = false;
            var defaultCsvText = csvBtn.textContent;
            var defaultXlsxText = xlsxBtn.textContent;

            function setBusy(nextBusy, labelText) {
                isBusy = nextBusy;
                csvBtn.disabled = nextBusy;
                xlsxBtn.disabled = nextBusy;
                csvBtn.style.opacity = nextBusy ? '0.6' : '1';
                xlsxBtn.style.opacity = nextBusy ? '0.6' : '1';
                csvBtn.style.pointerEvents = nextBusy ? 'none' : '';
                xlsxBtn.style.pointerEvents = nextBusy ? 'none' : '';
