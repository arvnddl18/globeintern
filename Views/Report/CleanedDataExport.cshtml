@model SlotAd_Globe.Models.CleanedDataSummary

@{
    ViewData["Title"] = "Cleaned Data Export";
}

<style>
    .export-card {
        background: #1e1e2d;
        border: 1px solid #2a2a4a;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
    }

    :root[data-theme="light"] .export-card {
        background: #ffffff;
        border-color: #d8deea;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    
    :root[data-theme="light"] .text-white {
        color: #1f2a44 !important;
    }
    
    .stat-box {
        background: #2a2a4a;
        border-radius: 8px;
        padding: 16px;
        text-align: center;
    }
    
    :root[data-theme="light"] .stat-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }
    
    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #a5b4fc;
    }
    
    :root[data-theme="light"] .stat-value {
        color: #4f46e5;
    }

    :root[data-theme="light"] .text-gray {
        color: #4a5568 !important;
    }
</style>

<div class="max-w-4xl mx-auto py-8">
    <header class="text-center mb-10 slide-up">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-3 text-white">
            Cleaned Data Export
        </h1>
        <p class="text-base sm:text-lg max-w-lg mx-auto text-gray" style="color: #7a7a9e;">
            Download your master cleaned dataset
        </p>
    </header>

    @if (TempData["Error"] is string err)
    {
        <div class="mb-6 fade-in rounded-xl px-4 py-3 flex items-center gap-2 text-sm font-medium"
             style="background: #7f1d1d; border: 1px solid #ef4444; color: #fff;">
            <i data-lucide="alert-circle" style="width:16px; height:16px; flex-shrink:0;"></i>
            <span>@err</span>
        </div>
    }

    @if (Model.TotalRowsProcessed > 0 || Model.TotalCleanedRowsNow > 0)
    {
        <div class="export-card slide-up" style="animation-delay: 0.1s;">
            <h2 class="text-xl font-bold mb-4 text-white">Last Upload Summary</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <div class="stat-box">
                    <div class="stat-value">@Model.TotalRowsProcessed.ToString("N0")</div>
                    <div class="text-sm mt-1 text-gray" style="color: #7a7a9e;">Rows Processed</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" style="color: #34d399;">@Model.NewRowsAdded.ToString("N0")</div>
                    <div class="text-sm mt-1 text-gray" style="color: #7a7a9e;">New Rows Added</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" style="color: #f87171;">@Model.DuplicateRowsSkipped.ToString("N0")</div>
                    <div class="text-sm mt-1 text-gray" style="color: #7a7a9e;">Duplicates Skipped</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value">@Model.TotalCleanedRowsNow.ToString("N0")</div>
                    <div class="text-sm mt-1 text-gray" style="color: #7a7a9e;">Total Cleaned Rows</div>
                </div>
            </div>
            
            <p class="text-sm mb-6 text-gray" style="color: #7a7a9e;">
                Only rows with Territory <span class="font-bold text-white">DAVAO NORTH</span> were kept. Duplicate Appointment IDs were skipped.
            </p>
        </div>
    }

    <div class="export-card slide-up flex flex-col md:flex-row justify-between items-center" style="animation-delay: 0.2s;">
        <div>
            <h2 class="text-xl font-bold mb-2 text-white">Download Master Data</h2>
            <p class="text-sm mb-4 md:mb-0 text-gray" style="color: #7a7a9e;">Export the accumulated cleaned data.</p>
        </div>
        <div class="flex gap-4">
            <a asp-action="DownloadCleanedDataCsv" asp-controller="Report"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold transition-colors"
               style="background: rgba(99, 102, 241, 0.12); color: #a5b4fc; border: 1px solid #4f46e5;">
                <i data-lucide="download" style="width:18px; height:18px;"></i> Download .CSV
            </a>
            
            <a asp-action="DownloadCleanedDataXlsx" asp-controller="Report"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200"
               style="background: #6366f1; color: #fff;">
                <i data-lucide="file-spreadsheet" style="width:18px; height:18px;"></i> Download .XLSX
            </a>
        </div>
    </div>
</div>
