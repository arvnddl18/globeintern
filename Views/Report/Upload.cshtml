@model SlotAd_Globe.Models.CsvUploadViewModel
@using SlotAd_Globe.Models
@{
    ViewData["Title"] = "Raw Data Cleaner";
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    ViewData["ActiveTab"] = "kpi";
    ViewBag.ReportAssistantPageKind = ReportAssistantPageKind.Upload;
}

<style>
    .upload-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .drop-zone {
        background: var(--theme-surface-soft);
        border: 2px dashed var(--theme-surface-border);
        border-radius: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .drop-zone:hover {
        border-color: var(--theme-accent);
        background: var(--theme-accent-soft);
        transform: translateY(-2px);
    }

    .drop-zone-active {
        border-color: var(--theme-accent) !important;
        background: var(--theme-accent-soft) !important;
        transform: scale(1.02);
    }

    .info-card {
        background: var(--theme-surface);
        border: 1px solid var(--theme-surface-border);
        border-radius: 16px;
    }

    .btn-primary {
        background: var(--theme-accent);
        color: white;
        box-shadow: 0 4px 14px 0 var(--theme-accent-soft);
        transition: all 0.2s ease;
    }

    .btn-primary:hover:not(:disabled) {
        opacity: 0.9;
        transform: translateY(-1px);
    }

    .btn-secondary {
        background: var(--theme-nav-pill);
        color: var(--theme-text-dim);
        border: 1px solid var(--theme-surface-border);
        transition: all 0.2s ease;
    }

    .btn-secondary:hover {
        background: var(--theme-surface-border);
        color: var(--theme-text);
    }

    .progress-bar-bg {
        background: var(--theme-nav-pill);
    }

    .progress-bar-fill {
        background: linear-gradient(90deg, var(--theme-accent), #a5b4fc);
    }
</style>

<div class="upload-container">
    <header class="text-center mb-10 slide-up">
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight mb-4" style="color: var(--theme-text);">
            Raw Data Cleaner
        </h1>
        <p class="text-lg max-w-lg mx-auto" style="color: var(--theme-text-dim);">
            Upload your raw data file to extract, filter to <span class="font-bold">DAVAO NORTH</span>, and append to the master dataset.
        </p>
    </header>

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="mb-6 fade-in rounded-2xl px-5 py-4 flex items-center gap-3 border"
             style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); color: #ef4444;">
            <i data-lucide="alert-circle" style="width:20px; height:20px; flex-shrink:0;"></i>
            <span class="font-medium text-sm">@errorMsg</span>
        </div>
    }
    
    @if (TempData["Success"] is string successMsg)
    {
        <div class="mb-6 fade-in rounded-2xl px-5 py-4 flex items-center gap-3 border"
             style="background: rgba(34, 197, 94, 0.1); border-color: rgba(34, 197, 94, 0.2); color: #22c55e;">
            <i data-lucide="check-circle" style="width:20px; height:20px; flex-shrink:0;"></i>
            <span class="font-medium text-sm">@successMsg</span>
        </div>
    }

    <form asp-action="UploadRawDataCleaner" asp-controller="Report" method="post" enctype="multipart/form-data" id="uploadForm">
        @Html.AntiForgeryToken()

        <section class="slide-up" style="animation-delay: 0.1s;">
            <div id="drop-zone" class="drop-zone p-10 sm:p-16 text-center"
                 onclick="document.getElementById('CsvFile').click()">

                <input asp-for="CsvFile" type="file" accept=".csv,.xlsx" class="hidden" id="CsvFile" multiple />

                <div id="upload-icon" class="mx-auto w-20 h-20 rounded-3xl flex items-center justify-center mb-6"
                     style="background: var(--theme-accent-soft);">
                    <i data-lucide="upload-cloud" style="width:36px; height:36px; color: var(--theme-accent);"></i>
                </div>
                
                <h3 id="upload-prompt" class="text-xl font-bold mb-2" style="color: var(--theme-text);">
                    Drop your CSV or XLSX files here
                </h3>
                <p class="text-sm mb-4" style="color: var(--theme-text-muted);">
                    or click to browse your files
                </p>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase"
                     style="background: var(--theme-nav-pill); color: var(--theme-text-muted);">
                    <span>MAX 500MB • .CSV • .XLSX</span>
                </div>
                <span asp-validation-for="CsvFile" class="text-red-500 text-xs mt-3 block font-medium"></span>
            </div>
        </section>

        <!-- Queue UI -->
        <section id="queue-section" class="hidden mt-6 fade-in">
            <div class="flex items-center justify-between mb-4 px-2">
                <h4 class="text-sm font-bold uppercase tracking-widest" style="color: var(--theme-text-muted);">Upload Queue</h4>
                <button type="button" onclick="clearAllFiles()" class="text-xs font-bold text-red-500 hover:text-red-600 transition-colors">Clear All</button>
            </div>
            <div id="file-queue-list" class="space-y-3">
                <!-- Queue items injected by JS -->
            </div>
        </section>

        <!-- Stats Section -->
        <section id="stats-section" class="hidden mt-6 grid grid-cols-2 gap-4 fade-in">
            <div class="info-card p-4">
                <p class="text-[10px] font-bold uppercase tracking-wider mb-1" style="color: var(--theme-text-muted);">Total Files</p>
                <p id="stat-total-files" class="text-lg font-black font-mono" style="color: var(--theme-text);">0</p>
            </div>
            <div class="info-card p-4">
                <p class="text-[10px] font-bold uppercase tracking-wider mb-1" style="color: var(--theme-text-muted);">Total Size</p>
                <p id="stat-total-size" class="text-lg font-black font-mono" style="color: var(--theme-text);">0 KB</p>
            </div>
        </section>

        <!-- Submit Section -->
        <section id="submit-section" class="hidden mt-10 text-center fade-in">
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <button type="submit" id="submit-btn"
                        class="btn-primary inline-flex items-center gap-3 px-10 py-4 rounded-2xl text-lg font-black cursor-pointer">
                    <i data-lucide="zap" style="width:20px; height:20px;"></i>
                    <span id="submit-btn-text">Clean &amp; Append Data</span>
                </button>
                
                <a asp-action="Dashboard" asp-controller="Report" id="back-btn"
                   class="btn-secondary inline-flex items-center gap-2 px-8 py-4 rounded-2xl text-base font-bold">
                    <i data-lucide="arrow-left" style="width:18px; height:18px;"></i>
                    <span>Back to Dashboard</span>
                </a>
            </div>
            
            <p id="submit-hint" class="text-sm mt-4 font-medium" style="color: var(--theme-text-muted);">
                Files will be processed sequentially and merged with the master repository.
            </p>

            <div id="progress-section" class="hidden mt-8 max-w-md mx-auto">
                <div class="info-card p-6 shadow-xl">
                    <div class="flex items-center justify-between mb-3">
                        <span id="progress-label" class="text-sm font-bold" style="color: var(--theme-text-dim);">Uploading File 1...</span>
                        <span id="progress-pct" class="text-sm font-mono font-black" style="color: var(--theme-accent);">0%</span>
                    </div>
                    <div class="w-full rounded-full overflow-hidden progress-bar-bg" style="height: 10px;">
                        <div id="progress-bar" class="h-full rounded-full progress-bar-fill transition-all duration-300"
                             style="width: 0%;"></div>
                    </div>
                    <p id="progress-detail" class="text-xs mt-3 font-medium opacity-70" style="color: var(--theme-text-muted);"></p>
                </div>
            </div>
        </section>
        
        <!-- Quick Nav if no file selected -->
        <section id="initial-nav" class="mt-12 pt-8 border-t border-inherit text-center slide-up" style="animation-delay: 0.2s;">
            <p class="text-sm font-bold uppercase tracking-widest mb-6" style="color: var(--theme-text-muted);">Or continue to analytics</p>
            <a asp-action="Dashboard" asp-controller="Report"
               class="inline-flex items-center gap-2 text-base font-black px-6 py-3 rounded-xl transition-all"
               style="color: var(--theme-accent); background: var(--theme-accent-soft);">
                <i data-lucide="layout-dashboard" style="width:20px; height:20px;"></i>
                <span>View Dashboard</span>
            </a>
        </section>
    </form>

    <!-- Danger Zone -->
    <section id="danger-zone" class="mt-12 pt-8 border-t border-inherit text-center slide-up" style="animation-delay: 0.3s;">
        <p class="text-sm font-bold uppercase tracking-widest mb-6" style="color: var(--theme-text-muted);">Danger Zone</p>
        <div class="max-w-md mx-auto p-6 rounded-2xl" style="background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.15);">
            <i data-lucide="alert-triangle" class="mx-auto mb-3" style="width:24px; height:24px; color: #ef4444;"></i>
            <h4 class="text-base font-bold mb-2" style="color: #ef4444;">Clear Master Data</h4>
            <p class="text-sm mb-6 opacity-80" style="color: var(--theme-text-dim);">
                This will permanently delete the compiled CleanedDataMaster file. All accumulated data will be lost, and you will start fresh from the next upload.
            </p>
            <form asp-action="ClearStoredData" asp-controller="Report" method="post" onsubmit="return confirm('Are you sure you want to delete all stored master data? This cannot be undone.');">
                <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-bold transition-all w-full sm:w-auto"
                        style="background: #ef4444; color: white; box-shadow: 0 4px 14px 0 rgba(239,68,68,0.3);">
                    <i data-lucide="trash-2" style="width:16px; height:16px;"></i>
                    <span>Delete All Processed Data</span>
                </button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        var dropZone = document.getElementById('drop-zone');
        var fileInput = document.getElementById('CsvFile');
        var fileQueue = [];
        var MAX_FILE_SIZE = 500 * 1024 * 1024; // 500MB

        dropZone.addEventListener('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.add('drop-zone-active');
        });

        dropZone.addEventListener('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('drop-zone-active');
        });

        dropZone.addEventListener('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('drop-zone-active');
            handleFiles(e.dataTransfer.files);
        });

        fileInput.addEventListener('change', function () {
            handleFiles(this.files);
        });

        function handleFiles(files) {
            var newFiles = Array.from(files).filter(f => f.name.match(/\.(csv|xlsx)$/i));
            var rejected = Array.from(files).filter(f => !f.name.match(/\.(csv|xlsx)$/i));
            
            if (rejected.length > 0) {
                showToast(rejected.length + ' file(s) ignored. Only .csv and .xlsx allowed.', 'error');
            }

            var oversized = newFiles.filter(f => f.size > MAX_FILE_SIZE);
            if (oversized.length > 0) {
                showToast(oversized.length + ' file(s) ignored (exceeds 500MB max limit).', 'error');
                newFiles = newFiles.filter(f => f.size <= MAX_FILE_SIZE);
            }

            if (newFiles.length > 0) {
                fileQueue = fileQueue.concat(newFiles.map(f => ({ file: f, status: 'pending', elementId: 'queue-item-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5) })));
                updateQueueUI();
            }
        }

        function updateQueueUI() {
            var list = document.getElementById('file-queue-list');
            list.innerHTML = '';
            
            if (fileQueue.length === 0) {
                clearAllFiles();
                return;
            }

            var totalSize = 0;
            fileQueue.forEach((qItem, index) => {
                totalSize += qItem.file.size;
                
                var statusIcon = '<i data-lucide="clock" style="width:16px; height:16px; color: var(--theme-text-muted);"></i>';
                var statusText = 'Pending';
                var statusClass = 'text-muted-light';
                
                if (qItem.status === 'uploading') {
                    statusIcon = '<i data-lucide="loader" class="animate-spin" style="width:16px; height:16px; color: var(--theme-accent);"></i>';
                    statusText = 'Processing...';
                    statusClass = 'text-[var(--theme-accent)]';
                } else if (qItem.status === 'done') {
                    statusIcon = '<i data-lucide="check-circle" style="width:16px; height:16px; color: #22c55e;"></i>';
                    statusText = 'Complete';
                    statusClass = 'text-[#22c55e]';
                } else if (qItem.status === 'error') {
                    statusIcon = '<i data-lucide="alert-circle" style="width:16px; height:16px; color: #ef4444;"></i>';
                    statusText = 'Failed';
                    statusClass = 'text-[#ef4444]';
                }

                var html = `
                    <div id="${qItem.elementId}" class="info-card p-3 flex items-center justify-between gap-3 ${qItem.status === 'uploading' ? 'border-[var(--theme-accent)] ring-1 ring-[var(--theme-accent)]' : ''}">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: var(--theme-surface-soft);">
                                <i data-lucide="file-spreadsheet" style="width:16px; height:16px; color: var(--theme-text-dim);"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-bold truncate" style="color: var(--theme-text);">${qItem.file.name}</p>
                                <p class="text-xs font-medium" style="color: var(--theme-text-muted);">${formatFileSize(qItem.file.size)} • <span class="${statusClass}">${statusText}</span></p>
                            </div>
                        </div>
                        ${qItem.status === 'pending' ? `<button type="button" onclick="removeFile(${index})" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-red-500/10 text-muted-light"><i data-lucide="x" style="width:14px; height:14px;"></i></button>` : `<div class="w-8 h-8 flex items-center justify-center">${statusIcon}</div>`}
                    </div>
                `;
                list.insertAdjacentHTML('beforeend', html);
            });

            document.getElementById('queue-section').classList.remove('hidden');
            document.getElementById('stats-section').classList.remove('hidden');
            document.getElementById('submit-section').classList.remove('hidden');
            document.getElementById('initial-nav').classList.add('hidden');
            dropZone.style.borderColor = '#22c55e';
            document.getElementById('upload-prompt').textContent = fileQueue.length + ' File(s) Ready!';
            
            document.getElementById('stat-total-files').textContent = fileQueue.length;
            document.getElementById('stat-total-size').textContent = formatFileSize(totalSize);
            
            if (window.lucide) lucide.createIcons();
        }

        function removeFile(index) {
            fileQueue.splice(index, 1);
            updateQueueUI();
        }

        function clearAllFiles() {
            fileQueue = [];
            fileInput.value = '';
            document.getElementById('queue-section').classList.add('hidden');
            document.getElementById('stats-section').classList.add('hidden');
            document.getElementById('submit-section').classList.add('hidden');
            document.getElementById('initial-nav').classList.remove('hidden');
            dropZone.style.borderColor = '';
            document.getElementById('upload-prompt').textContent = 'Drop your CSV or XLSX files here';
            if (window.lucide) lucide.createIcons();
        }

        document.getElementById('uploadForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            
            var pendingFiles = fileQueue.filter(f => f.status === 'pending' || f.status === 'error');
            if (pendingFiles.length === 0) return;

            var btn = document.getElementById('submit-btn');
            var backBtn = document.getElementById('back-btn');
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            btn.disabled = true;
            btn.style.opacity = '0.7';
            backBtn.classList.add('pointer-events-none', 'opacity-50');
            document.getElementById('submit-btn-text').innerHTML = '<span class="spinner"></span> Processing Queue...';
            document.getElementById('submit-hint').classList.add('hidden');
            document.getElementById('progress-section').classList.remove('hidden');

            var aggregatedSummary = {
                TotalRowsProcessed: 0,
                NewRowsAdded: 0,
                DuplicateRowsSkipped: 0,
                TotalCleanedRowsNow: 0
            };

            var hasError = false;

            for (let i = 0; i < fileQueue.length; i++) {
                var qItem = fileQueue[i];
                if (qItem.status === 'done') continue;

                qItem.status = 'uploading';
                updateQueueUI();

                document.getElementById('progress-label').textContent = `Uploading File ${i + 1} of ${fileQueue.length}...`;
                document.getElementById('progress-pct').textContent = '0%';
                document.getElementById('progress-bar').style.width = '0%';
                document.getElementById('progress-detail').textContent = qItem.file.name;

                try {
                    var summary = await uploadSingleFile(qItem.file, token);
                    qItem.status = 'done';
                    
                    aggregatedSummary.TotalRowsProcessed += summary.totalRowsProcessed || 0;
                    aggregatedSummary.NewRowsAdded += summary.newRowsAdded || 0;
                    aggregatedSummary.DuplicateRowsSkipped += summary.duplicateRowsSkipped || 0;
                    aggregatedSummary.TotalCleanedRowsNow = summary.totalCleanedRowsNow || aggregatedSummary.TotalCleanedRowsNow;
                    
                    updateQueueUI();
                } catch (err) {
                    qItem.status = 'error';
                    hasError = true;
                    showToast('Failed to upload ' + qItem.file.name + ': ' + err.message, 'error');
                    updateQueueUI();
                    break; // Stop queue on error
                }
            }

            if (!hasError) {
                document.getElementById('progress-label').textContent = 'Finalizing...';
                document.getElementById('progress-detail').textContent = 'Saving aggregated statistics.';
                
                try {
                    await fetch('/Report/SetAggregatedSummary', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(aggregatedSummary)
                    });
                    window.location.href = '/Report/CleanedDataExport';
                } catch (err) {
                    showToast('Failed to finalize summary. ' + err.message, 'error');
                    resetButtons();
                }
            } else {
                resetButtons();
            }

            function resetButtons() {
                btn.disabled = false;
                btn.style.opacity = '1';
                backBtn.classList.remove('pointer-events-none', 'opacity-50');
                document.getElementById('submit-btn-text').innerHTML = 'Clean &amp; Append Data';
                document.getElementById('progress-section').classList.add('hidden');
                document.getElementById('submit-hint').classList.remove('hidden');
            }
        });

        function uploadSingleFile(file, token) {
            return new Promise((resolve, reject) => {
                var formData = new FormData();
                formData.append('csvFile', file);
                formData.append('__RequestVerificationToken', token);

                var xhr = new XMLHttpRequest();
                var startTime = Date.now();

                xhr.upload.addEventListener('progress', function (ev) {
                    if (!ev.lengthComputable) return;
                    var pct = Math.round((ev.loaded / ev.total) * 100);
                    document.getElementById('progress-bar').style.width = pct + '%';
                    document.getElementById('progress-pct').textContent = pct + '%';

                    var elapsed = (Date.now() - startTime) / 1000;
                    var speed = ev.loaded / elapsed;
                    var remaining = (ev.total - ev.loaded) / speed;
                    document.getElementById('progress-detail').textContent =
                        formatFileSize(ev.loaded) + ' / ' + formatFileSize(ev.total) +
                        (remaining > 0 ? '  ~' + Math.ceil(remaining) + 's remaining' : '');

                    if (pct >= 100) {
                        document.getElementById('progress-label').textContent = 'Cleaning data on server...';
                        document.getElementById('progress-detail').textContent = 'Please wait while server processes the file.';
                    }
                });

                xhr.addEventListener('load', function () {
                    if (xhr.status >= 200 && xhr.status < 400) {
                        try {
                            var response = JSON.parse(xhr.responseText);
                            resolve(response);
                        } catch (e) {
                            reject(new Error('Invalid server response'));
                        }
                    } else {
                        try {
                            var errorResponse = JSON.parse(xhr.responseText);
                            reject(new Error(errorResponse.error || 'Server error ' + xhr.status));
                        } catch (e) {
                            reject(new Error('Upload failed (' + xhr.status + ')'));
                        }
                    }
                });

                xhr.addEventListener('error', function () {
                    reject(new Error('Network error.'));
                });

                xhr.open('POST', '/Report/UploadRawDataCleanerApi');
                xhr.send(formData);
            });
        }

        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        if (window.lucide) lucide.createIcons();
    </script>
}

