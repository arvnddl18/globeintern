@section Scripts {
    <script>
        var dropZone = document.getElementById('drop-zone');
        var fileInput = document.getElementById('CsvFile');
        var fileQueue = [];
        var MAX_FILE_SIZE = 500 * 1024 * 1024; // 500MB

        dropZone.addEventListener('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.add('drop-zone-active');
        });

        dropZone.addEventListener('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('drop-zone-active');
        });

        dropZone.addEventListener('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('drop-zone-active');
            handleFiles(e.dataTransfer.files);
        });

        fileInput.addEventListener('change', function () {
            handleFiles(this.files);
        });

        function handleFiles(files) {
            var newFiles = Array.from(files).filter(f => f.name.match(/\.(csv|xlsx)$/i));
            var rejected = Array.from(files).filter(f => !f.name.match(/\.(csv|xlsx)$/i));
            
            if (rejected.length > 0) {
                showToast(rejected.length + ' file(s) ignored. Only .csv and .xlsx allowed.', 'error');
            }

            var oversized = newFiles.filter(f => f.size > MAX_FILE_SIZE);
            if (oversized.length > 0) {
                showToast(oversized.length + ' file(s) ignored (exceeds 500MB max limit).', 'error');
                newFiles = newFiles.filter(f => f.size <= MAX_FILE_SIZE);
            }

            if (newFiles.length > 0) {
                fileQueue = fileQueue.concat(newFiles.map(f => ({ file: f, status: 'pending', elementId: 'queue-item-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5) })));
                updateQueueUI();
            }
        }

        function updateQueueUI() {
            var list = document.getElementById('file-queue-list');
            list.innerHTML = '';
            
            if (fileQueue.length === 0) {
                clearAllFiles();
                return;
            }

            var totalSize = 0;
            fileQueue.forEach((qItem, index) => {
                totalSize += qItem.file.size;
                
                var statusIcon = '<i data-lucide="clock" style="width:16px; height:16px; color: var(--theme-text-muted);"></i>';
                var statusText = 'Pending';
                var statusClass = 'text-muted-light';
                
                if (qItem.status === 'uploading') {
                    statusIcon = '<i data-lucide="loader" class="animate-spin" style="width:16px; height:16px; color: var(--theme-accent);"></i>';
                    statusText = 'Processing...';
                    statusClass = 'text-[var(--theme-accent)]';
                } else if (qItem.status === 'done') {
                    statusIcon = '<i data-lucide="check-circle" style="width:16px; height:16px; color: #22c55e;"></i>';
                    statusText = 'Complete';
                    statusClass = 'text-[#22c55e]';
                } else if (qItem.status === 'error') {
                    statusIcon = '<i data-lucide="alert-circle" style="width:16px; height:16px; color: #ef4444;"></i>';
                    statusText = 'Failed';
                    statusClass = 'text-[#ef4444]';
                }

                var html = `
                    <div id="${qItem.elementId}" class="info-card p-3 flex items-center justify-between gap-3 ${qItem.status === 'uploading' ? 'border-[var(--theme-accent)] ring-1 ring-[var(--theme-accent)]' : ''}">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: var(--theme-surface-soft);">
                                <i data-lucide="file-spreadsheet" style="width:16px; height:16px; color: var(--theme-text-dim);"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-bold truncate" style="color: var(--theme-text);">${qItem.file.name}</p>
                                <p class="text-xs font-medium" style="color: var(--theme-text-muted);">${formatFileSize(qItem.file.size)} • <span class="${statusClass}">${statusText}</span></p>
                            </div>
                        </div>
                        ${qItem.status === 'pending' ? `<button type="button" onclick="removeFile(${index})" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-red-500/10 text-muted-light"><i data-lucide="x" style="width:14px; height:14px;"></i></button>` : `<div class="w-8 h-8 flex items-center justify-center">${statusIcon}</div>`}
                    </div>
                `;
                list.insertAdjacentHTML('beforeend', html);
            });

            document.getElementById('queue-section').classList.remove('hidden');
            document.getElementById('stats-section').classList.remove('hidden');
            document.getElementById('submit-section').classList.remove('hidden');
            document.getElementById('initial-nav').classList.add('hidden');
            dropZone.style.borderColor = '#22c55e';
            document.getElementById('upload-prompt').textContent = fileQueue.length + ' File(s) Ready!';
            
            document.getElementById('stat-total-files').textContent = fileQueue.length;
            document.getElementById('stat-total-size').textContent = formatFileSize(totalSize);
            
            if (window.lucide) lucide.createIcons();
        }

        function removeFile(index) {
            fileQueue.splice(index, 1);
            updateQueueUI();
        }

        function clearAllFiles() {
            fileQueue = [];
            fileInput.value = '';
            document.getElementById('queue-section').classList.add('hidden');
            document.getElementById('stats-section').classList.add('hidden');
            document.getElementById('submit-section').classList.add('hidden');
            document.getElementById('initial-nav').classList.remove('hidden');
            dropZone.style.borderColor = '';
            document.getElementById('upload-prompt').textContent = 'Drop your CSV or XLSX files here';
            if (window.lucide) lucide.createIcons();
        }

        document.getElementById('uploadForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            
            var pendingFiles = fileQueue.filter(f => f.status === 'pending' || f.status === 'error');
            if (pendingFiles.length === 0) return;

            var btn = document.getElementById('submit-btn');
            var backBtn = document.getElementById('back-btn');
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            btn.disabled = true;
            btn.style.opacity = '0.7';
            backBtn.classList.add('pointer-events-none', 'opacity-50');
            document.getElementById('submit-btn-text').innerHTML = '<span class="spinner"></span> Processing Queue...';
            document.getElementById('submit-hint').classList.add('hidden');
            document.getElementById('progress-section').classList.remove('hidden');

            var aggregatedSummary = {
                TotalRowsProcessed: 0,
                NewRowsAdded: 0,
                DuplicateRowsSkipped: 0,
                TotalCleanedRowsNow: 0
            };

            var hasError = false;

            for (let i = 0; i < fileQueue.length; i++) {
                var qItem = fileQueue[i];
                if (qItem.status === 'done') continue;

                qItem.status = 'uploading';
                updateQueueUI();

                document.getElementById('progress-label').textContent = `Uploading File ${i + 1} of ${fileQueue.length}...`;
                document.getElementById('progress-pct').textContent = '0%';
                document.getElementById('progress-bar').style.width = '0%';
                document.getElementById('progress-detail').textContent = qItem.file.name;

                try {
                    var summary = await uploadSingleFile(qItem.file, token);
                    qItem.status = 'done';
                    
                    aggregatedSummary.TotalRowsProcessed += summary.totalRowsProcessed || 0;
                    aggregatedSummary.NewRowsAdded += summary.newRowsAdded || 0;
                    aggregatedSummary.DuplicateRowsSkipped += summary.duplicateRowsSkipped || 0;
                    aggregatedSummary.TotalCleanedRowsNow = summary.totalCleanedRowsNow || aggregatedSummary.TotalCleanedRowsNow;
                    
                    updateQueueUI();
                } catch (err) {
                    qItem.status = 'error';
                    hasError = true;
                    showToast('Failed to upload ' + qItem.file.name + ': ' + err.message, 'error');
                    updateQueueUI();
                    break; // Stop queue on error
                }
            }

            if (!hasError) {
                document.getElementById('progress-label').textContent = 'Finalizing...';
                document.getElementById('progress-detail').textContent = 'Saving aggregated statistics.';
                
                try {
                    var finalizeRes = await fetch('/Report/SetAggregatedSummary', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': token
                        },
                        body: JSON.stringify(aggregatedSummary)
                    });
                    if (!finalizeRes.ok) throw new Error('Failed to save summary (HTTP ' + finalizeRes.status + ')');
                    window.location.href = '/Report/CleanedDataExport';
                } catch (err) {
                    showToast('Failed to finalize summary. ' + err.message, 'error');
                    resetButtons();
                }
            } else {
                resetButtons();
            }

            function resetButtons() {
                btn.disabled = false;
                btn.style.opacity = '1';
                backBtn.classList.remove('pointer-events-none', 'opacity-50');
                document.getElementById('submit-btn-text').innerHTML = 'Clean &amp; Append Data';
                document.getElementById('progress-section').classList.add('hidden');
                document.getElementById('submit-hint').classList.remove('hidden');
            }
        });

        function uploadSingleFile(file, token) {
            return new Promise((resolve, reject) => {
                var formData = new FormData();
                formData.append('csvFile', file);
                formData.append('__RequestVerificationToken', token);

                var xhr = new XMLHttpRequest();
                var startTime = Date.now();

                xhr.upload.addEventListener('progress', function (ev) {
                    if (!ev.lengthComputable) return;
                    var pct = Math.round((ev.loaded / ev.total) * 100);
                    document.getElementById('progress-bar').style.width = pct + '%';
                    document.getElementById('progress-pct').textContent = pct + '%';

                    var elapsed = (Date.now() - startTime) / 1000;
                    var speed = ev.loaded / elapsed;
                    var remaining = (ev.total - ev.loaded) / speed;
                    document.getElementById('progress-detail').textContent =
                        formatFileSize(ev.loaded) + ' / ' + formatFileSize(ev.total) +
                        (remaining > 0 ? '  ~' + Math.ceil(remaining) + 's remaining' : '');

                    if (pct >= 100) {
                        document.getElementById('progress-label').textContent = 'Cleaning data on server...';
                        document.getElementById('progress-detail').textContent = 'Please wait while server processes the file.';
                    }
                });

                xhr.addEventListener('load', function () {
                    if (xhr.status >= 200 && xhr.status < 400) {
                        try {
                            var response = JSON.parse(xhr.responseText);
                            resolve(response);
                        } catch (e) {
                            reject(new Error('Invalid server response'));
                        }
                    } else {
                        try {
                            var errorResponse = JSON.parse(xhr.responseText);
                            reject(new Error(errorResponse.error || 'Server error ' + xhr.status));
                        } catch (e) {
                            reject(new Error('Upload failed (' + xhr.status + ')'));
                        }
                    }
                });

                xhr.addEventListener('error', function () {
                    reject(new Error('Network error.'));
                });

                xhr.open('POST', '/Report/UploadRawDataCleanerApi');
                xhr.send(formData);
            });
        }

        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        // --- SWU pole raw file reorganizer ---
        var swuDropZone = document.getElementById('swu-drop-zone');
        var swuFileInput = document.getElementById('SwuXlsxFile');
        var swuFileQueue = [];

        swuDropZone.addEventListener('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            swuDropZone.classList.add('drop-zone-active');
        });
        swuDropZone.addEventListener('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            swuDropZone.classList.remove('drop-zone-active');
        });
        swuDropZone.addEventListener('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            swuDropZone.classList.remove('drop-zone-active');
            handleSwuFiles(e.dataTransfer.files);
        });
        swuFileInput.addEventListener('change', function () { handleSwuFiles(this.files); });

        function handleSwuFiles(files) {
            var newFiles = Array.from(files).filter(function (f) { return /\.xlsx$/i.test(f.name); });
            var rejected = Array.from(files).filter(function (f) { return !/\.xlsx$/i.test(f.name); });
            if (rejected.length > 0) showToast(rejected.length + ' file(s) ignored. SWU upload accepts .xlsx only.', 'error');
            var oversized = newFiles.filter(function (f) { return f.size > MAX_FILE_SIZE; });
            if (oversized.length > 0) {
                showToast(oversized.length + ' file(s) ignored (exceeds 500MB max limit).', 'error');
                newFiles = newFiles.filter(function (f) { return f.size <= MAX_FILE_SIZE; });
            }
            if (newFiles.length > 0) {
                swuFileQueue = swuFileQueue.concat(newFiles.map(function (f) {
                    return { file: f, status: 'pending', elementId: 'swu-q-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5) };
                }));
                updateSwuQueueUI();
            }
        }

        function updateSwuQueueUI() {
            var list = document.getElementById('swu-file-queue-list');
            list.innerHTML = '';
            if (swuFileQueue.length === 0) { clearAllSwuFiles(); return; }
            var totalSize = 0;
            swuFileQueue.forEach(function (qItem, index) {
                totalSize += qItem.file.size;
                var statusText = 'Pending', statusClass = '';
                if (qItem.status === 'uploading') { statusText = 'Processing...'; statusClass = 'text-[#10b981]'; }
                else if (qItem.status === 'done') { statusText = 'Complete'; statusClass = 'text-[#22c55e]'; }
                else if (qItem.status === 'error') { statusText = 'Failed'; statusClass = 'text-[#ef4444]'; }
                list.insertAdjacentHTML('beforeend',
                    '<div class="info-card p-3 flex items-center justify-between gap-2">' +
                    '<div class="min-w-0"><p class="text-sm font-bold truncate">' + qItem.file.name + '</p>' +
                    '<p class="text-xs ' + statusClass + '">' + formatFileSize(qItem.file.size) + ' • ' + statusText + '</p></div>' +
                    (qItem.status === 'pending' ? '<button type="button" onclick="removeSwuFile(' + index + ')" class="text-red-500 text-xs font-bold">×</button>' : '') +
                    '</div>');
            });
            document.getElementById('swu-queue-section').classList.remove('hidden');
            document.getElementById('swu-stats-section').classList.remove('hidden');
            document.getElementById('swu-submit-section').classList.remove('hidden');
            document.getElementById('swu-stat-total-files').textContent = swuFileQueue.length;
            document.getElementById('swu-stat-total-size').textContent = formatFileSize(totalSize);
            document.getElementById('swu-upload-prompt').textContent = swuFileQueue.length + ' file(s) ready';
            swuDropZone.style.borderColor = '#10b981';
            if (window.lucide) lucide.createIcons();
        }

        function removeSwuFile(index) { swuFileQueue.splice(index, 1); updateSwuQueueUI(); }
        function clearAllSwuFiles() {
            swuFileQueue = [];
            swuFileInput.value = '';
            document.getElementById('swu-queue-section').classList.add('hidden');
            document.getElementById('swu-stats-section').classList.add('hidden');
            document.getElementById('swu-submit-section').classList.add('hidden');
            document.getElementById('swu-upload-prompt').textContent = 'Drop SWU pole .xlsx files here';
            swuDropZone.style.borderColor = '';
        }

        document.getElementById('swuUploadForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            if (swuFileQueue.filter(function (q) { return q.status !== 'done'; }).length === 0) return;

            var btn = document.getElementById('swu-submit-btn');
            var token = document.querySelector('#swuUploadForm input[name="__RequestVerificationToken"]').value;
            var batchId = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID().replace(/-/g, '') : ('b' + Date.now());
            btn.disabled = true;
            document.getElementById('swu-submit-hint').classList.add('hidden');
            document.getElementById('swu-progress-section').classList.remove('hidden');

            var aggregated = { filesProcessed: 0, totalPolesExtracted: 0, polesFromLastFile: 0, sourceFileNames: [], batchId: batchId };
            var hasError = false;
            var fileIndex = 0;

            for (var i = 0; i < swuFileQueue.length; i++) {
                var qItem = swuFileQueue[i];
                if (qItem.status === 'done') continue;
                qItem.status = 'uploading';
                updateSwuQueueUI();
                var isFirst = fileIndex === 0;
                fileIndex++;
                document.getElementById('swu-progress-label').textContent = 'File ' + fileIndex + ' of ' + swuFileQueue.length;
                document.getElementById('swu-progress-detail').textContent = qItem.file.name;
                try {
                    var summary = await uploadSwuSingleFile(qItem.file, token, batchId, isFirst);
                    qItem.status = 'done';
                    aggregated.filesProcessed += summary.filesProcessed ?? summary.FilesProcessed ?? 1;
                    aggregated.totalPolesExtracted += summary.totalPolesExtracted ?? summary.TotalPolesExtracted
                        ?? summary.polesFromLastFile ?? summary.PolesFromLastFile ?? 0;
                    aggregated.polesFromLastFile = summary.polesFromLastFile ?? summary.PolesFromLastFile ?? 0;
                    var names = summary.sourceFileNames ?? summary.SourceFileNames;
                    if (names && names.length)
                        aggregated.sourceFileNames = aggregated.sourceFileNames.concat(names);
                    else if (qItem.file.name) aggregated.sourceFileNames.push(qItem.file.name);
                    updateSwuQueueUI();
                } catch (err) {
                    qItem.status = 'error';
                    hasError = true;
                    showToast('Failed: ' + qItem.file.name + ' — ' + err.message, 'error');
                    updateSwuQueueUI();
                    break;
                }
            }

            if (!hasError) {
                try {
                    var finalizeRes = await fetch('/Report/SetSwuAggregatedSummary', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': token },
                        body: JSON.stringify(aggregated)
                    });
                    if (!finalizeRes.ok) throw new Error('Failed to save summary (HTTP ' + finalizeRes.status + ')');
                    window.location.href = '/Report/SwuReorganizedExport?batchId=' + encodeURIComponent(batchId);
                } catch (err) {
                    showToast('Failed to finalize: ' + err.message, 'error');
                    btn.disabled = false;
                    document.getElementById('swu-submit-hint').classList.remove('hidden');
                    document.getElementById('swu-progress-section').classList.add('hidden');
                }
            } else {
                btn.disabled = false;
                document.getElementById('swu-submit-hint').classList.remove('hidden');
                document.getElementById('swu-progress-section').classList.add('hidden');
            }
        });

        function uploadSwuSingleFile(file, token, batchId, isFirstInBatch) {
            return new Promise(function (resolve, reject) {
                var formData = new FormData();
                formData.append('xlsxFile', file);
                formData.append('batchId', batchId);
                formData.append('isFirstInBatch', isFirstInBatch ? 'true' : 'false');
                formData.append('__RequestVerificationToken', token);
                var xhr = new XMLHttpRequest();
                xhr.addEventListener('load', function () {
                    if (xhr.status >= 200 && xhr.status < 400) {
                        try { resolve(JSON.parse(xhr.responseText)); }
                        catch (e) { reject(new Error('Invalid server response')); }
                    } else {
                        try {
                            var err = JSON.parse(xhr.responseText);
                            reject(new Error(err.error || 'Server error ' + xhr.status));
                        } catch (e) { reject(new Error('Upload failed (' + xhr.status + ')')); }
                    }
                });
                xhr.addEventListener('error', function () { reject(new Error('Network error.')); });
                xhr.open('POST', '/Report/UploadSwuRawDataApi');
                xhr.send(formData);
            });
        }

        // --- GT DP,Nap raw file reorganizer ---
        var gtDropZone = document.getElementById('gt-drop-zone');
        var gtFileInput = document.getElementById('GtXlsxFile');
        var gtFileQueue = [];

        gtDropZone.addEventListener('dragover', function (e) {
            e.preventDefault(); e.stopPropagation(); gtDropZone.classList.add('drop-zone-active');
        });
        gtDropZone.addEventListener('dragleave', function (e) {
            e.preventDefault(); e.stopPropagation(); gtDropZone.classList.remove('drop-zone-active');
        });
        gtDropZone.addEventListener('drop', function (e) {
            e.preventDefault(); e.stopPropagation(); gtDropZone.classList.remove('drop-zone-active');
            handleGtFiles(e.dataTransfer.files);
        });
        gtFileInput.addEventListener('change', function () { handleGtFiles(this.files); });

        function handleGtFiles(files) {
            var newFiles = Array.from(files).filter(function (f) { return /\.xlsx$/i.test(f.name); });
            var rejected = Array.from(files).filter(function (f) { return !/\.xlsx$/i.test(f.name); });
            if (rejected.length > 0) showToast(rejected.length + ' file(s) ignored. Accepts .xlsx only.', 'error');
            var oversized = newFiles.filter(function (f) { return f.size > MAX_FILE_SIZE; });
            if (oversized.length > 0) {
                showToast(oversized.length + ' file(s) ignored (exceeds 500MB max limit).', 'error');
                newFiles = newFiles.filter(function (f) { return f.size <= MAX_FILE_SIZE; });
            }
            if (newFiles.length > 0) {
                gtFileQueue = gtFileQueue.concat(newFiles.map(function (f) {
                    return { file: f, status: 'pending', elementId: 'gt-q-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5) };
                }));
                updateGtQueueUI();
            }
        }

        function updateGtQueueUI() {
            var list = document.getElementById('gt-file-queue-list');
            list.innerHTML = '';
            if (gtFileQueue.length === 0) { clearAllGtFiles(); return; }
            var totalSize = 0;
            gtFileQueue.forEach(function (qItem, index) {
                totalSize += qItem.file.size;
                var statusText = 'Pending', statusClass = '';
                if (qItem.status === 'uploading') { statusText = 'Processing...'; statusClass = 'text-[#3b82f6]'; }
                else if (qItem.status === 'done') { statusText = 'Complete'; statusClass = 'text-[#22c55e]'; }
                else if (qItem.status === 'error') { statusText = 'Failed'; statusClass = 'text-[#ef4444]'; }
                list.insertAdjacentHTML('beforeend',
                    '<div class="info-card p-3 flex items-center justify-between gap-2">' +
                    '<div class="min-w-0"><p class="text-sm font-bold truncate">' + qItem.file.name + '</p>' +
                    '<p class="text-xs ' + statusClass + '">' + formatFileSize(qItem.file.size) + ' • ' + statusText + '</p></div>' +
                    (qItem.status === 'pending' ? '<button type="button" onclick="removeGtFile(' + index + ')" class="text-red-500 text-xs font-bold">×</button>' : '') +
                    '</div>');
            });
            document.getElementById('gt-queue-section').classList.remove('hidden');
            document.getElementById('gt-stats-section').classList.remove('hidden');
            document.getElementById('gt-submit-section').classList.remove('hidden');
            document.getElementById('gt-stat-total-files').textContent = gtFileQueue.length;
            document.getElementById('gt-stat-total-size').textContent = formatFileSize(totalSize);
            document.getElementById('gt-upload-prompt').textContent = gtFileQueue.length + ' file(s) ready';
            gtDropZone.style.borderColor = '#3b82f6';
            if (window.lucide) lucide.createIcons();
        }

        function removeGtFile(index) { gtFileQueue.splice(index, 1); updateGtQueueUI(); }
        function clearAllGtFiles() {
            gtFileQueue = [];
            gtFileInput.value = '';
            document.getElementById('gt-queue-section').classList.add('hidden');
            document.getElementById('gt-stats-section').classList.add('hidden');
            document.getElementById('gt-submit-section').classList.add('hidden');
            document.getElementById('gt-upload-prompt').textContent = 'Drop GT DP,Nap .xlsx here';
            gtDropZone.style.borderColor = '';
        }

        document.getElementById('gtDpUploadForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            if (gtFileQueue.filter(function (q) { return q.status !== 'done'; }).length === 0) return;

            var btn = document.getElementById('gt-submit-btn');
            var token = document.querySelector('#gtDpUploadForm input[name="__RequestVerificationToken"]').value;
            btn.disabled = true;
            document.getElementById('gt-submit-hint').classList.add('hidden');
            document.getElementById('gt-progress-section').classList.remove('hidden');

            var hasError = false;
            var batchId = null;

            for (var i = 0; i < gtFileQueue.length; i++) {
                var qItem = gtFileQueue[i];
                if (qItem.status === 'done') continue;
                qItem.status = 'uploading';
                updateGtQueueUI();
                document.getElementById('gt-progress-label').textContent = 'Processing File ' + (i+1);
                document.getElementById('gt-progress-detail').textContent = qItem.file.name;
                
                try {
                    var res = await uploadGtSingleFile(qItem.file, token);
                    qItem.status = 'done';
                    batchId = res.batchId; // take batchId from the last successfully processed file
                    updateGtQueueUI();
                } catch (err) {
                    qItem.status = 'error';
                    hasError = true;
                    showToast('Failed: ' + qItem.file.name + ' — ' + err.message, 'error');
                    updateGtQueueUI();
                    break;
                }
            }

            if (!hasError && batchId) {
                window.location.href = '/Report/DownloadGtDpNapUtilizationZip?batchId=' + encodeURIComponent(batchId);
                // reset form after successful download init
                setTimeout(() => {
                    clearAllGtFiles();
                    btn.disabled = false;
                    document.getElementById('gt-submit-hint').classList.remove('hidden');
                    document.getElementById('gt-progress-section').classList.add('hidden');
                }, 2000);
            } else {
                btn.disabled = false;
                document.getElementById('gt-submit-hint').classList.remove('hidden');
                document.getElementById('gt-progress-section').classList.add('hidden');
            }
        });

        function uploadGtSingleFile(file, token) {
            return new Promise(function (resolve, reject) {
                var formData = new FormData();
                formData.append('xlsxFile', file);
                formData.append('__RequestVerificationToken', token);
                var xhr = new XMLHttpRequest();
                
                xhr.upload.addEventListener('progress', function (ev) {
                    if (!ev.lengthComputable) return;
                    var pct = Math.round((ev.loaded / ev.total) * 100);
                    document.getElementById('gt-progress-bar').style.width = pct + '%';
                    document.getElementById('gt-progress-pct').textContent = pct + '%';
                });
                
                xhr.addEventListener('load', function () {
                    if (xhr.status >= 200 && xhr.status < 400) {
                        try { resolve(JSON.parse(xhr.responseText)); }
                        catch (e) { reject(new Error('Invalid server response')); }
                    } else {
                        try {
                            var err = JSON.parse(xhr.responseText);
                            reject(new Error(err.error || 'Server error ' + xhr.status));
                        } catch (e) { reject(new Error('Upload failed (' + xhr.status + ')')); }
                    }
                });
                xhr.addEventListener('error', function () { reject(new Error('Network error.')); });
                xhr.open('POST', '/Report/UploadGtDpNapUtilizationApi');
                xhr.send(formData);
            });
        }

        if (window.lucide) lucide.createIcons();
    </script>
}

