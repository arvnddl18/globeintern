@model SlotAd_Globe.Models.ToolsAuditUploadViewModel
@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    var error = TempData["Error"] as string;
    var success = TempData["Success"] as string;
    var history = Model.History ?? [];
}

<style>
    a.tools-audit-history-item {
        display: block;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        border: 1px solid var(--theme-surface-border);
        background: var(--theme-nav-pill);
        text-decoration: none;
        transition: border-color 0.15s ease, background 0.15s ease;
        min-width: 0;
    }
    a.tools-audit-history-item:hover {
        border-color: var(--theme-accent);
        background: var(--theme-accent-soft);
    }
    a.tools-audit-history-item .tools-audit-history-meta {
        display: block;
        font-size: 0.625rem;
        margin-top: 0.25rem;
        color: var(--theme-text-muted);
    }
</style>

<div class="fade-in">
    <section class="rounded-xl border p-6" style="background: var(--theme-surface-soft); border-color: var(--theme-surface-border);">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="text-xl font-black tracking-tight" style="color: var(--theme-text);">Tools Audit Upload</h2>
                <p class="text-sm mt-1" style="color: var(--theme-text-muted);">
                    Upload the weekly Excel template. Required sheet: <span class="font-mono">Checklist_Input</span>.
                </p>
            </div>
            <a asp-controller="Report" asp-action="Dashboard" class="text-sm font-semibold px-3 py-2 rounded-lg"
               style="color: var(--theme-accent); background: var(--theme-accent-soft); border: 1px solid var(--theme-surface-border);">
                Back to Dashboard
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="mt-4 px-4 py-3 rounded-lg text-sm font-medium"
                 style="background:#7f1d1d; border:1px solid #ef4444; color:#fff;">
                @error
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(success))
        {
            <div class="mt-4 px-4 py-3 rounded-lg text-sm font-medium"
                 style="background:#065f46; border:1px solid #10b981; color:#fff;">
                @success
            </div>
        }

        <form asp-controller="ToolsAudit" asp-action="Upload" method="post" enctype="multipart/form-data" class="mt-5">
            @Html.AntiForgeryToken()
            <div class="rounded-xl border p-5"
                 style="border-color: var(--theme-surface-border); background: rgba(99, 102, 241, 0.06);">
                <label class="block text-sm font-semibold" style="color: var(--theme-text-dim);">
                    Excel file (.xlsx)
                </label>
                <input type="file" name="xlsxFile" accept=".xlsx" class="mt-2 block w-full text-sm"
                       style="color: var(--theme-text-dim);" />

                <div class="mt-4 flex items-center justify-between gap-3">
                    <div class="text-xs" style="color: var(--theme-text-muted);">
                        Values accepted: <span class="font-mono">Yes</span>, <span class="font-mono">None</span>, <span class="font-mono">Defective</span>, blanks treated as <span class="font-mono">N/A</span>.
                    </div>
                    <button type="submit" class="text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            style="color:#fff; background: var(--theme-accent);">
                        Upload &amp; View Summary
                    </button>
                </div>
            </div>
        </form>
    </section>

    @if (history.Count > 0)
    {
        <section class="mt-6 rounded-xl border p-5 fade-in" style="background: var(--theme-surface-soft); border-color: var(--theme-surface-border);">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h3 class="text-sm font-black tracking-tight" style="color: var(--theme-text);">Past uploads</h3>
                <p class="text-xs m-0" style="color: var(--theme-text-muted);">
                    <span class="tabular-nums">@history.Count</span> saved · click to open report summary
                </p>
            </div>
            <div class="space-y-3 max-h-[28rem] overflow-y-auto pr-1">
                @foreach (var dayGroup in history.GroupBy(h => h.UploadedUtc.ToLocalTime().Date).OrderByDescending(g => g.Key))
                {
                    var todayLocal = DateTime.Now.Date;
                    var label = dayGroup.Key == todayLocal
                        ? "Today"
                        : dayGroup.Key == todayLocal.AddDays(-1)
                            ? "Yesterday"
                            : dayGroup.Key.ToString("yyyy-MM-dd");
                    <div>
                        <p class="text-[10px] font-medium mb-1.5 pl-0.5 uppercase tracking-wide" style="color: var(--theme-text-muted);">@label</p>
                        <div class="grid grid-cols-1 min-[400px]:grid-cols-2 gap-2">
                            @foreach (var h in dayGroup.OrderByDescending(x => x.UploadedUtc))
                            {
                                var auditLabel = (h.AuditDate ?? h.WeekStartDate).ToString("MMM dd, yyyy");
                                var title = string.IsNullOrEmpty(h.OriginalFileName)
                                    ? h.SessionId.ToString("N")[..12] + "…"
                                    : h.OriginalFileName;
                                <a asp-controller="ToolsAudit" asp-action="Session" asp-route-id="@h.SessionId"
                                   class="tools-audit-history-item">
                                    <span class="text-sm font-medium truncate block" style="color: var(--theme-text-dim);">@title</span>
                                    <span class="tools-audit-history-meta">
                                        Week / audit @auditLabel · @h.UploadedUtc.ToLocalTime().ToString("hh:mm tt")
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>
