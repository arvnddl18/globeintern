@model SlotAd_Globe.Models.ToolsAuditSessionViewModel
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    var topTools = (Model.ToolSummaryAll ?? new List<SlotAd_Globe.Models.ToolsAuditToolSummaryRow>()).Take(12).ToList();
    var labelsJson = JsonSerializer.Serialize(topTools.Select(x => x.ToolName));
    var noneJson = JsonSerializer.Serialize(topTools.Select(x => x.NoneCount));
}

<section class="fade-in rounded-xl border p-6" style="background: var(--theme-surface-soft); border-color: var(--theme-surface-border);">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="text-xl font-black tracking-tight" style="color: var(--theme-text);">Tools Audit</h2>
            <div class="text-sm mt-1" style="color: var(--theme-text-muted);">
                <span class="font-semibold" style="color: var(--theme-text-dim);">
                    Tools Inspection for @((Model.AuditDate ?? Model.WeekStartDate).ToString("MMMM dd, yyyy"))
                </span>
            </div>
            <div class="text-xs mt-1" style="color: var(--theme-text-muted);">
                Uploaded @Model.UploadedUtc.ToLocalTime().ToString("MMMM dd, yyyy hh:mm tt")
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.OriginalFileName))
            {
                <div class="text-xs mt-1" style="color: var(--theme-text-muted);">
                    Source: <span class="font-mono">@Model.OriginalFileName</span>
                </div>
            }
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="ToolsAudit" asp-action="Upload" class="text-sm font-semibold px-3 py-2 rounded-lg"
               style="color: var(--theme-accent); background: var(--theme-accent-soft); border: 1px solid var(--theme-surface-border);">
                Upload another week
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-6">
        <div class="rounded-xl border p-5" style="border-color: var(--theme-surface-border); background: var(--theme-surface);">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-black tracking-wide uppercase" style="color: var(--theme-text-dim);">Top Missing Tools (None)</h3>
                <span class="text-xs px-2 py-1 rounded-md" style="color: var(--theme-text-muted); background: var(--theme-nav-pill);">
                    Top @topTools.Count
                </span>
            </div>
            <div class="mt-4">
                <canvas id="missingToolsChart" height="160"></canvas>
            </div>
            <div class="mt-4 text-xs" style="color: var(--theme-text-muted);">
                Bars show how many technicians reported <span class="font-mono">None</span> for each tool.
            </div>
        </div>

        <div class="rounded-xl border p-5" style="border-color: var(--theme-surface-border); background: var(--theme-surface);">
            <h3 class="text-sm font-black tracking-wide uppercase" style="color: var(--theme-text-dim);">Technician Summary</h3>
            <div class="overflow-auto mt-3" style="max-height: 320px;">
                <table class="w-full text-xs">
                    <thead class="sticky top-0" style="background: var(--theme-surface);">
                        <tr style="color: var(--theme-text-muted);">
                            <th class="text-left py-2 pr-2">Technician</th>
                            <th class="text-right py-2 px-2">OK</th>
                            <th class="text-right py-2 px-2" style="color:#ef4444;">None</th>
                            <th class="text-right py-2 px-2" style="color:#f59e0b;">Def</th>
                            <th class="text-right py-2 pl-2">N/A</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.TechnicianSummary)
                    {
                        <tr style="border-top: 1px solid var(--theme-surface-border);">
                            <td class="py-2 pr-2" style="color: var(--theme-text-dim);">@row.TechnicianName</td>
                            <td class="py-2 px-2 text-right" style="color: var(--theme-text);">@row.OkCount</td>
                            <td class="py-2 px-2 text-right font-bold" style="color:#ef4444;">@row.NoneCount</td>
                            <td class="py-2 px-2 text-right" style="color:#f59e0b;">@row.DefectiveCount</td>
                            <td class="py-2 pl-2 text-right" style="color: var(--theme-text);">@row.NaCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="tools-summary-container">
        <partial name="_ToolsSummary" model="Model" />
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var labels = @Html.Raw(labelsJson);
            var noneCounts = @Html.Raw(noneJson);
            var ctx = document.getElementById('missingToolsChart');
            if (!ctx) return;
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'None count',
                        data: noneCounts,
                        backgroundColor: 'rgba(239, 68, 68, 0.65)',
                        borderColor: 'rgba(239, 68, 68, 0.95)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: true }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#8a8ab0' },
                            grid: { color: 'rgba(255,255,255,0.06)' }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { color: '#8a8ab0', precision: 0 },
                            grid: { color: 'rgba(255,255,255,0.06)' }
                        }
                    }
                }
            });
        })();

        (function () {
            var sessionId = '@Model.SessionId';
            var containerId = 'tools-summary-container';
            var isLoading = false;

            function bindAutoRefresh() {
                var container = document.getElementById(containerId);
                if (!container) return;

                var form = container.querySelector('#tools-summary-filter-form');
                if (!form) return;

                function refreshSummary() {
                    if (isLoading) return;
                    isLoading = true;

                    var params = new URLSearchParams();
                    form.querySelectorAll('input[name="statuses"]:checked').forEach(function (el) {
                        params.append('statuses', el.value);
                    });
                    var sortDir = form.querySelector('select[name="sortDir"]');
                    if (sortDir) params.set('sortDir', sortDir.value);
                    params.set('sortBy', 'none');
                    params.set('partial', 'toolsSummary');

                    fetch('/ToolsAudit/Session/' + sessionId + '?' + params.toString(), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        container.innerHTML = html;
                        bindAutoRefresh();
                    })
                    .catch(function () { /* no-op */ })
                    .finally(function () { isLoading = false; });
                }

                form.querySelectorAll('input[name="statuses"]').forEach(function (cb) {
                    cb.addEventListener('change', refreshSummary);
                });
                var dir = form.querySelector('select[name="sortDir"]');
                if (dir) dir.addEventListener('change', refreshSummary);
            }

            bindAutoRefresh();
        })();
    </script>
}

