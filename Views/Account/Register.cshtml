@model SlotAd_Globe.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}

<header class="account-auth-header text-center mb-10 slide-up">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3" style="color: #f0f0f8;">Create account</h1>
    <p class="text-sm" style="color: #7a7a9e;">Choose a username and password.</p>
</header>

<div class="account-auth-card max-w-md mx-auto rounded-xl p-6 fade-in" style="background: rgba(22, 22, 42, 0.8); border: 1px solid #2a2a4a;">
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm rounded-lg px-3 py-2" style="background: #7f1d1d; border: 1px solid #ef4444; color: #fff;"></div>
        <div class="mb-4">
            <label asp-for="UserName" class="account-auth-label block text-xs font-medium mb-1" style="color: #8a8ab0;"></label>
            <input asp-for="UserName" class="account-auth-input w-full rounded-lg px-3 py-2 text-sm" style="background: #0d0d1a; border: 1px solid #2a2a4a; color: #c8c8e0;" autocomplete="username" />
            <span asp-validation-for="UserName" class="text-xs" style="color: #f87171;"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Password" class="account-auth-label block text-xs font-medium mb-1" style="color: #8a8ab0;"></label>
            <input asp-for="Password" class="account-auth-input w-full rounded-lg px-3 py-2 text-sm" style="background: #0d0d1a; border: 1px solid #2a2a4a; color: #c8c8e0;" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-xs" style="color: #f87171;"></span>
        </div>
        <div class="mb-6">
            <label asp-for="ConfirmPassword" class="account-auth-label block text-xs font-medium mb-1" style="color: #8a8ab0;"></label>
            <input asp-for="ConfirmPassword" class="account-auth-input w-full rounded-lg px-3 py-2 text-sm" style="background: #0d0d1a; border: 1px solid #2a2a4a; color: #c8c8e0;" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-xs" style="color: #f87171;"></span>
        </div>
        <button type="submit" class="account-auth-submit w-full py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer" style="background: #6366f1; color: #fff; border: none;">
            Register
        </button>
    </form>
    <p class="account-auth-footer mt-6 text-center text-xs" style="color: #6a6a8e;">
        Already have an account?
        <a asp-action="Login" class="account-auth-link font-medium" style="color: #a5b4fc;">Sign in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
